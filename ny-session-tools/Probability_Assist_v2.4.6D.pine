htfTimeframe = input.timeframe("15", "Higher-Timeframe Context", group=groupTrend)
adxLength = input.int(14, "ADX Length", minval=5, group=groupTrend)
adxSmoothing = input.int(14, "ADX Smoothing", minval=5, group=groupTrend)
strongADX = input.float(24.0, "Strong Trend ADX", minval=10.0, step=1.0, group=groupTrend)
