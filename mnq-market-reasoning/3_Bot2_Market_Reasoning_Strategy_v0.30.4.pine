//@version=6
// @strategy_alert_message {{strategy.order.alert_message}}
strategy("Bot2 — Market Reasoning Strategy v0.30.4 TRADER UI · VISIBLE PLANS · EXIT PANEL · NO SCALP", overlay=true,
     pyramiding=0, initial_capital=100000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.0,
     slippage=0, calc_on_every_tick=true, calc_on_order_fills=false,
     process_orders_on_close=false, use_bar_magnifier=true,
     max_labels_count=350, max_lines_count=180)

// ============================================================================
// MNQ MARKET REASONING LAB
// Bot2 v0.28.2 PARITY LAB — v0.27.3 execution semantics preserved; v0.28 additions remain SHADOW
//
// PURPOSE
// Bot1 maps the battlefield. Bot2 interprets the auction.
// v0.28 starts from the v0.27.3 thesis-contract baseline and adds falsifiable structural-hardening controls:
// FAST-contract FTL, causal market reasoning, and the validated DEVELOP-proof gate.
// It then implements the strongest causal findings from the final-stage audit:
//   • a compact THESIS CONTRACT using the already-frozen direction/mechanism/
//     destination/invalidation plus an explicit FAST/CORE/RUN expected horizon,
//   • failure-to-launch only for FAST opportunities while the broader thesis lives,
//   • a causal micro-reaction failure exit after a completed post-fill bar when
//     the expected response never proves and the frozen level accepts against it,
//   • reaction-level "used" state is consumed on actual FILL, not merely on ARM,
//   • late-flow routing is structurally reachable again but defaults SHADOW,
//   • richer contract/event telemetry without adding new Market Eyes requests.
// Rejected/unproven ideas (generic probability score, raw delta veto, universal
// route/zone switches, target tuning) remain OFF / research-only.
//
// Bot2 does NOT use a universal bullish/bearish score. It reasons from:
//   1) territory gained / retained / lost
//   2) effort vs result
//   3) acceptance / rejection around meaningful Bot1 zones
//   4) quality of the opposing counterattack
//   5) what traders on the other side are likely trying to accomplish
//   6) route / structural invalidation
//
// ACTION FLOW
// DEVELOPING THESIS -> ARM -> ENTER -> ACTIVE TRADE -> PROVEN -> CHALLENGED
// -> RECOVERING / TRANSFER BUILDING -> HOLD / PROTECT / STOP / EXIT EARLY
//
// RESEARCH QUESTIONS
//   A) Why does the same reasoning engine behave differently across market regimes?
//   B) DEFENSE/SURVIVAL is not the same thing as fresh same-side INITIATIVE.
//   C) Missing information is UNKNOWN, not neutral confirmation.
//   D) Strong HTF displacement is ACTIVE PRESSURE, not automatic exhaustion.
//   E) If a conflicted thesis becomes "proved", does that proof remain retained until ARM?
//   F) Can lower-timeframe control transfer resolve HTF pressure BEFORE the HTF itself flips?
//   G) Can Bot2 remember the causal sequence across bars instead of judging only the entry snapshot?
//
// THIS IS A LIVE RESEARCH BUILD. v0.20 keeps C16=11100 and the v0.19 pressure
// interpretation, but fixes two reasoning-consistency problems found by the deep
// export: unsupported counter-HTF discovery could still count as initiative, and
// a one-time conflict proof could stay latched even after the market stopped
// retaining it. v0.20 treats proof as a RETAINED state, not a permanent badge.
// It is NOT a production promotion. Every entry exports a causal environment snapshot into
// TradingView's List-of-Trades Signal field for full-history regime autopsy.
//
// Reasoning decisions are made from completed bars. ARM orders use stop entries
// beyond the signal bar, so they cannot fill before a later price move.
// Strategy Tester uses TradingView's broker emulator + Bar Magnifier when
// available. This is DEVELOPMENT backtesting, not final statistical validation.
// ============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// 1. BOT1 BUS
// Connect BUS 1–9 plus BUS 10–11 to the matching hidden plots from
// "Bot1 — Market Reasoning Map v0.6".
// ─────────────────────────────────────────────────────────────────────────────
string G_BUS = "1. Bot1 Bus — connect matching plots"
float busHeader = input.source(close, "BUS 1 — Map Header", group=G_BUS)
float busR1 = input.source(close, "BUS 2 — Resistance 1 Center", group=G_BUS)
float busR1Meta = input.source(close, "BUS 3 — Resistance 1 Meta", group=G_BUS)
float busR2 = input.source(close, "BUS 4 — Resistance 2", group=G_BUS)
float busS1 = input.source(close, "BUS 5 — Support 1 Center", group=G_BUS)
float busS1Meta = input.source(close, "BUS 6 — Support 1 Meta", group=G_BUS)
float busS2 = input.source(close, "BUS 7 — Support 2", group=G_BUS)
float busBalHi = input.source(close, "BUS 8 — Current Balance High", group=G_BUS)
float busBalLo = input.source(close, "BUS 9 — Current Balance Low", group=G_BUS)
float busContext = input.source(close, "BUS 10 — Auction Context v3", group=G_BUS,
     tooltip="Connect to Bot1 v0.6.1 BUS 10 — Auction Context v3. Telemetry only.")
float busClock = input.source(close, "BUS 11 — Market Clock + Cross-Market", group=G_BUS,
     tooltip="Connect to Bot1 v0.6.1 BUS 11 — Market Clock + Cross-Market. Telemetry only; v0.8 trade decisions remain frozen.")

// Universal Eyes v1.1 additive buses. These are NEVER trusted merely because
// input.source defaults to `close`; `useUniversalExtras` plus BUS16 signature
// validation must both pass before any downstream reasoning can consume them.
float busFpEyes = input.source(close, "BUS 12 — Footprint Eyes Context", group=G_BUS)
float busFpPoc = input.source(close, "BUS 13 — Footprint POC", group=G_BUS)
float busFpValue = input.source(close, "BUS 14 — Footprint Value Mid", group=G_BUS)
float busRthVwap = input.source(close, "BUS 15 — RTH VWAP", group=G_BUS)
float busSensor = input.source(close, "BUS 16 — Sensor Availability v1", group=G_BUS)
float busFpRawDelta = input.source(close, "BUS 17 — Footprint Delta Fraction RAW", group=G_BUS)
float busFpVah = input.source(close, "BUS 18 — Footprint VAH RAW", group=G_BUS)
float busFpVal = input.source(close, "BUS 19 — Footprint VAL RAW", group=G_BUS)
float busCrossDetail = input.source(close, "BUS 20 — Cross-Market Detail v2", group=G_BUS,
     tooltip="Optional v1.2 Universal Eyes bus. Separates NQ leadership from genuine NQ/ES opposition without changing BUS1–19.")
float busMultiHtf = input.source(close, "BUS 21 — Multi-Horizon Facts v1", group=G_BUS,
     tooltip="Connect Universal Eyes v1.3+ BUS21. Contains only completed 15m/4H displacement, efficiency and range-location facts; Bot2 interprets them.")
float busMicroRows = input.source(close, "BUS 22 — Footprint Row Microstructure v1", group=G_BUS,
     tooltip="Connect Universal Eyes v1.4 BUS22. Row-location footprint facts: upper/lower imbalances, poor-impact and acceptance.")
float busFlowFacts = input.source(close, "BUS 23 — Lead-Lag + RTH Flow Facts v1", group=G_BUS,
     tooltip="Connect Universal Eyes v1.4 BUS23. One-bar NQ/ES lead-lag plus RTH displacement/location/late-session phase.")

// ─────────────────────────────────────────────────────────────────────────────
// 2. REASONING CONTROLS
// These are engineering defaults, not optimized backtest thresholds.
// ─────────────────────────────────────────────────────────────────────────────
string G_REASON = "2. Reasoning"
int atrLen = input.int(14, "ATR length", 5, 50, group=G_REASON)
int territoryLen = input.int(6, "Territory window", 3, 12, group=G_REASON)
int contextLen = input.int(12, "Context window", 6, 30, group=G_REASON)
int volLen = input.int(24, "Effort normalization", 10, 60, group=G_REASON)
float zoneNearAtr = input.float(0.45, "Zone interaction distance · ATR", 0.15, 1.20, step=0.05, group=G_REASON)
float territoryMinAtr = input.float(0.20, "Meaningful territory gain · ATR", 0.05, 0.60, step=0.05, group=G_REASON)
float efficientMove = input.float(0.30, "Directional efficiency reference", 0.15, 0.60, step=0.02, group=G_REASON)
float routeMinimumR = input.float(0.65, "Minimum usable route for ARM (R)", 0.25, 1.25, step=0.05, group=G_REASON)
int armTriggerFreshBars = input.int(1, "ARM trigger freshness · bars", 1, 2, group=G_REASON,
     tooltip="The thesis may persist, but one specific entry trigger is only valid for this many completed bars. Default 1 means: if it does not fill on the next bar, cancel that price and re-evaluate from current structure.")
float stopBufferAtr = input.float(0.06, "Structural stop buffer · ATR", 0.02, 0.20, step=0.01, group=G_REASON)
float shortMaturityRelVol = input.float(1.80, "Move-maturity participation reference", 1.20, 3.00, step=0.05, group=G_REASON,
     tooltip="Symmetric lifecycle reference. A failed-auction continuation can be directionally correct but too mature to chase. When same-side progress is already established, the counter side is weak, and participation is extreme, Bot2 waits for a pullback plus a fresh same-side response before ARM.")
float shortParticipationMinRelVol = input.float(0.70, "Short minimum participation for ARM", 0.40, 1.20, step=0.05, group=G_REASON,
     tooltip="Full-history reasoning check: bearish theses may keep developing below this participation level, but Bot2 will not ARM a short until relative volume recovers. This rule is intentionally short-side only.")
bool enableCausalReset = input.bool(true, "Require fresh causal reset for contradicted FAILED-UP shorts", group=G_REASON,
     tooltip="A FAILED-UP short cannot ARM while a prior DOWN shock is only stabilizing or while Bot1 says R1 is accepted above. Bot2 waits for a genuinely NEW bearish event after the contradiction instead of reusing the old seller story.")
bool enableFailedAuctionConfidence = input.bool(true, "v0.13 Failed-auction confidence layer", group=G_REASON,
     tooltip="Full-history reasoning upgrade. FAILED-DOWN / FAILED-UP remain valid explanations, but in repeatedly weak unresolved contexts Bot2 waits for a fresh same-side proof event before ARM instead of treating the first failure as sufficient.")

string G_STRAT = "3. Strategy / exits"
float targetR = input.float(1.25, "Primary target (R)", 0.50, 3.00, step=0.25, group=G_STRAT)
bool useRouteCap = input.bool(false, "Cap target below Bot1 destination", group=G_STRAT,
     tooltip="When enabled, target can be reduced if the nearest meaningful Bot1 destination is closer than the selected R target.")
float routeCapFrac = input.float(0.90, "Destination usage", 0.70, 0.98, step=0.02, group=G_STRAT)
bool enableEarlyExit = input.bool(true, "Allow thesis-failure early exits", group=G_STRAT)
int minEarlyBars = input.int(2, "Minimum bars before early exit", 1, 8, group=G_STRAT)
// v0.7 keeps the v0.6 proof concept but replaces the correlated 2-of-5 vote.
// After +0.50R has been proven on a PRIOR completed bar, a meaningful giveback
// can open a CHALLENGE event. Bot2 then waits for the market's RESPONSE:
//   challenge -> recovery/reclaim -> thesis survives
//   challenge -> retained opponent gain -> failed response -> control transfer
// The +0.50R proof and 0.30R giveback references are deliberately frozen from
// v0.6 for this architecture test; they are not being optimized here.
bool enableProvenProtection = input.bool(true, "v0.7 PROVEN CONTROL TRANSFER", group=G_STRAT)
const float PROVEN_R = 0.50
const float PROTECT_GIVEBACK_R = 0.30

// Sequential post-entry control state.
const int CT_UNPROVEN = 0
const int CT_PROVEN = 1
const int CT_CHALLENGED = 2
const int CT_RECOVERING = 3
const int CT_TRANSFER_BUILDING = 4

// One causal event gets one family code even if several descriptors fire.
const int CT_EVT_NONE = 0
const int CT_EVT_STRUCTURE = 1
const int CT_EVT_FAILED_AUCTION = 2
const int CT_EVT_DRIVE = 3
const int CT_EVT_EFFORT_RESULT = 4
const int CT_EVT_RESPONSE = 5
const int CT_EVT_RECOVERY = 6
const int CT_EVT_RESPONSE_FAIL = 7
const int CT_EVT_ACCEPTANCE = 8
const int CT_EVT_CONTINUATION = 9

// v0.23 opportunity-mode research. SHADOW ONLY in this build.
const int OM_UNKNOWN = 0
const int OM_FAST = 1
const int OM_CORE = 2
const int OM_RUNNER = 3

// Telemetry-only path provenance. Does NOT change trading behavior.
const int CT_PATH_NONE = 0
const int CT_PATH_NO_RESPONSE_RETENTION = 1
const int CT_PATH_RESPONSE_FAILURE = 2

int episodeResetBars = input.int(2, "Bars thesis must disappear before re-arm", 1, 6, group=G_STRAT)

// Hard personal trading rule: no exposure from 00:00 through 03:59 Pacific.
// We also cancel stale ARMs before the window begins so nothing can trigger
// while the user would not be trading.
string TRADE_TZ = "America/Los_Angeles"
string NO_TRADE_SESSION = "0000-0400:1234567"

// Auction-transition windows.
// 06:15–06:30 PT: do not carry a pre-open thesis/trigger into the 06:30 RTH open.
// 12:45–13:00 PT: do not initiate a new trade immediately before the cash close.
// Late-runway logic below separately handles FAILED-DOWN longs from 12:00–12:45.
string PRE_RTH_TRANSITION = "0615-0630:1234567"
string PRE_CLOSE_TRANSITION = "1245-1300:1234567"
string LATE_RTH_RUNWAY = "1200-1245:1234567"

// PROP execution window: Bot2 may reason all day, but it may only create new
// entries during the regular cash-session window. Existing positions continue
// to be managed normally.
string PROP_EXECUTION_SESSION = "0630-1300:1234567"


string G_NEXT = "6. v0.14 Initiative / Execution Timing Lab"
bool useUniversalExtras = input.bool(true, "Connect Universal Eyes BUS 12–19", group=G_NEXT,
     tooltip="OFF preserves the v0.13 information set. Turn ON only after BUS12–19 are wired from Universal Eyes v1.1. BUS16 signature validation prevents default-close inputs from masquerading as sensor data.")
string initiativeMode = input.string("LIVE", "Defense → fresh initiative", options=["OFF", "SHADOW", "LIVE"], group=G_NEXT,
     tooltip="Tests the Options-Brain idea that DEFENSE proves survival, not fresh initiative. SHADOW observes waits without changing trades. LIVE requires a fresh initiative event before a pure support/resistance-defense thesis may ARM.")
int initiativeWaitBars = input.int(4, "Defense initiative wait · bars", 1, 10, group=G_NEXT)
string executionTimingMode = input.string("LIVE", "Unproven execution invalidation", options=["OFF", "SHADOW", "LIVE"], group=G_NEXT,
     tooltip="Tests whether a local entry attempt can fail while the broader thesis remains alive. SHADOW records the signal. LIVE exits the attempt only after completed-bar local invalidation + opposing response, then allows at most one fresh-initiative retry.")
string executionTimingScope = input.string("DEFENSE ONLY", "Execution invalidation scope", options=["DEFENSE ONLY", "ALL ENTRIES"], group=G_NEXT)
float execInvalidBufferAtr = input.float(0.03, "Local execution invalidation buffer · ATR", 0.00, 0.15, step=0.01, group=G_NEXT)
int execFailMinBars = input.int(1, "Execution fail minimum held bars", 1, 4, group=G_NEXT)
int execFailMaxBars = input.int(3, "Execution fail maximum held bars", 1, 8, group=G_NEXT)
float execFailMaxMfeR = input.float(0.25, "Failure-to-launch maximum MFE · R", 0.05, 0.49, step=0.05, group=G_NEXT)
int maxExecutionRetries = input.int(1, "Maximum fresh retry attempts per thesis episode", 0, 2, group=G_NEXT)
int execRetryWatchBars = input.int(8, "Fresh retry watch window · bars", 2, 20, group=G_NEXT)
float fpInitiativeDelta = input.float(0.10, "Flow initiative delta fraction", 0.03, 0.30, step=0.01, group=G_NEXT)

string G_REG = "7. v0.15 Full Regime Research"
string regimeRouterMode = input.string("LIVE", "Causal regime router", options=["OFF", "LIVE"], group=G_REG,
     tooltip="LIVE changes actual entry eligibility by matching the active thesis logic to a causal market-environment state. OFF keeps the router as telemetry only. Thresholds are broad engineering references inherited where possible from Bot1; they are not optimized by year.")

string G_CAUSAL = "8. v0.16 Causal State Machine"
bool strictDefenseSequence = input.bool(true, "Require DEFENSE → later INITIATIVE", group=G_CAUSAL,
     tooltip="When ON, a pure support/resistance defense can never ARM on the defense bar, even if same-bar activity also looks initiative-like. A NEW initiative edge must occur on a later completed bar.")
bool strictFailedAuctionProof = input.bool(true, "Require CONFLICT → later RESOLUTION proof", group=G_CAUSAL,
     tooltip="When ON, a conflicted failed auction cannot be labeled PROVED on the conflict bar. Proof requires a later completed bar to retain price beyond the conflict bar's extreme with same-side initiative and no active contradiction.")
bool useCrossDetailV2 = input.bool(true, "Use BUS20 leadership/opposition detail", group=G_CAUSAL,
     tooltip="When BUS20 is valid, failed-auction confidence distinguishes NQ leadership from genuine relative weakness/opposition. If BUS20 is not wired, v0.15 BUS11 behavior is used as fallback.")
bool useTemporalMapSemantics = false  // frozen champion setting
bool useExecutionConsistentRoute = false  // frozen champion setting

string G_WORLD = "9. v0.19 Multi-Horizon Pressure Model"
string multiHorizonMode = input.string("LIVE", "15m/4H pressure interpretation", options=["OFF", "SHADOW", "LIVE"], group=G_WORLD,
     tooltip="LIVE does NOT blindly trade with the higher timeframe. A moderate opposing auction remains context, not a veto. A strong efficient opposing 15m/4H impulse is treated as active pressure, NOT exhaustion: local DISCOVERY is only a counterattack until pressure fails, and a FAILED AUCTION must resolve sequentially before commitment. SHADOW exports the same states without changing trades.")

string opportunityModeResearch = "SHADOW"  // internal FAST/CORE/RUN classifier used by active thesis contract

// Automated reaction/level scalping permanently removed in trader build.

string G_EDGE = "12. v0.26 Integrated Edge Stack"
string edgeStackMode = input.string("LIVE", "Integrated microstructure edge stack", options=["OFF", "SHADOW", "LIVE"], group=G_EDGE,
     tooltip="LIVE keeps the active microstructure/failed-launch enhancements used by the champion.")
bool edgeUseRowMicro = input.bool(true, "Use BUS22 row microstructure", group=G_EDGE)
bool edgeUseLeadLag = false  // frozen OFF; rejected/nonessential path
bool edgeUseFailureLaunch = input.bool(true, "Failure-to-launch 2.0", group=G_EDGE,
     tooltip="Before +0.30R proof, a normal trade can exit as an execution failure when the expected side loses initiative and micro/cross-market evidence turns against the entry while the broader thesis remains alive.")
int edgeFtlMinBars = input.int(1, "FTL2 minimum held bars", 1, 3, group=G_EDGE)
int edgeFtlMaxBars = input.int(4, "FTL2 maximum held bars", 2, 8, group=G_EDGE)
float edgeFtlMaxMfeR = input.float(0.30, "FTL2 maximum MFE · R", 0.10, 0.45, step=0.05, group=G_EDGE)
float edgeFtlMaxCloseR = input.float(0.10, "FTL2 maximum current progress · R", -0.10, 0.30, step=0.05, group=G_EDGE)

string G_CONTRACT = "13. v0.27 Thesis Contract Research"
string thesisContractMode = input.string("LIVE", "Thesis contract / horizon-aware execution", options=["OFF", "SHADOW", "LIVE"], group=G_CONTRACT,
     tooltip="Uses the pre-entry FAST/CORE/RUN horizon as an explicit thesis contract. CORE/RUN are never forced onto a FAST clock. Reaction-attempt failure remains part of the contract; FAST failure-to-launch has its own explicit policy below.")
string fastContractFtlMode = input.string("LIVE", "FAST contract failure-to-launch", options=["OFF", "SHADOW", "LIVE"], group=G_CONTRACT,
     tooltip="OFF disables the v0.27 FAST-only failure-to-launch signal. SHADOW records it without closing trades. LIVE may close only FAST opportunities when the adverse response appears while the broader thesis remains alive. This is separate from the retired universal v0.26 FTL2 behavior.")
bool thesisContractObserve = thesisContractMode != "OFF"
bool thesisContractLive = thesisContractMode == "LIVE"
bool fastContractFtlObserve = fastContractFtlMode != "OFF"
bool fastContractFtlLive = fastContractFtlMode == "LIVE"

// Frozen champion hardening settings. Rejected SHADOW/LIVE experiments removed.
bool robustStateObserve = false
bool robustStateLive = false
bool initiativeConfirmObserve = false
bool initiativeConfirmLive = false
bool developPermissionLive = true
bool footprintDecisionEnabled = true

string G_TRADER = "14. Trader Ready Display / Alerts"
bool showTraderPanel = input.bool(true, "Show Bot2 live-thinking panel", group=G_TRADER)
bool showTradeLines = input.bool(true, "Draw current Entry / Stop / Target", group=G_TRADER)
bool showTradePriceLabels = input.bool(true, "Show Entry / Stop / Target price labels", group=G_TRADER)
bool showTraderMarkers = input.bool(true, "Show ARM / ENTER / EXIT markers", group=G_TRADER)
bool enableTraderAlerts = input.bool(true, "Enable ARM alerts", group=G_TRADER)
bool enableLiveWatchAlerts = input.bool(false, "Enable LIVE intrabar warning alerts", group=G_TRADER,
     tooltip="Advisory only. Can change before the 5-minute candle closes and never changes strategy orders.")

// ─────────────────────────────────────────────────────────────────────────────
// CONSTANTS / CODES
// ─────────────────────────────────────────────────────────────────────────────
int AUC_BALANCE = 1
int AUC_BUILD = 2
int AUC_TEST_UP = 3
int AUC_TEST_DN = 4
int AUC_FAIL_UP = 5
int AUC_FAIL_DN = 6
int AUC_EXP_UP = 7
int AUC_EXP_DN = 8
int AUC_CHOP = 9
int AUC_TRANSITION = 10

int Z_FRESH = 1
int Z_TESTED = 2
int Z_DEFENDED = 3
int Z_ACCEPTED = 4
int Z_WEAK = 5
int Z_CONSUMED = 6

int SIDE_NONE = 0
int SIDE_LONG = 1
int SIDE_SHORT = -1

// v0.15 causal environment states. These are not hindsight labels.
int REG_UNKNOWN = 0
int REG_QUIET_ROT = 1
int REG_ACTIVE_ROT = 2
int REG_ORDERED_UP = 3
int REG_ORDERED_DN = 4
int REG_HOT_TWO_WAY = 5
int REG_SHOCK_UP = 6
int REG_SHOCK_DN = 7
int REG_POST_SHOCK = 8
int REG_TRANSITION = 9

int ARC_UNKNOWN = 0
int ARC_FAILED_AUCTION = 1
int ARC_DEFENSE = 2
int ARC_ACCEPTANCE = 3
int ARC_DISCOVERY = 4
int ARC_RETRY = 5

// v0.18 completed higher-timeframe descriptive states. These are interpretation
// labels built from BUS21 facts; they never inspect future HTF bars.
int HTF_UNKNOWN = 0
int HTF_ROTATION = 1
int HTF_UP = 2
int HTF_DOWN = 3
int HTF_UP_EXTENDED = 4
int HTF_DOWN_EXTENDED = 5
int HTF_TRANSITION = 6

// Side-relative story codes. No numeric score: the code describes the causal
// relationship between the local thesis and completed setup/macro auctions.
int HST_UNKNOWN = 0
int HST_ALIGNED = 1
int HST_PULLBACK = 2
int HST_COUNTER_HEALTHY = 3
int HST_COUNTER_EXTENDED = 4
int HST_NEUTRAL = 5

int ACT_WAIT = 0
int ACT_WATCH_LONG = 1
int ACT_WATCH_SHORT = -1
int ACT_ARM_LONG = 2
int ACT_ARM_SHORT = -2
int ACT_ENTER_LONG = 3
int ACT_ENTER_SHORT = -3
int ACT_CANCEL = 4

float tick = syminfo.mintick
float atr = ta.atr(atrLen)
float stopBuf = math.max(tick * 2.0, atr * stopBufferAtr)

// Midnight–4:00 AM Pacific blackout.
// "preBlackoutBar" identifies the bar whose CLOSE timestamp is midnight.
// On the 5-minute control chart this is the 23:55 bar. A market close order
// generated there fills at the next bar open (00:00) with
// process_orders_on_close=false.
bool noTradeWindow = not na(time(timeframe.period, NO_TRADE_SESSION, TRADE_TZ))
bool preBlackoutBar = not noTradeWindow and hour(time_close, TRADE_TZ) == 0 and minute(time_close, TRADE_TZ) == 0

bool preRthTransition = not na(time(timeframe.period, PRE_RTH_TRANSITION, TRADE_TZ))
bool preCloseTransition = not na(time(timeframe.period, PRE_CLOSE_TRANSITION, TRADE_TZ))
bool preRthBoundaryBar = not preRthTransition and hour(time_close, TRADE_TZ) == 6 and minute(time_close, TRADE_TZ) == 15
bool preCloseBoundaryBar = not preCloseTransition and hour(time_close, TRADE_TZ) == 12 and minute(time_close, TRADE_TZ) == 45
bool sessionTransitionWindow = preRthTransition or preCloseTransition
bool sessionTransitionBoundary = preRthBoundaryBar or preCloseBoundaryBar
bool sessionEntryBlock = sessionTransitionWindow or sessionTransitionBoundary

bool lateRthRunway = not na(time(timeframe.period, LATE_RTH_RUNWAY, TRADE_TZ))

// PROP SHIELD state.
// Daily result is tracked in realized R using each trade's original structural
// risk. A full STOP can disable new execution for the rest of the Pacific day.
var float propDailyRealizedR = 0.0
var int propDailyStops = 0
var bool propShieldActive = false
var int propDayStamp = na
var int lastShieldClosedSeen = 0

bool propExecutionWindow = not na(time(timeframe.period, PROP_EXECUTION_SESSION, TRADE_TZ))

// Because process_orders_on_close=false, an order created on the bar whose close
// timestamp is 13:00 would become eligible only after the allowed window. Block
// that bar from creating new entries.
bool propExecutionEndBoundary =
     hour(time_close, TRADE_TZ) == 13 and minute(time_close, TRADE_TZ) == 0

bool entriesAllowedNow =
     propExecutionWindow and
     not propExecutionEndBoundary and
     not noTradeWindow and
     not preBlackoutBar and
     not sessionEntryBlock and
     not propShieldActive

// ─────────────────────────────────────────────────────────────────────────────
// BOT1 DECODERS
// Bot1 metadata integer digits: SSSTTWWWW + source/100
// SSS strength, TT lifecycle state, WWWW half-width ticks.
// ─────────────────────────────────────────────────────────────────────────────
f_auctionText(int c) =>
    c == AUC_BALANCE ? "BALANCE" :
     c == AUC_BUILD ? "BUILDING BALANCE" :
     c == AUC_TEST_UP ? "TESTING UP" :
     c == AUC_TEST_DN ? "TESTING DOWN" :
     c == AUC_FAIL_UP ? "FAILED UP" :
     c == AUC_FAIL_DN ? "FAILED DOWN" :
     c == AUC_EXP_UP ? "EXPANDING UP" :
     c == AUC_EXP_DN ? "EXPANDING DOWN" :
     c == AUC_CHOP ? "ROTATION / CHOP" : "TRANSITION"

f_metaInt(float meta) =>
    na(meta) ? 0 : int(math.floor(meta + 0.000001))

f_metaStrength(float meta) =>
    int(math.floor(f_metaInt(meta) / 1000000))

f_metaState(float meta) =>
    int(math.floor((f_metaInt(meta) % 1000000) / 10000))

f_metaWidthTicks(float meta) =>
    f_metaInt(meta) % 10000

f_metaSource(float meta) =>
    if na(meta)
        0
    else
        int(math.round((meta - math.floor(meta)) * 100.0))

f_metaValid(float meta) =>
    if na(meta)
        true
    else
        int stg = f_metaStrength(meta)
        int st = f_metaState(meta)
        int src = f_metaSource(meta)
        stg >= 1 and stg <= 20 and st >= 1 and st <= 6 and src >= 1 and src <= 9

int mapVersion = int(math.floor(busHeader))
int auctionCode = int(math.round((busHeader - math.floor(busHeader)) * 100.0))
bool headerValid = mapVersion >= 1 and auctionCode >= 1 and auctionCode <= 10

// Bot1 v0.6 BUS10 v3 decoder.
int ctxWork = int(math.round(busContext))
int weekdayCtx = ctxWork % 6
ctxWork := int(math.floor(ctxWork / 6))
int s1ReactionCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int r1ReactionCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int s1BattleCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int r1BattleCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int openingRangeCtx = ctxWork % 4
ctxWork := int(math.floor(ctxWork / 4))
int openingAuctionCtx = ctxWork % 8
ctxWork := int(math.floor(ctxWork / 8))
int gapCtx = ctxWork % 6
ctxWork := int(math.floor(ctxWork / 6))
int openLocationCtx = ctxWork % 6
ctxWork := int(math.floor(ctxWork / 6))
int shockExtremeAgeCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int shockRetraceCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int shockImpulseCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int shockAgeCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int shockEvidenceCtx = ctxWork % 8
ctxWork := int(math.floor(ctxWork / 8))
int shockDirCodeCtx = ctxWork % 3
ctxWork := int(math.floor(ctxWork / 3))
int shockStateCtx = ctxWork % 4
ctxWork := int(math.floor(ctxWork / 4))
int ctxPrefix = ctxWork
bool ctxValid = ctxPrefix == 8
int shockDirCtx = shockDirCodeCtx - 1

// Bot1 v0.6 BUS11 decoder.
int clkWork = int(math.round(busClock))
int shockEpisodeCountCtx = clkWork % 10
clkWork := int(math.floor(clkWork / 10))
int vixMoveCtx = clkWork % 6
clkWork := int(math.floor(clkWork / 6))
int vixLevelCtx = clkWork % 4
clkWork := int(math.floor(clkWork / 4))
int esContextCtx = clkWork % 6
clkWork := int(math.floor(clkWork / 6))
int calendarCtx = clkWork % 3
clkWork := int(math.floor(clkWork / 3))
int rangePaceCodeCtx = clkWork % 32
clkWork := int(math.floor(clkWork / 32))
int volumePaceCodeCtx = clkWork % 32
clkWork := int(math.floor(clkWork / 32))
int timeEffCodeCtx = clkWork % 32
clkWork := int(math.floor(clkWork / 32))
int timeRangeCodeCtx = clkWork % 32
clkWork := int(math.floor(clkWork / 32))
int timeVolCodeCtx = clkWork % 32
clkWork := int(math.floor(clkWork / 32))
int clockReadyCodeCtx = clkWork % 2
clkWork := int(math.floor(clkWork / 2))
int rthSlotCtx = clkWork % 79
clkWork := int(math.floor(clkWork / 79))
int clockPrefix = clkWork
bool clockCtxValid = clockPrefix == 7
bool clockReadyCtx = clockCtxValid and clockReadyCodeCtx == 1

float timeRelVolCtx = float(timeVolCodeCtx) / 10.0
float timeRelRangeCtx = float(timeRangeCodeCtx) / 10.0
float timeRelEffCtx = float(timeEffCodeCtx) / 10.0
float volumePaceCtx = float(volumePaceCodeCtx) / 10.0
float rangePaceCtx = float(rangePaceCodeCtx) / 10.0
bool busValid = headerValid and f_metaValid(busR1Meta) and f_metaValid(busS1Meta) and ctxValid and clockCtxValid

// Universal Eyes v1.2 BUS20 decoder. Signature 41 + detail + 0.1 ATR move bins.
int crossWork = int(math.round(busCrossDetail))
int crossEsMoveCode = crossWork % 61
crossWork := int(math.floor(crossWork / 61))
int crossNqMoveCode = crossWork % 61
crossWork := int(math.floor(crossWork / 61))
int crossDetailCode = crossWork % 10
crossWork := int(math.floor(crossWork / 10))
int crossDetailPrefix = crossWork
bool crossDetailValid = useCrossDetailV2 and math.abs(busCrossDetail - close) > tick and crossDetailPrefix == 41 and crossDetailCode >= 0 and crossDetailCode <= 9
float crossNqMoveAtr = crossDetailValid ? float(crossNqMoveCode - 30) / 10.0 : na
float crossEsMoveAtr = crossDetailValid ? float(crossEsMoveCode - 30) / 10.0 : na

// Universal Eyes v1.3 BUS21 decoder. Signature 37.  BUS21 intentionally carries
// only completed-HTF measurements; interpretation stays here in Bot2.
int htfWork = int(math.round(busMultiHtf))
int htfMacroLocCode = htfWork % 22
htfWork := int(math.floor(htfWork / 22))
int htfMacroEffCode = htfWork % 22
htfWork := int(math.floor(htfWork / 22))
int htfMacroDispCode = htfWork % 42
htfWork := int(math.floor(htfWork / 42))
int htfSetupLocCode = htfWork % 22
htfWork := int(math.floor(htfWork / 22))
int htfSetupEffCode = htfWork % 22
htfWork := int(math.floor(htfWork / 22))
int htfSetupDispCode = htfWork % 42
htfWork := int(math.floor(htfWork / 42))
int htfPrefix = htfWork

bool multiHtfValid = useUniversalExtras and math.abs(busMultiHtf - close) > tick and htfPrefix == 37 and
     htfSetupDispCode >= 0 and htfSetupDispCode <= 41 and htfMacroDispCode >= 0 and htfMacroDispCode <= 41 and
     htfSetupEffCode >= 0 and htfSetupEffCode <= 21 and htfMacroEffCode >= 0 and htfMacroEffCode <= 21 and
     htfSetupLocCode >= 0 and htfSetupLocCode <= 21 and htfMacroLocCode >= 0 and htfMacroLocCode <= 21

float htfSetupDispAtr = multiHtfValid and htfSetupDispCode != 41 ? float(htfSetupDispCode - 20) / 2.0 : na
float htfSetupEfficiency = multiHtfValid and htfSetupEffCode != 21 ? float(htfSetupEffCode) / 20.0 : na
float htfSetupLocation = multiHtfValid and htfSetupLocCode != 21 ? float(htfSetupLocCode) / 20.0 : na
float htfMacroDispAtr = multiHtfValid and htfMacroDispCode != 41 ? float(htfMacroDispCode - 20) / 2.0 : na
float htfMacroEfficiency = multiHtfValid and htfMacroEffCode != 21 ? float(htfMacroEffCode) / 20.0 : na
float htfMacroLocation = multiHtfValid and htfMacroLocCode != 21 ? float(htfMacroLocCode) / 20.0 : na

// Universal Eyes v1.4 BUS22/23 compact decoders. Keeping the mixed-radix
// unpacking inside functions prevents the strategy main body from growing
// unnecessarily while preserving exact bus semantics.
f_decodeMicroRows(float rawBus) =>
    int w = int(math.round(rawBus))
    int bottomSellAccept = w % 2
    w := int(math.floor(w / 2))
    int topBuyAccept = w % 2
    w := int(math.floor(w / 2))
    int bottomSellPoor = w % 2
    w := int(math.floor(w / 2))
    int topBuyPoor = w % 2
    w := int(math.floor(w / 2))
    int bottomDeltaSign = w % 3
    w := int(math.floor(w / 3))
    int topDeltaSign = w % 3
    w := int(math.floor(w / 3))
    int bottomSellImb = w % 8
    w := int(math.floor(w / 8))
    int bottomBuyImb = w % 8
    w := int(math.floor(w / 8))
    int topSellImb = w % 8
    w := int(math.floor(w / 8))
    int topBuyImb = w % 8
    w := int(math.floor(w / 8))
    [w, topBuyImb, topSellImb, bottomBuyImb, bottomSellImb,
     topDeltaSign, bottomDeltaSign, topBuyPoor, bottomSellPoor,
     topBuyAccept, bottomSellAccept]

[microPrefix, microTopBuyImb, microTopSellImb, microBottomBuyImb, microBottomSellImb,
 microTopDeltaSignCode, microBottomDeltaSignCode, microTopBuyPoorCode, microBottomSellPoorCode,
 microTopBuyAcceptCode, microBottomSellAcceptCode] = f_decodeMicroRows(busMicroRows)

bool microRowsValid = useUniversalExtras and footprintDecisionEnabled and edgeUseRowMicro and
     math.abs(busMicroRows - close) > tick and microPrefix == 53
bool microTopBuyPoor = microRowsValid and microTopBuyPoorCode == 1
bool microBottomSellPoor = microRowsValid and microBottomSellPoorCode == 1
bool microTopBuyAccept = microRowsValid and microTopBuyAcceptCode == 1
bool microBottomSellAccept = microRowsValid and microBottomSellAcceptCode == 1
bool microTopBuyPressure = microRowsValid and (microTopBuyImb >= 1 or microTopDeltaSignCode == 2)
bool microTopSellPressure = microRowsValid and (microTopSellImb >= 1 or microTopDeltaSignCode == 0)
bool microBottomBuyPressure = microRowsValid and (microBottomBuyImb >= 1 or microBottomDeltaSignCode == 2)
bool microBottomSellPressure = microRowsValid and (microBottomSellImb >= 1 or microBottomDeltaSignCode == 0)

f_decodeFlowFacts(float rawBus) =>
    int w = int(math.round(rawBus))
    int latePhase = w % 5
    w := int(math.floor(w / 5))
    int rthLoc = w % 11
    w := int(math.floor(w / 11))
    int rthDisp = w % 61
    w := int(math.floor(w / 61))
    int leadLag = w % 11
    w := int(math.floor(w / 11))
    [w, leadLag, rthDisp, rthLoc, latePhase]

[flowPrefix, leadLagCode, rthDispCode, rthLocationCode, latePhaseCode] = f_decodeFlowFacts(busFlowFacts)
bool flowFactsValid = useUniversalExtras and
     math.abs(busFlowFacts - close) > tick and flowPrefix == 59 and leadLagCode >= 0 and leadLagCode <= 10
bool leadLagFactsEnabled = flowFactsValid and edgeUseLeadLag
float rthDispAtrFact = flowFactsValid ? float(rthDispCode - 30) / 10.0 : na
float rthLocationFact = flowFactsValid and rthLocationCode > 0 ? (float(rthLocationCode) - 0.5) / 10.0 : na

bool leadLagLongSupport = leadLagFactsEnabled and (leadLagCode == 1 or leadLagCode == 3 or leadLagCode == 7)
bool leadLagShortSupport = leadLagFactsEnabled and (leadLagCode == 2 or leadLagCode == 4 or leadLagCode == 8)
bool leadLagAgainstLong = leadLagFactsEnabled and (leadLagCode == 2 or leadLagCode == 4 or leadLagCode == 6 or leadLagCode == 8 or leadLagCode == 9)
bool leadLagAgainstShort = leadLagFactsEnabled and (leadLagCode == 1 or leadLagCode == 3 or leadLagCode == 5 or leadLagCode == 7 or leadLagCode == 9)
bool nqUpUnconfirmed = leadLagFactsEnabled and leadLagCode == 5
bool nqDnUnconfirmed = leadLagFactsEnabled and leadLagCode == 6
bool edgeStackLive = edgeStackMode == "LIVE"
bool edgeStackObserve = edgeStackMode != "OFF"

// Broad descriptive references deliberately mirror the existing one-hour regime
// language instead of being optimized by year. IMPORTANT v0.19 correction:
// UPX/DNX mean STRONG / IMPULSIVE directional pressure (large displacement,
// directional efficiency, location near the extreme). Distance traveled alone
// is NOT exhaustion. Exhaustion requires a later failure / transfer sequence.
f_htfState(float dispAtr, float efficiency, float location) =>
    int st = HTF_UNKNOWN
    if not na(dispAtr) and not na(efficiency) and not na(location)
        bool dirUp = dispAtr >= 0.75 and efficiency >= 0.35
        bool dirDn = dispAtr <= -0.75 and efficiency >= 0.35
        bool rot = math.abs(dispAtr) <= 0.75 and efficiency <= 0.25
        st := dirUp and dispAtr >= 2.0 and location >= 0.80 ? HTF_UP_EXTENDED :
             dirDn and dispAtr <= -2.0 and location <= 0.20 ? HTF_DOWN_EXTENDED :
             dirUp ? HTF_UP :
             dirDn ? HTF_DOWN :
             rot ? HTF_ROTATION : HTF_TRANSITION
    st

f_htfUp(int st) =>
    st == HTF_UP or st == HTF_UP_EXTENDED

f_htfDown(int st) =>
    st == HTF_DOWN or st == HTF_DOWN_EXTENDED

f_htfUpExtended(int st) =>
    st == HTF_UP_EXTENDED

f_htfDownExtended(int st) =>
    st == HTF_DOWN_EXTENDED

int htfSetupState = f_htfState(htfSetupDispAtr, htfSetupEfficiency, htfSetupLocation)
int htfMacroState = f_htfState(htfMacroDispAtr, htfMacroEfficiency, htfMacroLocation)

f_sideHtfStory(int side) =>
    bool sSide = side == SIDE_LONG ? f_htfUp(htfSetupState) : f_htfDown(htfSetupState)
    bool sOpp = side == SIDE_LONG ? f_htfDown(htfSetupState) : f_htfUp(htfSetupState)
    bool mSide = side == SIDE_LONG ? f_htfUp(htfMacroState) : f_htfDown(htfMacroState)
    bool mOpp = side == SIDE_LONG ? f_htfDown(htfMacroState) : f_htfUp(htfMacroState)
    bool oppExtended = side == SIDE_LONG ? (f_htfDownExtended(htfSetupState) or f_htfDownExtended(htfMacroState)) :
         (f_htfUpExtended(htfSetupState) or f_htfUpExtended(htfMacroState))
    int story = HST_UNKNOWN
    if multiHtfValid
        story := mSide and sOpp ? HST_PULLBACK :
             mOpp and not sSide ? (oppExtended ? HST_COUNTER_EXTENDED : HST_COUNTER_HEALTHY) :
             mOpp and sSide ? (oppExtended ? HST_COUNTER_EXTENDED : HST_COUNTER_HEALTHY) :
             (mSide or sSide) and not (mOpp or sOpp) ? HST_ALIGNED :
             (mOpp or sOpp) ? (oppExtended ? HST_COUNTER_EXTENDED : HST_COUNTER_HEALTHY) : HST_NEUTRAL
    story

int longHtfStory = f_sideHtfStory(SIDE_LONG)
int shortHtfStory = f_sideHtfStory(SIDE_SHORT)
bool worldModelLive = multiHorizonMode == "LIVE" and multiHtfValid
bool worldModelShadow = multiHorizonMode == "SHADOW" and multiHtfValid

// ─────────────────────────────────────────────────────────────────────────────
// UNIVERSAL EYES v1.1 ADDITIVE SENSOR DECODER
// IMPORTANT: does not participate in `busValid`; BUS1–11 compatibility remains
// frozen. Extra sensors are trusted only when the explicit master switch is ON
// and BUS16 decodes to the v1 signature prefix 31.
// ─────────────────────────────────────────────────────────────────────────────
int sensorWork = int(math.round(busSensor))
int sensorMapSCode = sensorWork % 2
sensorWork := int(math.floor(sensorWork / 2))
int sensorMapRCode = sensorWork % 2
sensorWork := int(math.floor(sensorWork / 2))
int sensorInRthCode = sensorWork % 2
sensorWork := int(math.floor(sensorWork / 2))
int sensorClockCode = sensorWork % 2
sensorWork := int(math.floor(sensorWork / 2))
int sensorVixCode = sensorWork % 2
sensorWork := int(math.floor(sensorWork / 2))
int sensorBenchmarkCode = sensorWork % 2
sensorWork := int(math.floor(sensorWork / 2))
int sensorCrossConfiguredCode = sensorWork % 2
sensorWork := int(math.floor(sensorWork / 2))
int sensorFpHasCode = sensorWork % 2
sensorWork := int(math.floor(sensorWork / 2))
int sensorFpConfiguredCode = sensorWork % 2
sensorWork := int(math.floor(sensorWork / 2))
int sensorProfileCode = sensorWork % 3
sensorWork := int(math.floor(sensorWork / 3))
int sensorPrefix = sensorWork
bool sensorValid = useUniversalExtras and math.abs(busSensor - close) > tick and sensorPrefix == 31 and (sensorProfileCode == 1 or sensorProfileCode == 2)
bool sensorFpConfigured = sensorValid and sensorFpConfiguredCode == 1
bool sensorFpAvailable = sensorValid and sensorFpHasCode == 1
bool sensorBenchmarkAvailable = sensorValid and sensorBenchmarkCode == 1
bool sensorVixAvailable = sensorValid and sensorVixCode == 1
bool sensorClockAvailable = sensorValid and sensorClockCode == 1
bool sensorMapRAvailable = sensorValid and sensorMapRCode == 1
bool sensorMapSAvailable = sensorValid and sensorMapSCode == 1

// BUS12 exact reverse decoder inherited from Universal Eyes / Option1.
int fpEyeWork = int(math.round(busFpEyes))
int fpPocLocCode = fpEyeWork % 5
fpEyeWork := int(math.floor(fpEyeWork / 5))
int fpLowerDeltaSignCode = fpEyeWork % 3
fpEyeWork := int(math.floor(fpEyeWork / 3))
int fpUpperDeltaSignCode = fpEyeWork % 3
fpEyeWork := int(math.floor(fpEyeWork / 3))
int fpBuyerAbsFactCode = fpEyeWork % 2
fpEyeWork := int(math.floor(fpEyeWork / 2))
int fpSellerAbsFactCode = fpEyeWork % 2
fpEyeWork := int(math.floor(fpEyeWork / 2))
int fpSellImbCount = fpEyeWork % 8
fpEyeWork := int(math.floor(fpEyeWork / 8))
int fpBuyImbCount = fpEyeWork % 8
fpEyeWork := int(math.floor(fpEyeWork / 8))
int fpMaxSellStack = fpEyeWork % 8
fpEyeWork := int(math.floor(fpEyeWork / 8))
int fpMaxBuyStack = fpEyeWork % 8
fpEyeWork := int(math.floor(fpEyeWork / 8))
int fpValueMigCode = fpEyeWork % 3
fpEyeWork := int(math.floor(fpEyeWork / 3))
int fpPocMigCode = fpEyeWork % 3
fpEyeWork := int(math.floor(fpEyeWork / 3))
int fpDeltaCode = fpEyeWork % 21
fpEyeWork := int(math.floor(fpEyeWork / 21))
int fpHasCode = fpEyeWork % 2
fpEyeWork := int(math.floor(fpEyeWork / 2))
int fpEyePrefix = fpEyeWork
bool fpEyesValid = useUniversalExtras and fpEyePrefix == 21
bool fpHas = footprintDecisionEnabled and sensorFpAvailable and fpEyesValid and fpHasCode == 1
float fpPackedDeltaPct = fpHas ? float(fpDeltaCode - 10) * 0.05 : na
bool fpRawDeltaValid = fpHas and not na(busFpRawDelta) and busFpRawDelta >= -1.01 and busFpRawDelta <= 1.01
float fpDeltaPct = fpHas ? (fpRawDeltaValid ? busFpRawDelta : fpPackedDeltaPct) : na
float fpPocMid = fpHas ? busFpPoc : na
float fpValueMid = fpHas ? busFpValue : na
float fpUpperDelta = fpUpperDeltaSignCode == 2 ? 1.0 : fpUpperDeltaSignCode == 0 ? -1.0 : 0.0
float fpLowerDelta = fpLowerDeltaSignCode == 2 ? 1.0 : fpLowerDeltaSignCode == 0 ? -1.0 : 0.0
bool fpSellerAbsorptionFact = fpHas and fpSellerAbsFactCode == 1
bool fpBuyerAbsorptionFact = fpHas and fpBuyerAbsFactCode == 1
bool fpPocUp = fpHas and fpPocMigCode == 2
bool fpPocDown = fpHas and fpPocMigCode == 0
bool fpValueUp = fpHas and fpValueMigCode == 2
bool fpValueDown = fpHas and fpValueMigCode == 0
bool fpBuyStacked = fpHas and fpMaxBuyStack >= 2
bool fpSellStacked = fpHas and fpMaxSellStack >= 2
bool fpAggBuy = fpHas and fpDeltaPct >= fpInitiativeDelta
bool fpAggSell = fpHas and fpDeltaPct <= -fpInitiativeDelta
bool fpVahValValid = fpHas and not na(busFpVah) and not na(busFpVal) and busFpVah >= busFpVal and
     busFpVah <= high + tick * 2.0 and busFpVal >= low - tick * 2.0
float fpValueWidthAtr = fpVahValValid ? (busFpVah - busFpVal) / math.max(atr, tick) : na

int rStrength = f_metaStrength(busR1Meta)
int rState = f_metaState(busR1Meta)
int rSource = f_metaSource(busR1Meta)
float rHalf = f_metaWidthTicks(busR1Meta) * tick
float rLo = na(busR1) or na(busR1Meta) ? na : busR1 - rHalf
float rHi = na(busR1) or na(busR1Meta) ? na : busR1 + rHalf

int sStrength = f_metaStrength(busS1Meta)
int sState = f_metaState(busS1Meta)
int sSource = f_metaSource(busS1Meta)
float sHalf = f_metaWidthTicks(busS1Meta) * tick
float sLo = na(busS1) or na(busS1Meta) ? na : busS1 - sHalf
float sHi = na(busS1) or na(busS1Meta) ? na : busS1 + sHalf


// ─────────────────────────────────────────────────────────────────────────────
// v0.28 MAIN-BODY SPLIT HELPERS
// These functions preserve the v0.28 logic while moving state-heavy research
// calculations out of Pine's global/main scope (CE10295 protection).
// ─────────────────────────────────────────────────────────────────────────────
f_v28Territory(float netMoveNow, float atrNow, float territoryMinAtrNow, float buyerShareNow, float rangePosNow, bool observe, bool live) =>
    bool upRaw = netMoveNow >= atrNow * territoryMinAtrNow and buyerShareNow >= 0.56
    bool dnRaw = netMoveNow <= -atrNow * territoryMinAtrNow and buyerShareNow <= 0.44
    var bool upSticky = false
    var bool dnSticky = false
    if not observe
        upSticky := upRaw
        dnSticky := dnRaw
    else
        if upSticky and (dnRaw or netMoveNow < atrNow * territoryMinAtrNow * 0.65 or buyerShareNow < 0.50)
            upSticky := false
        if dnSticky and (upRaw or netMoveNow > -atrNow * territoryMinAtrNow * 0.65 or buyerShareNow > 0.50)
            dnSticky := false
        if not upSticky and upRaw and not dnSticky
            upSticky := true
        if not dnSticky and dnRaw and not upSticky
            dnSticky := true
    bool upNow = live ? upSticky : upRaw
    bool dnNow = live ? dnSticky : dnRaw
    bool upHold = not upNow and netMoveNow >= 0 and rangePosNow >= 0.62 and buyerShareNow >= 0.51
    bool dnHold = not dnNow and netMoveNow <= 0 and rangePosNow <= 0.38 and buyerShareNow <= 0.49
    bool upLoose = netMoveNow >= atrNow * territoryMinAtrNow * 0.85 and buyerShareNow >= 0.54
    bool upStrict = netMoveNow >= atrNow * territoryMinAtrNow * 1.15 and buyerShareNow >= 0.58
    bool dnLoose = netMoveNow <= -atrNow * territoryMinAtrNow * 0.85 and buyerShareNow <= 0.46
    bool dnStrict = netMoveNow <= -atrNow * territoryMinAtrNow * 1.15 and buyerShareNow <= 0.42
    int thresholdBits = (upLoose != upStrict ? 1 : 0) + (dnLoose != dnStrict ? 2 : 0)
    int diffBits = (upRaw != upSticky ? 1 : 0) + (dnRaw != dnSticky ? 2 : 0)
    [upNow, dnNow, upHold, dnHold, thresholdBits, diffBits]

f_v28EffortStates(float buyerEffortNow, float sellerEffortNow, float buyerResultNow, float sellerResultNow,
     float upTravelNow, float dnTravelNow, float tickNow, bool observe, bool live) =>
    bool buyerPoorRaw = buyerEffortNow >= 0.45 and buyerResultNow < 0.14
    bool sellerPoorRaw = sellerEffortNow >= 0.45 and sellerResultNow < 0.14
    bool buyerSponsoredRaw = buyerEffortNow >= 0.25 and buyerResultNow >= 0.18
    bool sellerSponsoredRaw = sellerEffortNow >= 0.25 and sellerResultNow >= 0.18
    var bool buyerPoorSticky = false
    var bool sellerPoorSticky = false
    var bool buyerSponsoredSticky = false
    var bool sellerSponsoredSticky = false
    if not observe
        buyerPoorSticky := buyerPoorRaw
        sellerPoorSticky := sellerPoorRaw
        buyerSponsoredSticky := buyerSponsoredRaw
        sellerSponsoredSticky := sellerSponsoredRaw
    else
        if buyerPoorSticky and (buyerEffortNow < 0.35 or buyerResultNow >= 0.20)
            buyerPoorSticky := false
        else if not buyerPoorSticky and buyerPoorRaw
            buyerPoorSticky := true
        if sellerPoorSticky and (sellerEffortNow < 0.35 or sellerResultNow >= 0.20)
            sellerPoorSticky := false
        else if not sellerPoorSticky and sellerPoorRaw
            sellerPoorSticky := true
        if buyerSponsoredSticky and (buyerEffortNow < 0.18 or buyerResultNow < 0.12 or sellerSponsoredRaw and sellerResultNow > buyerResultNow)
            buyerSponsoredSticky := false
        else if not buyerSponsoredSticky and buyerSponsoredRaw
            buyerSponsoredSticky := true
        if sellerSponsoredSticky and (sellerEffortNow < 0.18 or sellerResultNow < 0.12 or buyerSponsoredRaw and buyerResultNow > sellerResultNow)
            sellerSponsoredSticky := false
        else if not sellerSponsoredSticky and sellerSponsoredRaw
            sellerSponsoredSticky := true
    bool buyerPoorNow = live ? buyerPoorSticky : buyerPoorRaw
    bool sellerPoorNow = live ? sellerPoorSticky : sellerPoorRaw
    bool buyerSponsoredNow = live ? buyerSponsoredSticky : buyerSponsoredRaw
    bool sellerSponsoredNow = live ? sellerSponsoredSticky : sellerSponsoredRaw
    bool buyerPoorLoose = buyerEffortNow >= 0.40 and buyerResultNow < 0.16
    bool buyerPoorStrict = buyerEffortNow >= 0.50 and buyerResultNow < 0.12
    bool sellerPoorLoose = sellerEffortNow >= 0.40 and sellerResultNow < 0.16
    bool sellerPoorStrict = sellerEffortNow >= 0.50 and sellerResultNow < 0.12
    bool buyerSponsoredLoose = buyerEffortNow >= 0.22 and buyerResultNow >= 0.16
    bool buyerSponsoredStrict = buyerEffortNow >= 0.28 and buyerResultNow >= 0.20
    bool sellerSponsoredLoose = sellerEffortNow >= 0.22 and sellerResultNow >= 0.16
    bool sellerSponsoredStrict = sellerEffortNow >= 0.28 and sellerResultNow >= 0.20
    float counterRatioNow = dnTravelNow > tickNow ? upTravelNow / dnTravelNow : upTravelNow > tickNow ? 10.0 : 1.0
    bool sellerCounterRaw = counterRatioNow >= 1.55
    bool buyerCounterRaw = counterRatioNow <= 0.645
    var bool sellerCounterSticky = false
    var bool buyerCounterSticky = false
    if not observe
        sellerCounterSticky := sellerCounterRaw
        buyerCounterSticky := buyerCounterRaw
    else
        if sellerCounterSticky and counterRatioNow < 1.30
            sellerCounterSticky := false
        else if not sellerCounterSticky and sellerCounterRaw
            sellerCounterSticky := true
        if buyerCounterSticky and counterRatioNow > 0.77
            buyerCounterSticky := false
        else if not buyerCounterSticky and buyerCounterRaw
            buyerCounterSticky := true
    bool sellerCounterNow = live ? sellerCounterSticky : sellerCounterRaw
    bool buyerCounterNow = live ? buyerCounterSticky : buyerCounterRaw
    int thresholdBits =
         (buyerSponsoredLoose != buyerSponsoredStrict ? 4 : 0) +
         (sellerSponsoredLoose != sellerSponsoredStrict ? 8 : 0) +
         (buyerPoorLoose != buyerPoorStrict ? 16 : 0) +
         (sellerPoorLoose != sellerPoorStrict ? 32 : 0)
    int diffBits =
         (buyerSponsoredRaw != buyerSponsoredSticky ? 4 : 0) +
         (sellerSponsoredRaw != sellerSponsoredSticky ? 8 : 0) +
         (buyerPoorRaw != buyerPoorSticky ? 16 : 0) +
         (sellerPoorRaw != sellerPoorSticky ? 32 : 0)
    [buyerPoorNow, sellerPoorNow, buyerSponsoredNow, sellerSponsoredNow, sellerCounterNow, buyerCounterNow, thresholdBits, diffBits]

f_v28Initiative(bool longStrongNow, bool shortStrongNow, bool fpLongNow, bool fpShortNow,
     bool longAcceptanceNow, bool shortAcceptanceNow, bool upTerritoryNow, bool dnTerritoryNow,
     bool buyerSponsoredNow, bool sellerSponsoredNow, bool observe, bool live) =>
    bool longPriceOnly = longStrongNow and not fpLongNow
    bool shortPriceOnly = shortStrongNow and not fpShortNow
    var int longClaimBar = na
    var int shortClaimBar = na
    var float longClaimExtreme = na
    var float shortClaimExtreme = na
    var bool longClaimProved = false
    var bool shortClaimProved = false
    if not observe
        longClaimBar := na
        shortClaimBar := na
        longClaimExtreme := na
        shortClaimExtreme := na
        longClaimProved := false
        shortClaimProved := false
    else
        if longPriceOnly and (na(longClaimBar) or not longPriceOnly[1])
            longClaimBar := bar_index
            longClaimExtreme := high
            longClaimProved := false
        if shortPriceOnly and (na(shortClaimBar) or not shortPriceOnly[1])
            shortClaimBar := bar_index
            shortClaimExtreme := low
            shortClaimProved := false
        bool longProofNow = not na(longClaimBar) and bar_index > longClaimBar and
             (fpLongNow or longAcceptanceNow or
              (upTerritoryNow and buyerSponsoredNow and not sellerSponsoredNow and close > nz(longClaimExtreme, high)))
        bool shortProofNow = not na(shortClaimBar) and bar_index > shortClaimBar and
             (fpShortNow or shortAcceptanceNow or
              (dnTerritoryNow and sellerSponsoredNow and not buyerSponsoredNow and close < nz(shortClaimExtreme, low)))
        if longProofNow
            longClaimProved := true
        if shortProofNow
            shortClaimProved := true
        if (dnTerritoryNow and sellerSponsoredNow) or (not longStrongNow and not fpLongNow)
            longClaimBar := na
            longClaimExtreme := na
            longClaimProved := false
        if (upTerritoryNow and buyerSponsoredNow) or (not shortStrongNow and not fpShortNow)
            shortClaimBar := na
            shortClaimExtreme := na
            shortClaimProved := false
    bool longRobust = fpLongNow or (longStrongNow and (not longPriceOnly or longClaimProved))
    bool shortRobust = fpShortNow or (shortStrongNow and (not shortPriceOnly or shortClaimProved))
    bool longNow = live ? longRobust : (longStrongNow or fpLongNow)
    bool shortNow = live ? shortRobust : (shortStrongNow or fpShortNow)
    bool freshLongLegacy = (longStrongNow and not longStrongNow[1]) or (fpLongNow and not fpLongNow[1])
    bool freshShortLegacy = (shortStrongNow and not shortStrongNow[1]) or (fpShortNow and not fpShortNow[1])
    bool freshLongRobust = longRobust and not longRobust[1]
    bool freshShortRobust = shortRobust and not shortRobust[1]
    bool freshLongNow = live ? freshLongRobust : freshLongLegacy
    bool freshShortNow = live ? freshShortRobust : freshShortLegacy
    [longPriceOnly, shortPriceOnly, longClaimProved, shortClaimProved, longNow, shortNow, freshLongNow, freshShortNow]

f_v28Regime(float atrNow, float tickNow, float buyerShareNow, int auctionCodeNow,
     bool clockReadyNow, float timeRelRangeNow, float timeRelVolNow,
     bool ctxValidNow, int shockStateNow, int shockDirNow,
     bool sensorValidNow, float rthVwapNow, bool fpHasNow, float fpPocNow,
     bool observe, bool live) =>
    int lookback = 12
    int atrBaseLen = 78
    float path12 = math.sum(math.abs(close - close[1]), lookback)
    float disp12 = not na(close[lookback]) ? close - close[lookback] : 0.0
    float efficiency12 = path12 > tickNow ? math.abs(disp12) / path12 : 0.0
    float dispAtr12 = atrNow > tickNow ? disp12 / atrNow : 0.0
    float thisRange = math.max(high - low, tickNow)
    float prevRange = math.max(high[1] - low[1], tickNow)
    float overlapPts = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
    float overlapOne = overlapPts / math.max(math.min(thisRange, prevRange), tickNow)
    float overlap12 = ta.sma(overlapOne, lookback)
    float chNow = close - close[1]
    float prevCh = close[1] - close[2]
    float flipOne = not na(chNow) and not na(prevCh) and chNow * prevCh < 0 ? 1.0 : 0.0
    float flip12 = ta.sma(flipOne, lookback)
    float atrBase = ta.ema(atrNow, atrBaseLen)
    float atrRatio = atrBase > tickNow ? atrNow / atrBase : 1.0
    float vwapDistAtr = sensorValidNow and not na(rthVwapNow) and atrNow > tickNow ? (close - rthVwapNow) / atrNow : na
    float pocDistAtr = fpHasNow and not na(fpPocNow) and atrNow > tickNow ? (close - fpPocNow) / atrNow : na
    bool shockActive = ctxValidNow and (shockStateNow == 1 or shockStateNow == 2) and shockDirNow != 0
    bool postShock = ctxValidNow and shockStateNow == 3
    bool trendUp = efficiency12 >= 0.42 and dispAtr12 >= 0.75 and buyerShareNow >= 0.58 and nz(flip12) < 0.45
    bool trendDn = efficiency12 >= 0.42 and dispAtr12 <= -0.75 and buyerShareNow <= 0.42 and nz(flip12) < 0.45
    bool rotation = auctionCodeNow == AUC_BALANCE or auctionCodeNow == AUC_CHOP or
         (efficiency12 <= 0.28 and nz(overlap12) >= 0.34 and nz(flip12) >= 0.34)
    bool quietClock = clockReadyNow and timeRelRangeNow < 0.80 and timeRelVolNow < 0.80
    bool quiet = (atrRatio < 0.80 or quietClock) and not trendUp and not trendDn
    bool hotTwoWay = atrRatio >= 1.30 and efficiency12 < 0.42 and
         (nz(flip12) >= 0.30 or nz(overlap12) >= 0.40)
    int raw =
         shockActive and shockDirNow > 0 ? REG_SHOCK_UP :
         shockActive and shockDirNow < 0 ? REG_SHOCK_DN :
         postShock ? REG_POST_SHOCK :
         hotTwoWay ? REG_HOT_TWO_WAY :
         trendUp ? REG_ORDERED_UP :
         trendDn ? REG_ORDERED_DN :
         rotation and quiet ? REG_QUIET_ROT :
         rotation ? REG_ACTIVE_ROT :
         REG_TRANSITION
    var int sticky = REG_TRANSITION
    var int candidate = REG_TRANSITION
    var int candidateBars = 0
    if not observe
        sticky := raw
        candidate := raw
        candidateBars := 0
    else if shockActive or postShock
        sticky := raw
        candidate := raw
        candidateBars := 0
    else if raw == sticky
        candidate := raw
        candidateBars := 0
    else
        if raw == candidate
            candidateBars += 1
        else
            candidate := raw
            candidateBars := 1
        if candidateBars >= 2
            sticky := candidate
            candidateBars := 0
    int codeNow = live ? sticky : raw
    int regimeThresholdBit = raw != sticky ? 64 : 0
    int regimeDiffBit = raw != sticky ? 64 : 0
    [efficiency12, dispAtr12, overlap12, flip12, atrRatio, vwapDistAtr, pocDistAtr,
     shockActive, trendUp, trendDn, rotation, codeNow, regimeThresholdBit, regimeDiffBit]

f_v28RegimeRouter(string routerMode, int regimeCodeNow,
     bool longFailedDownNow, bool shortFailedUpNow,
     bool longSupportDefenseNow, bool shortResistanceDefenseNow,
     bool longAcceptanceNow, bool shortAcceptanceNow,
     bool longDiscoveryNow, bool shortDiscoveryNow,
     bool freshLongNow, bool freshShortNow,
     bool longInitiativeNowArg, bool shortInitiativeNowArg,
     bool fpSellerAbsorbedNow, bool fpBuyerAbsorbedNow) =>
    bool longAllowed = true
    bool shortAllowed = true
    if routerMode == "LIVE"
        if regimeCodeNow == REG_ORDERED_UP
            longAllowed := true
            shortAllowed := shortFailedUpNow ? (freshShortNow or shortInitiativeNowArg) :
                 shortResistanceDefenseNow ? freshShortNow :
                 shortAcceptanceNow ? freshShortNow : false
        else if regimeCodeNow == REG_ORDERED_DN
            shortAllowed := true
            longAllowed := longFailedDownNow ? (freshLongNow or longInitiativeNowArg) :
                 longSupportDefenseNow ? freshLongNow :
                 longAcceptanceNow ? freshLongNow : false
        else if regimeCodeNow == REG_SHOCK_UP
            longAllowed := longAcceptanceNow or longDiscoveryNow or longFailedDownNow or longInitiativeNowArg
            shortAllowed := shortFailedUpNow and (freshShortNow or fpBuyerAbsorbedNow)
        else if regimeCodeNow == REG_SHOCK_DN
            shortAllowed := shortAcceptanceNow or shortDiscoveryNow or shortFailedUpNow or shortInitiativeNowArg
            longAllowed := longFailedDownNow and (freshLongNow or fpSellerAbsorbedNow)
        else if regimeCodeNow == REG_HOT_TWO_WAY
            longAllowed := longFailedDownNow or longAcceptanceNow or
                 ((longSupportDefenseNow or longDiscoveryNow) and freshLongNow)
            shortAllowed := shortFailedUpNow or shortAcceptanceNow or
                 ((shortResistanceDefenseNow or shortDiscoveryNow) and freshShortNow)
        else if regimeCodeNow == REG_QUIET_ROT
            longAllowed := longFailedDownNow or longSupportDefenseNow or
                 (longAcceptanceNow and freshLongNow) or
                 (longDiscoveryNow and freshLongNow)
            shortAllowed := shortFailedUpNow or shortResistanceDefenseNow or
                 (shortAcceptanceNow and freshShortNow) or
                 (shortDiscoveryNow and freshShortNow)
        else if regimeCodeNow == REG_ACTIVE_ROT
            longAllowed := longFailedDownNow or longSupportDefenseNow or longAcceptanceNow or
                 (longDiscoveryNow and freshLongNow)
            shortAllowed := shortFailedUpNow or shortResistanceDefenseNow or shortAcceptanceNow or
                 (shortDiscoveryNow and freshShortNow)
        else if regimeCodeNow == REG_POST_SHOCK
            longAllowed := longFailedDownNow or ((longAcceptanceNow or longDiscoveryNow or longSupportDefenseNow) and longInitiativeNowArg)
            shortAllowed := shortFailedUpNow or ((shortAcceptanceNow or shortDiscoveryNow or shortResistanceDefenseNow) and shortInitiativeNowArg)
    [longAllowed, shortAllowed]

// ─────────────────────────────────────────────────────────────────────────────
// TERRITORY
// We ask who is actually gaining and retaining price ground.
// ─────────────────────────────────────────────────────────────────────────────
float ch = close - close[1]
float upStep = math.max(ch, 0.0)
float dnStep = math.max(-ch, 0.0)
float upTravel = math.sum(upStep, territoryLen)
float dnTravel = math.sum(dnStep, territoryLen)
float totalTravel = upTravel + dnTravel
float netMove = close - close[territoryLen]
float territoryEfficiency = totalTravel > tick ? math.abs(netMove) / totalTravel : 0.0
float buyerTravelShare = totalTravel > tick ? upTravel / totalTravel : 0.5

float contextHi = ta.highest(high, contextLen)
float contextLo = ta.lowest(low, contextLen)
float contextRange = math.max(contextHi - contextLo, tick)
float rangePosition = (close - contextLo) / contextRange

// v0.28 anti-cliff territory + plateau telemetry are evaluated in a helper so
// the strategy main body stays below Pine's CE10295 size limit.
[upTerritory, dnTerritory, upHolding, dnHolding, territoryThresholdBits, territoryDiffBits] =
     f_v28Territory(netMove, atr, territoryMinAtr, buyerTravelShare, rangePosition, robustStateObserve, robustStateLive)

string territoryText = upTerritory ? "BUYERS GAINING" :
     dnTerritory ? "SELLERS GAINING" :
     upHolding ? "BUYERS HOLDING" :
     dnHolding ? "SELLERS HOLDING" : "CONTESTED"

// ─────────────────────────────────────────────────────────────────────────────
// EFFORT VS RESULT
// Volume/close-location are used as observable effort proxies. We are NOT
// claiming they reveal hidden intent or exact aggressor orders.
// ─────────────────────────────────────────────────────────────────────────────
float barRange = math.max(high - low, tick)
float closeLocation = ((close - low) - (high - close)) / barRange // -1..+1
float avgVol = ta.sma(volume, volLen)
float relVol = avgVol > 0 ? volume / avgVol : 1.0
bool shortParticipationReady = relVol >= shortParticipationMinRelVol
float signedEffort = closeLocation * relVol
float effort3 = ta.ema(signedEffort, 3)

float emaChange3 = ta.ema(close - close[1], 3)
float result3 = atr > tick ? emaChange3 / atr : 0.0
float highProgress3 = atr > tick ? math.max(high - high[3], 0.0) / atr : 0.0
float lowProgress3 = atr > tick ? math.max(low[3] - low, 0.0) / atr : 0.0

float buyerEffort = math.max(effort3, 0.0)
float sellerEffort = math.max(-effort3, 0.0)
float buyerResult = math.max(result3, 0.0) + highProgress3 * 0.35
float sellerResult = math.max(-result3, 0.0) + lowProgress3 * 0.35

f_effortText(float e) =>
    e >= 0.75 ? "HIGH" : e >= 0.30 ? "ACTIVE" : "LIGHT"

f_resultText(float r) =>
    r >= 0.40 ? "GOOD" : r >= 0.14 ? "SOME" : "POOR"

// v0.28 sticky effort/result, counterattack semantics and plateau telemetry are
// split out of the main body without changing the thresholds or state rules.
[buyerPoorResult, sellerPoorResult, buyerSponsored, sellerSponsored, sellerCounterWeak, buyerCounterWeak,
 effortThresholdBits, effortDiffBits] =
     f_v28EffortStates(buyerEffort, sellerEffort, buyerResult, sellerResult, upTravel, dnTravel, tick, robustStateObserve, robustStateLive)

string counterText = sellerCounterWeak ? "SELLER RESPONSE WEAK" :
     buyerCounterWeak ? "BUYER RESPONSE WEAK" : "TWO-WAY RESPONSE"

bool upsideAlreadyEstablished =
     upTerritory or
     (buyerResult >= 0.40 and buyerEffort >= 0.30)

bool downsideAlreadyEstablished =
     dnTerritory or
     (sellerResult >= 0.40 and sellerEffort >= 0.30)

// Reaction-level latch state must be declared before the zone-interaction reset logic below.

// ─────────────────────────────────────────────────────────────────────────────
// LOCATION / ZONE INTERACTION
// ─────────────────────────────────────────────────────────────────────────────
float nearDist = atr * zoneNearAtr

bool nearR = not na(busR1) and math.abs(close - busR1) <= nearDist
bool nearS = not na(busS1) and math.abs(close - busS1) <= nearDist
bool touchedR = not na(rLo) and high >= rLo and low <= rHi
bool touchedS = not na(sLo) and high >= sLo and low <= sHi


// Acceptance: two completed closes outside a meaningful band.
// v0.16 temporal-map correctness: each completed close is judged against the
// boundary that actually existed on THAT bar.  Comparing close[1] to today's
// moving zone can create synthetic acceptance when the map itself moved.
bool acceptedAboveR = useTemporalMapSemantics ?
     (not na(rHi) and not na(rHi[1]) and close > rHi and close[1] > rHi[1]) :
     (not na(rHi) and close > rHi and close[1] > rHi)
bool acceptedBelowS = useTemporalMapSemantics ?
     (not na(sLo) and not na(sLo[1]) and close < sLo and close[1] < sLo[1]) :
     (not na(sLo) and close < sLo and close[1] < sLo)

// Rejection / failed attempt: price trades through/into the area, then cannot
// retain that territory by the close.
bool rejectedAtR = not na(rLo) and high >= rLo and close < rLo and close < open
bool rejectedAtS = not na(sHi) and low <= sHi and close > sHi and close > open

bool sweptRFailed = not na(rHi) and high > rHi and close < rLo
bool sweptSFailed = not na(sLo) and low < sLo and close > sHi

bool balanceBreakUp = useTemporalMapSemantics ?
     (not na(busBalHi) and not na(busBalHi[1]) and close > busBalHi and close[1] <= busBalHi[1]) :
     (not na(busBalHi) and close > busBalHi and close[1] <= busBalHi)
bool balanceBreakDn = useTemporalMapSemantics ?
     (not na(busBalLo) and not na(busBalLo[1]) and close < busBalLo and close[1] >= busBalLo[1]) :
     (not na(busBalLo) and close < busBalLo and close[1] >= busBalLo)
bool balanceReclaimUp = not na(busBalLo) and low < busBalLo and close > busBalLo
bool balanceReclaimDn = not na(busBalHi) and high > busBalHi and close < busBalHi

// ─────────────────────────────────────────────────────────────────────────────
// THESIS PRIMITIVES
// Each thesis is built from an observable auction event, not a universal score.
// Several different reasons can make the same side plausible.
// ─────────────────────────────────────────────────────────────────────────────

// Long explanations
bool longDiscovery =
     auctionCode == AUC_EXP_UP and
     (upTerritory or upHolding) and
     not buyerPoorResult

bool longFailedDown =
     auctionCode == AUC_FAIL_DN or
     sweptSFailed or
     balanceReclaimUp

bool longSupportDefense =
     touchedS and
     (sState == Z_DEFENDED or sStrength >= 7) and
     (rejectedAtS or sellerPoorResult) and
     not dnTerritory

bool longAcceptance =
     acceptedAboveR and
     (buyerSponsored or upTerritory) and
     not sellerSponsored

// Short explanations
bool shortDiscovery =
     auctionCode == AUC_EXP_DN and
     (dnTerritory or dnHolding) and
     not sellerPoorResult

bool shortFailedUp =
     auctionCode == AUC_FAIL_UP or
     sweptRFailed or
     balanceReclaimDn

bool shortResistanceDefense =
     touchedR and
     (rState == Z_DEFENDED or rStrength >= 7) and
     (rejectedAtR or buyerPoorResult) and
     not upTerritory

bool shortAcceptance =
     acceptedBelowS and
     (sellerSponsored or dnTerritory) and
     not buyerSponsored

// v0.17 MOVE LIFECYCLE.
// A correct failed-auction thesis can still become a bad execution if the
// intended-side impulse has already done most of its work.  Maturity does NOT
// invalidate the thesis; it changes the next required evidence from
// "continuation now" to "pullback -> fresh response".
bool longMoveMatureNow =
     longFailedDown and
     sellerCounterWeak and
     upsideAlreadyEstablished and
     relVol >= shortMaturityRelVol

bool shortMoveMatureNow =
     shortFailedUp and
     buyerCounterWeak and
     downsideAlreadyEstablished and
     relVol >= shortMaturityRelVol

bool longMoveStallingNow =
     (upTerritory or upHolding) and rangePosition >= 0.72 and
     buyerPoorResult and sellerResult >= 0.14

bool shortMoveStallingNow =
     (dnTerritory or dnHolding) and rangePosition <= 0.28 and
     sellerPoorResult and buyerResult >= 0.14

// v0.3E CONTROL TRANSFER:
// A failed auction can validate a reversal thesis before control actually
// changes hands. In TRANSITION, do not commit while the old side is still
// gaining territory.
bool longReversalUnprovenNow =
     longFailedDown and
     auctionCode == AUC_TRANSITION and
     dnTerritory

bool shortReversalUnprovenNow =
     shortFailedUp and
     auctionCode == AUC_TRANSITION and
     upTerritory

// v0.3I SESSION RUNWAY:
// A FAILED-DOWN reversal close to the cash close can be directionally correct
// without having enough session runway to develop. Keep the thesis alive, but
// require actual upside proof during 12:00–12:45 PT before ARM.
bool lateFailedDownLong = longFailedDown and lateRthRunway

bool lateLongRunwayProof =
     auctionCode == AUC_EXP_UP or
     longAcceptance or
     (upTerritory and buyerResult >= 0.40 and not buyerPoorResult)

bool longSessionRunwayReady =
     not lateFailedDownLong or
     lateLongRunwayProof

// v0.19 hierarchy interpretation. A moderate opposing HTF auction is context,
// not an automatic veto. The important distinction is ACTIVE IMPULSE pressure:
// a large, efficient opposing HTF move near its extreme is still proving control
// until the lower timeframe demonstrates failure. 5m DISCOVERY against that
// impulse is therefore a counterattack, not yet proof that the larger auction
// transferred.
bool longDiscoveryHtfConflict = multiHtfValid and longHtfStory == HST_COUNTER_EXTENDED
bool shortDiscoveryHtfConflict = multiHtfValid and shortHtfStory == HST_COUNTER_EXTENDED
bool longDiscoverySupported = longDiscovery and not (worldModelLive and longDiscoveryHtfConflict)
bool shortDiscoverySupported = shortDiscovery and not (worldModelLive and shortDiscoveryHtfConflict)

bool bullSupported = longDiscoverySupported or longFailedDown or longSupportDefense or longAcceptance
bool bearSupported = shortDiscoverySupported or shortFailedUp or shortResistanceDefense or shortAcceptance

// v0.14 factual flow interpretation. This is NOT a universal vote; it asks
// whether aggressive flow actually migrated value/POC or was absorbed.
bool fpSellerAbsorbed = fpHas and fpSellerAbsorptionFact and
     (sellerPoorResult or rejectedAtS or sweptSFailed or closeLocation >= 0.20) and
     not dnTerritory
bool fpBuyerAbsorbed = fpHas and fpBuyerAbsorptionFact and
     (buyerPoorResult or rejectedAtR or sweptRFailed or closeLocation <= -0.20) and
     not upTerritory
bool fpLongSupport = fpHas and not fpBuyerAbsorbed and
     ((fpAggBuy and (fpPocUp or fpValueUp or fpBuyStacked or fpUpperDelta > 0)) or fpSellerAbsorbed)
bool fpShortSupport = fpHas and not fpSellerAbsorbed and
     ((fpAggSell and (fpPocDown or fpValueDown or fpSellStacked or fpLowerDelta < 0)) or fpBuyerAbsorbed)
bool fpLongContradiction = fpHas and fpAggSell and fpPocDown and
     (fpSellStacked or fpValueDown) and (dnTerritory or sellerSponsored)
bool fpShortContradiction = fpHas and fpAggBuy and fpPocUp and
     (fpBuyStacked or fpValueUp) and (upTerritory or buyerSponsored)

// SURVIVAL versus INITIATIVE. Failed auctions remain untouched because the
// full-history v0.13 audit says they are the core edge. The first live gate is
// intentionally narrow: PURE support/resistance defense only.
bool longDefenseOnlyCause = longSupportDefense and not longFailedDown and not longDiscoverySupported and not longAcceptance
bool shortDefenseOnlyCause = shortResistanceDefense and not shortFailedUp and not shortDiscoverySupported and not shortAcceptance
// v0.20 semantic consistency: if a local DISCOVERY is explicitly classified as
// unsupported against active HTF impulse pressure, it cannot simultaneously be
// used as "fresh initiative" to prove that same conflict. Acceptance and genuine
// territory/result initiative remain valid transfer evidence.
bool longStrongInitiativeNow =
     longDiscoverySupported or longAcceptance or
     (upTerritory and buyerResult >= 0.40 and buyerSponsored and not sellerSponsored)
bool shortStrongInitiativeNow =
     shortDiscoverySupported or shortAcceptance or
     (dnTerritory and sellerResult >= 0.40 and sellerSponsored and not buyerSponsored)

// v0.28 PRICE-only claim/proof state is evaluated in a persistent helper.
[longPriceOnlyInitiative, shortPriceOnlyInitiative, longPriceClaimProved, shortPriceClaimProved,
 longInitiativeNow, shortInitiativeNow, freshLongInitiativeEvent, freshShortInitiativeEvent] =
     f_v28Initiative(longStrongInitiativeNow, shortStrongInitiativeNow, fpLongSupport, fpShortSupport,
      longAcceptance, shortAcceptance, upTerritory, dnTerritory, buyerSponsored, sellerSponsored,
      initiativeConfirmObserve, initiativeConfirmLive)

// v0.26 row-level microstructure interpretation. These are causal facts, not a score.
bool edgeMicroAgainstLong = edgeStackObserve and microRowsValid and
     (microBottomSellAccept or (microTopSellPressure and microBottomSellPressure))
bool edgeMicroAgainstShort = edgeStackObserve and microRowsValid and
     (microTopBuyAccept or (microTopBuyPressure and microBottomBuyPressure))

// ─────────────────────────────────────────────────────────────────────────────
// v0.15 CAUSAL REGIME / ENVIRONMENT MODEL
//
// The point is NOT to say "2023 = bull" after the fact. Every state below is
// knowable on the current completed bar. It decomposes the environment into
// movement quality, rotation, volatility, shock/repricing and same-time activity.
// Broad thresholds intentionally reuse Bot1's auction references where possible:
// 0.42 directional efficiency for expansion, 0.28 for rotation, 0.34 flip/overlap.
// ─────────────────────────────────────────────────────────────────────────────
[regEfficiency12, regDispAtr12, regOverlap12, regFlip12, regAtrRatio, regVwapDistAtr, regPocDistAtr,
 regShockActive, regTrendUp, regTrendDn, regRotation, regimeCode, regimeThresholdBit, regimeDiffBit] =
     f_v28Regime(atr, tick, buyerTravelShare, auctionCode, clockReadyCtx, timeRelRangeCtx, timeRelVolCtx,
      ctxValid, shockStateCtx, shockDirCtx, sensorValid, busRthVwap, fpHas, fpPocMid, robustStateObserve, robustStateLive)
int thresholdStabilityCode = territoryThresholdBits + effortThresholdBits + regimeThresholdBit
int robustStateDiffCode = territoryDiffBits + effortDiffBits + regimeDiffBit

// Trade-family-aware router. This is deliberately NOT a generic trend filter.
// Responsive failed auctions remain eligible in many hostile environments. The
// router mainly attacks: counter-trend continuation, shock fading without proof,
// and vague defense/discovery participation in noisy two-way conditions.
[longRegimeAllowed, shortRegimeAllowed] =
     f_v28RegimeRouter(regimeRouterMode, regimeCode,
      longFailedDown, shortFailedUp, longSupportDefense, shortResistanceDefense,
      longAcceptance, shortAcceptance, longDiscovery, shortDiscovery,
      freshLongInitiativeEvent, freshShortInitiativeEvent, longInitiativeNow, shortInitiativeNow,
      fpSellerAbsorbed, fpBuyerAbsorbed)

// A side can be plausible before it is supported enough to ARM.
// WATCH is deliberately broad so the engine notices developing situations.
bool bullDeveloping =
     bullSupported or
     auctionCode == AUC_TEST_UP or
     (nearS and not sellerSponsored) or
     (upHolding and not nearR) or
     (auctionCode == AUC_TRANSITION and upTerritory)

bool bearDeveloping =
     bearSupported or
     auctionCode == AUC_TEST_DN or
     (nearR and not buyerSponsored) or
     (dnHolding and not nearS) or
     (auctionCode == AUC_TRANSITION and dnTerritory)

// Explicit contradiction. We do not require every fact to align, but we do
// reject a thesis when the market is actively proving its opposite.
bool bullContradicted =
     (acceptedBelowS and dnTerritory) or
     (auctionCode == AUC_EXP_DN and sellerSponsored and dnTerritory) or
     (nearR and sweptRFailed and bearSupported)

bool bearContradicted =
     (acceptedAboveR and upTerritory) or
     (auctionCode == AUC_EXP_UP and buyerSponsored and upTerritory) or
     (nearS and sweptSFailed and bullSupported)

// ─────────────────────────────────────────────────────────────────────────────
// v0.16 FAILED-AUCTION CONFLICT FACTS — GLOBAL / COMPLETED-BAR
//
// These are facts, not the state machine itself.  They are evaluated on EVERY
// completed bar so later episode logic can remember a conflict after the bar
// that created it has passed.  This avoids the v0.15 semantic bug where
// "conflict" could disappear simply because longFailedDown/shortFailedUp was
// no longer true on the next bar.
// ─────────────────────────────────────────────────────────────────────────────
bool v16ModerateUpGapConflict = ctxValid and gapCtx == 4

// BUS20 separates NQ leadership from actual relative weakness/opposition.
// For a FAILED-DOWN long, NQ-down while ES is neutral/up is meaningful relative
// weakness.  NQ-up while ES is merely neutral is leadership, not contradiction.
bool v16NqRelativeWeakLong = crossDetailValid ?
     (crossDetailCode == 4 or crossDetailCode == 6) :
     (clockCtxValid and (esContextCtx == 3 or esContextCtx == 4))

bool v16NqRelativeStrongAgainstShort = crossDetailValid ?
     (crossDetailCode == 3 or crossDetailCode == 5) :
     false

// v0.19 PRESSURE SEMANTICS: a failed auction fighting a STRONG/IMPULSIVE
// completed higher-timeframe auction is unresolved until the existing sequential
// proof state machine observes later control. v0.18 had this backwards by treating
// large displacement as if it implied exhaustion. A moderate opposing HTF trend
// does NOT automatically create this conflict.
bool v19HtfImpulseConflictLong = worldModelLive and longHtfStory == HST_COUNTER_EXTENDED
bool v19HtfImpulseConflictShort = worldModelLive and shortHtfStory == HST_COUNTER_EXTENDED

bool v16FailedDownConflictNow =
     enableFailedAuctionConfidence and longFailedDown and
     (v16ModerateUpGapConflict or v16NqRelativeWeakLong or v19HtfImpulseConflictLong)

bool v16FailedUpConflictNow =
     enableFailedAuctionConfidence and shortFailedUp and
     (v16ModerateUpGapConflict or v16NqRelativeStrongAgainstShort or v19HtfImpulseConflictShort)

bool v16LongStrongProgressNow =
     upTerritory and buyerResult >= 0.40 and not buyerPoorResult and
     not sellerSponsored

bool v16ShortStrongProgressNow =
     dnTerritory and sellerResult >= 0.40 and not sellerPoorResult and
     not buyerSponsored

// Kept only as the legacy A/B path.  Strict v0.16 proof is stateful below.
bool v16LegacyFreshLongProof =
     (longDiscovery and not longDiscovery[1]) or
     (longAcceptance and not longAcceptance[1]) or
     (longSupportDefense and not longSupportDefense[1]) or
     (v16LongStrongProgressNow and not v16LongStrongProgressNow[1])

bool v16LegacyFreshShortProof =
     (shortDiscovery and not shortDiscovery[1]) or
     (shortAcceptance and not shortAcceptance[1]) or
     (shortResistanceDefense and not shortResistanceDefense[1]) or
     (v16ShortStrongProgressNow and not v16ShortStrongProgressNow[1])

// ─────────────────────────────────────────────────────────────────────────────
// HUMAN-READABLE REASON
// ─────────────────────────────────────────────────────────────────────────────
string longReason =
     longFailedDown ? "FAILED DOWN / RECLAIM" :
     longAcceptance ? "BREAK + ACCEPTANCE" :
     longSupportDefense ? "SUPPORT DEFENSE" :
     longDiscoverySupported ? "UPWARD DISCOVERY" :
     bullDeveloping ? "UP MOVE DEVELOPING" : "NONE"

string shortReason =
     shortFailedUp ? "FAILED UP / REJECTION" :
     shortAcceptance ? "BREAKDOWN + ACCEPTANCE" :
     shortResistanceDefense ? "RESISTANCE DEFENSE" :
     shortDiscoverySupported ? "DOWNWARD DISCOVERY" :
     bearDeveloping ? "DOWN MOVE DEVELOPING" : "NONE"

string thesisText = bullSupported and not bearSupported ? "BULL EXPLANATION LEADING" :
     bearSupported and not bullSupported ? "BEAR EXPLANATION LEADING" :
     bullSupported and bearSupported ? "COMPETING EXPLANATIONS" :
     bullDeveloping and not bearDeveloping ? "BULL MOVE DEVELOPING" :
     bearDeveloping and not bullDeveloping ? "BEAR MOVE DEVELOPING" :
     bullDeveloping and bearDeveloping ? "BOTH SIDES ACTIVE" : "NO CLEAR ATTEMPT"

// ─────────────────────────────────────────────────────────────────────────────
// OPPONENT MODEL / FORCED-FLOW CONTEXT
// We infer where opposing participants may become vulnerable. We do not claim
// exact hidden stop locations or participant motives.
// ─────────────────────────────────────────────────────────────────────────────
string opponentText =
     acceptedAboveR ? "SHORT THESIS UNDER PRESSURE" :
     sweptRFailed ? "BREAKOUT LONGS VULNERABLE" :
     acceptedBelowS ? "LONG THESIS UNDER PRESSURE" :
     sweptSFailed ? "BREAKDOWN SHORTS VULNERABLE" :
     nearR ? "SHORTS MAY DEFEND R1 / BUY STOPS ABOVE" :
     nearS ? "LONGS MAY DEFEND S1 / SELL STOPS BELOW" :
     "NO IMMEDIATE FORCED-FLOW ZONE"

// ─────────────────────────────────────────────────────────────────────────────
// STRUCTURAL INVALIDATION + ROUTE
// Stop comes from the thesis geometry. Destination comes from Bot1's map.
// ─────────────────────────────────────────────────────────────────────────────
float recentLow = ta.lowest(low, 5)
float recentHigh = ta.highest(high, 5)

float longStop =
     longAcceptance and not na(rLo) ? rLo - stopBuf :
     (longSupportDefense or longFailedDown) and not na(sLo) ? math.min(sLo, recentLow) - stopBuf :
     recentLow - stopBuf

float shortStop =
     shortAcceptance and not na(sHi) ? sHi + stopBuf :
     (shortResistanceDefense or shortFailedUp) and not na(rHi) ? math.max(rHi, recentHigh) + stopBuf :
     recentHigh + stopBuf

// v0.16 execution-consistent route geometry.  ARM entries are STOP orders at
// high+tick / low-tick, so route and risk must be judged from that executable
// trigger — not from the signal bar close.  Otherwise a destination can appear
// to offer room at the close but sit behind the actual trigger.
float plannedLongTrigger = useExecutionConsistentRoute ? high + tick : close
float plannedShortTrigger = useExecutionConsistentRoute ? low - tick : close
float longRisk = math.max(plannedLongTrigger - longStop, tick)
float shortRisk = math.max(shortStop - plannedShortTrigger, tick)

// Nearest meaningful opposing destination that is still AHEAD of the trigger.
float longDest = not na(busR1) and busR1 > plannedLongTrigger ? busR1 :
     not na(busR2) and busR2 > plannedLongTrigger ? busR2 : na
float shortDest = not na(busS1) and busS1 < plannedShortTrigger ? busS1 :
     not na(busS2) and busS2 < plannedShortTrigger ? busS2 : na

float longRoomR = not na(longDest) ? math.max(0.0, (longDest - plannedLongTrigger) / longRisk) : na
float shortRoomR = not na(shortDest) ? math.max(0.0, (plannedShortTrigger - shortDest) / shortRisk) : na

bool longRouteUsable = na(longRoomR) or longRoomR >= routeMinimumR
bool shortRouteUsable = na(shortRoomR) or shortRoomR >= routeMinimumR

f_roomText(float r) =>
    na(r) ? "OPEN / MAP DEST MISSING" :
     r >= 1.50 ? str.tostring(r, "#.##") + "R CLEAR" :
     r >= 1.00 ? str.tostring(r, "#.##") + "R USABLE" :
     r >= routeMinimumR ? str.tostring(r, "#.##") + "R TIGHT" :
     str.tostring(r, "#.##") + "R BLOCKED"

// ─────────────────────────────────────────────────────────────────────────────
// CSV TRADE METADATA
// TradingView's Trades export carries the strategy entry comment in the
// Signal field. We freeze one compact snapshot when the thesis ARMS and keep
// that exact string on the pending entry until it either fills or is cancelled.
// This changes no trade logic.
// ─────────────────────────────────────────────────────────────────────────────
f_aucTag(int c) =>
    c == AUC_BALANCE ? "BAL" :
     c == AUC_BUILD ? "BLD" :
     c == AUC_TEST_UP ? "TUP" :
     c == AUC_TEST_DN ? "TDN" :
     c == AUC_FAIL_UP ? "FUP" :
     c == AUC_FAIL_DN ? "FDN" :
     c == AUC_EXP_UP ? "XUP" :
     c == AUC_EXP_DN ? "XDN" :
     c == AUC_CHOP ? "CHP" : "TRN"

f_reasonTag(string r) =>
    r == "FAILED DOWN / RECLAIM" ? "FAIL_DN" :
     r == "BREAK + ACCEPTANCE" ? "ACC_UP" :
     r == "SUPPORT DEFENSE" ? "SUP_DEF" :
     r == "UPWARD DISCOVERY" ? "DISC_UP" :
     r == "FAILED UP / REJECTION" ? "FAIL_UP" :
     r == "BREAKDOWN + ACCEPTANCE" ? "ACC_DN" :
     r == "RESISTANCE DEFENSE" ? "RES_DEF" :
     r == "DOWNWARD DISCOVERY" ? "DISC_DN" :
     r == "UP MOVE DEVELOPING" ? "DEV_UP" :
     r == "DOWN MOVE DEVELOPING" ? "DEV_DN" : "OTHER"

f_territoryTag() =>
    upTerritory ? "BG" :
     dnTerritory ? "SG" :
     upHolding ? "BH" :
     dnHolding ? "SH" : "CT"

f_effortTag(float e) =>
    e >= 0.75 ? "H" : e >= 0.30 ? "A" : "L"

f_resultTag(float r) =>
    r >= 0.40 ? "G" : r >= 0.14 ? "S" : "P"

f_counterTag() =>
    sellerCounterWeak ? "SW" :
     buyerCounterWeak ? "BW" : "TW"

f_oppTag() =>
    acceptedAboveR ? "SHORT_PRESS" :
     sweptRFailed ? "BRK_LONG_VULN" :
     acceptedBelowS ? "LONG_PRESS" :
     sweptSFailed ? "BRK_SHORT_VULN" :
     nearR ? "R1_DEF" :
     nearS ? "S1_DEF" : "NONE"

f_zoneTag(int st, int strength, int src) =>
    str.tostring(st) + "." + str.tostring(strength) + "." + str.tostring(src)

f_num(float x, string fmt) =>
    na(x) ? "NA" : str.tostring(x, fmt)

f_ctStateText(int st) =>
    st == CT_PROVEN ? "PROVEN" :
     st == CT_CHALLENGED ? "CHALLENGED" :
     st == CT_RECOVERING ? "RECOVERING" :
     st == CT_TRANSFER_BUILDING ? "TRANSFER BUILDING" : "UNPROVEN"

f_ctEventText(int ev) =>
    ev == CT_EVT_STRUCTURE ? "STRUCTURE" :
     ev == CT_EVT_FAILED_AUCTION ? "FAILED AUCTION" :
     ev == CT_EVT_DRIVE ? "DRIVE" :
     ev == CT_EVT_EFFORT_RESULT ? "EFFORT/RESULT" :
     ev == CT_EVT_RESPONSE ? "RESPONSE" :
     ev == CT_EVT_RECOVERY ? "RECOVERY" :
     ev == CT_EVT_RESPONSE_FAIL ? "RESPONSE FAIL" :
     ev == CT_EVT_ACCEPTANCE ? "ACCEPTANCE" :
     ev == CT_EVT_CONTINUATION ? "CONTINUATION" : "NONE"

f_ctEventTag(int ev) =>
    ev == CT_EVT_STRUCTURE ? "STRUCT" :
     ev == CT_EVT_FAILED_AUCTION ? "FAILAUC" :
     ev == CT_EVT_DRIVE ? "DRIVE" :
     ev == CT_EVT_EFFORT_RESULT ? "EFFRES" :
     ev == CT_EVT_RESPONSE ? "RESP" :
     ev == CT_EVT_RECOVERY ? "RECOV" :
     ev == CT_EVT_RESPONSE_FAIL ? "RESPFAIL" :
     ev == CT_EVT_ACCEPTANCE ? "ACCEPT" :
     ev == CT_EVT_CONTINUATION ? "CONT" : "NONE"

f_shockTag(int st) =>
    st == 1 ? "SHK" :
     st == 2 ? "RPR" :
     st == 3 ? "STB" : "NRM"

f_shockDirTag(int d) =>
    d > 0 ? "UP" : d < 0 ? "DN" : "NA"

f_rxTag(int rx) =>
    rx == 1 ? "FRESH" :
     rx == 2 ? "DEF1" :
     rx == 3 ? "STR" :
     rx == 4 ? "STB" :
     rx == 5 ? "WEAK" :
     rx == 6 ? "WORN" :
     rx == 7 ? "ACC_UP" :
     rx == 8 ? "ACC_DN" :
     rx == 9 ? "CONS" : "NA"

f_battleTag(int b) =>
    b == 1 ? "FRESH" :
     b == 2 ? "DEF1" :
     b == 3 ? "STR" :
     b == 4 ? "MIX" :
     b == 5 ? "WEAK" :
     b == 6 ? "2WAY" :
     b == 7 ? "ACC_UP" :
     b == 8 ? "ACC_DN" :
     b == 9 ? "CONS" : "NA"

f_openLocTag(int x) =>
    x == 1 ? "BELOW_ON" :
     x == 2 ? "ON_LOW" :
     x == 3 ? "ON_MID" :
     x == 4 ? "ON_HIGH" :
     x == 5 ? "ABOVE_ON" : "NA"

f_gapTag(int x) =>
    x == 1 ? "BIG_DN" :
     x == 2 ? "DN" :
     x == 3 ? "FLAT" :
     x == 4 ? "UP" :
     x == 5 ? "BIG_UP" : "NA"

f_openAuctionTag(int x) =>
    x == 1 ? "OPEN_IN" :
     x == 2 ? "OPEN_ABOVE" :
     x == 3 ? "OPEN_BELOW" :
     x == 4 ? "ABOVE_RECLAIM" :
     x == 5 ? "BELOW_RECLAIM" :
     x == 6 ? "IN_BREAK_UP" :
     x == 7 ? "IN_BREAK_DN" : "NA"

f_orTag(int x) =>
    x == 1 ? "BELOW" :
     x == 2 ? "INSIDE" :
     x == 3 ? "ABOVE" : "DEV"

f_dowTag(int d) =>
    d == 1 ? "MON" :
     d == 2 ? "TUE" :
     d == 3 ? "WED" :
     d == 4 ? "THU" :
     d == 5 ? "FRI" : "NA"

f_phaseTag(int slot) =>
    slot <= 0 ? "NA" :
     slot <= 12 ? "OPEN" :
     slot <= 48 ? "MID" : "LATE"

f_ptSlotTag(int slot) =>
    if slot <= 0
        "NA"
    else
        int totalMin = 390 + (slot - 1) * 5
        int hh = int(math.floor(totalMin / 60))
        int mm = totalMin % 60
        (hh < 10 ? "0" : "") + str.tostring(hh) + (mm < 10 ? "0" : "") + str.tostring(mm)

f_calendarTag(int c) =>
    c == 1 ? "ROLL" :
     c == 2 ? "EXP" : "NORMAL"

f_esTag(int c) =>
    c == 1 ? "UP_AGREE" :
     c == 2 ? "DN_AGREE" :
     c == 3 ? "NQ_UP_DVG" :
     c == 4 ? "NQ_DN_DVG" :
     c == 5 ? "MIX" : "NA"

f_vixLevelTag(int c) =>
    c == 1 ? "LOW" :
     c == 2 ? "NORMAL" :
     c == 3 ? "ELEV" : "NA"

f_vixMoveTag(int c) =>
    c == 1 ? "FAST_DN" :
     c == 2 ? "DN" :
     c == 3 ? "QUIET" :
     c == 4 ? "UP" :
     c == 5 ? "FAST_UP" : "NA"

f_crossDetailTag(int c) =>
    not crossDetailValid ? "NA" :
     c == 1 ? "UP_AGREE" :
     c == 2 ? "DN_AGREE" :
     c == 3 ? "NQ_UP_LEAD" :
     c == 4 ? "NQ_DN_LEAD" :
     c == 5 ? "NQ_UP_VS_ES_DN" :
     c == 6 ? "NQ_DN_VS_ES_UP" :
     c == 7 ? "ES_UP_LEAD" :
     c == 8 ? "ES_DN_LEAD" : "NEUTRAL"

f_htfStateTag(int st) =>
    st == HTF_ROTATION ? "ROT" :
     st == HTF_UP ? "UP" :
     st == HTF_DOWN ? "DN" :
     st == HTF_UP_EXTENDED ? "UPX" :
     st == HTF_DOWN_EXTENDED ? "DNX" :
     st == HTF_TRANSITION ? "TRN" : "NA"

f_htfStoryTag(int side) =>
    int st = side == SIDE_LONG ? longHtfStory : shortHtfStory
    st == HST_ALIGNED ? "ALIGN" :
     st == HST_PULLBACK ? "PULL" :
     st == HST_COUNTER_HEALTHY ? "CTR" :
     st == HST_COUNTER_EXTENDED ? "CTRI" :
     st == HST_NEUTRAL ? "NEUT" : "NA"

f_obstacleTag(int side) =>
    int st = side == SIDE_LONG ? rState : sState
    int src = side == SIDE_LONG ? rSource : sSource
    int rx = side == SIDE_LONG ? r1ReactionCtx : s1ReactionCtx
    bool missing = src == 0
    bool passed = side == SIDE_LONG ? rx == 7 : rx == 8
    bool worn = st == Z_WEAK or st == Z_CONSUMED or rx == 5 or rx == 6 or rx == 9
    bool defending = st == Z_DEFENDED or rx == 2 or rx == 3 or rx == 4
    bool higher = src == 3 or src == 4 or src == 5 or src == 6 or src == 9
    missing ? "OPEN" : passed ? "PASSED" : worn ? "WORN" : higher and defending ? "HTF_DEF" : defending ? "DEF" : "SOFT"

// Automated reaction/late-flow micro helpers removed.
f_leadLagTag(int c) =>
    c == 1 ? "UP_CATCH" :
     c == 2 ? "DN_CATCH" :
     c == 3 ? "UP_AGR" :
     c == 4 ? "DN_AGR" :
     c == 5 ? "NQ_UP_UNC" :
     c == 6 ? "NQ_DN_UNC" :
     c == 7 ? "ES_UP_LEAD" :
     c == 8 ? "ES_DN_LEAD" :
     c == 9 ? "MIX" :
     c == 10 ? "NEUT" : "NA"

f_modeTag(int m) =>
    m == OM_FAST ? "FAST" : m == OM_RUNNER ? "RUN" : m == OM_CORE ? "CORE" : "NA"

// ARM-time prior. This does NOT gate the trade. It asks what kind of payoff the
// current auction appears to offer if the existing ARM thesis triggers.
f_armOpportunityMode(int side, float executableRoomR) =>
    bool isLong = side == SIDE_LONG
    bool sameTerritory = isLong ? upTerritory : dnTerritory
    bool sameInitiative = isLong ? (buyerSponsored or longInitiativeNow or fpLongSupport) : (sellerSponsored or shortInitiativeNow or fpShortSupport)
    bool samePoorResult = isLong ? buyerPoorResult : sellerPoorResult
    bool oppSponsored = isLong ? sellerSponsored : buyerSponsored
    bool htfImpulseAgainst = isLong ? v19HtfImpulseConflictLong : v19HtfImpulseConflictShort
    int hst = isLong ? longHtfStory : shortHtfStory
    bool htfConstructive = hst == HST_ALIGNED or hst == HST_PULLBACK or hst == HST_NEUTRAL
    string ob = f_obstacleTag(side)
    bool hardObstacle = ob == "DEF" or ob == "HTF_DEF"
    bool openObstacle = ob == "OPEN" or ob == "WORN" or ob == "PASSED"
    bool expansionRegime = isLong ? (regimeCode == REG_ORDERED_UP or regimeCode == REG_SHOCK_UP or regimeCode == REG_POST_SHOCK) :
         (regimeCode == REG_ORDERED_DN or regimeCode == REG_SHOCK_DN or regimeCode == REG_POST_SHOCK)
    bool rotationalRegime = regimeCode == REG_QUIET_ROT or regimeCode == REG_ACTIVE_ROT or regimeCode == REG_HOT_TWO_WAY
    bool routeCanRun = na(executableRoomR) or executableRoomR >= targetR * 1.35
    bool routeSuggestsFast = not na(executableRoomR) and executableRoomR < targetR
    bool runnerPrior = routeCanRun and openObstacle and expansionRegime and sameTerritory and sameInitiative and htfConstructive and
         not samePoorResult and not oppSponsored and not htfImpulseAgainst
    bool fastPrior = not runnerPrior and sameInitiative and not htfImpulseAgainst and
         (routeSuggestsFast or hardObstacle or rotationalRegime)
    runnerPrior ? OM_RUNNER : fastPrior ? OM_FAST : OM_CORE

f_regimeTag(int r) =>
    r == REG_QUIET_ROT ? "QROT" :
     r == REG_ACTIVE_ROT ? "AROT" :
     r == REG_ORDERED_UP ? "TREND_UP" :
     r == REG_ORDERED_DN ? "TREND_DN" :
     r == REG_HOT_TWO_WAY ? "HOT_2WAY" :
     r == REG_SHOCK_UP ? "SHOCK_UP" :
     r == REG_SHOCK_DN ? "SHOCK_DN" :
     r == REG_POST_SHOCK ? "POST_SHOCK" :
     r == REG_TRANSITION ? "TRANS" : "UNK"

f_archetypeCode(string reason) =>
    str.contains(reason, "EXEC FAIL") ? ARC_RETRY :
     str.contains(reason, "FAILED DOWN") or str.contains(reason, "FAILED UP") ? ARC_FAILED_AUCTION :
     str.contains(reason, "DEFENSE") ? ARC_DEFENSE :
     str.contains(reason, "ACCEPTANCE") ? ARC_ACCEPTANCE :
     str.contains(reason, "DISCOVERY") ? ARC_DISCOVERY : ARC_UNKNOWN

f_archetypeTag(int a) =>
    a == ARC_FAILED_AUCTION ? "FAIL" :
     a == ARC_DEFENSE ? "DEF" :
     a == ARC_ACCEPTANCE ? "ACC" :
     a == ARC_DISCOVERY ? "DISC" :
     a == ARC_RETRY ? "RETRY" : "UNK"

// Research export/metadata helpers removed in clean trader build.
f_movePhaseTag(string sideTag) =>
    bool sideTrend = sideTag == "L" ? regTrendUp : regTrendDn
    bool oppTrend = sideTag == "L" ? regTrendDn : regTrendUp
    bool mature = sideTag == "L" ? longMoveMatureNow : shortMoveMatureNow
    bool stall = sideTag == "L" ? longMoveStallingNow : shortMoveStallingNow
    mature ? "MATURE" :
     stall ? "STALL" :
     regShockActive ? "SHOCK" :
     oppTrend ? "COUNTER" :
     sideTrend ? "DEVELOP" :
     regRotation ? "ROTATE" : "TRANS"

// ─────────────────────────────────────────────────────────────────────────────
// ACTION STATE MACHINE — persistent thesis episodes + strategy orders
// ─────────────────────────────────────────────────────────────────────────────

// Episode state:
// 0 none, +1 bull developing, -1 bear developing.
// Once an episode arms or trades, it cannot immediately re-arm the same idea
// after a cancellation. The side must disappear for episodeResetBars first.
var int episodeSide = SIDE_NONE
var int episodeStartBar = na
var int episodeQuietBars = 0
var bool episodeUsed = false
var string episodeReason = ""

// v0.19 EPISODE EVIDENCE MEMORY — telemetry-first causal memory.
// A human remembers that a failure, defense, discovery and initiative happened
// on different bars. The old entry snapshot CM only described the final bar.
// These variables remember FIRST occurrence inside the current thesis episode.
var int evidenceTrackedSide = SIDE_NONE
var int evidenceTrackedStart = na
var bool episodeSeenDiscovery = false
var bool episodeSeenFailure = false
var bool episodeSeenDefense = false
var bool episodeSeenAcceptance = false
var int episodeDiscoveryBar = na
var int episodeFailureBar = na
var int episodeDefenseBar = na
var int episodeAcceptanceBar = na
var int episodeInitiativeBar = na
var int episodeEvidenceMask = 0

// v0.17 symmetric move-lifecycle state.
// Once a mature failed-auction impulse is seen, the same-side thesis must show
// a meaningful pullback and then a fresh response before ARM.  This treats
// thesis correctness and execution timing as separate questions.
var bool longMaturityWait = false
var bool longPullbackSeen = false
var float longMaturityHigh = na
var int longMaturityBar = na

var bool shortMaturityWait = false
var bool shortPullbackSeen = false
var float shortMaturityLow = na
var int shortMaturityBar = na

// Failed-auction control-transfer state.
var bool longControlWait = false
var bool shortControlWait = false
var bool longControlRearm = false
var bool shortControlRearm = false

// v0.14 defense→initiative state. A defense can keep the thesis alive without
// granting immediate participation. A later fresh initiative can re-open ARM.
var bool longInitiativeWait = false
var bool shortInitiativeWait = false
var bool longInitiativeRearm = false
var bool shortInitiativeRearm = false
var int longInitiativeWaitBar = na
var int shortInitiativeWaitBar = na
var float longInitiativeAnchorHigh = na
var float shortInitiativeAnchorLow = na
var int initiativeShadowBlockedCount = 0
var int initiativeLiveBlockedCount = 0

// v0.16 failed-auction confidence state.  A conflict is an EPISODE memory, not
// a one-bar boolean.  Strict proof therefore means:
//   CONFLICT OBSERVED -> WAIT -> LATER FRESH INITIATIVE/RESULT -> RE-ARM.
var bool longConfidenceWait = false
var bool shortConfidenceWait = false
var bool longConfidenceRearm = false
var bool shortConfidenceRearm = false
var bool longConfidenceConflictSeen = false
var bool shortConfidenceConflictSeen = false
var int longConfidenceConflictBar = na
var int shortConfidenceConflictBar = na
var float longConfidenceConflictHigh = na
var float shortConfidenceConflictLow = na
// v0.20 conflict provenance + retained-proof memory.
var bool longConfidencePressureConflict = false
var bool shortConfidencePressureConflict = false
var bool longPressureFreshInitiativeSeen = false
var bool shortPressureFreshInitiativeSeen = false
var int longConfidenceProofBar = na
var int shortConfidenceProofBar = na
var int confidenceTrackedEpisodeStart = na
var int confidenceTrackedEpisodeSide = SIDE_NONE

// v0.14 local execution-timing state. One failed entry attempt may be exited
// while the broader episode survives, but any retry requires a NEW initiative.
var int executionRetrySide = SIDE_NONE
var bool executionRetryWait = false
var bool executionRetryRearm = false
var int executionRetryAfterBar = na
var int episodeExecutionRetryCount = 0
var int executionFailSignalCount = 0
var int executionFailExitCount = 0
var int executionRetryArmCount = 0

// Pending ARM order geometry.
var int pendingSide = SIDE_NONE
var float armTrigger = na
var float armInvalid = na
var float armTarget = na
var int armBar = na
var string armReason = ""
var int armRefreshCount = 0
var float armExecInvalid = na
var bool armDefenseOrigin = false
var bool armRetryOrigin = false
var int armOpportunityMode = OM_UNKNOWN
// v0.27 contract provenance. Reaction level boundaries are frozen at ARM so
// post-fill invalidation does not chase a moving zone.

// Active trade geometry, frozen from the thesis.
var float tradeEntry = na
var float tradeStop = na
var float tradeTarget = na
var int tradeEntryBar = na
var string tradeReason = ""
var float tradeExecInvalid = na
var bool tradeDefenseOrigin = false
var bool tradeRetryOrigin = false
var bool tradeExecFailSeen = false
var bool tradeContractWrongExecutionSeen = false

// PROP telemetry: did the trade prove itself before weakening?
// Research-only for v0.4. These values do NOT change exits yet.
var float tradeInitialRisk = na
var float tradeMfeR = na
var float tradeMaeR = na
var bool tradeProved05 = false
// v0.7 PROVEN CONTROL TRANSFER state. `tradeProof05Bar` prevents the same bar
// that first touches +0.50R from also starting a protection decision.
var int tradeProof05Bar = na
var float tradeCloseR = na
var float tradeGivebackR = na

// v0.23 SHADOW opportunity-mode telemetry. No order logic reads these fields.
var int tradeArmOpportunityMode = OM_UNKNOWN

// Legacy v0.6 correlated evidence remains TELEMETRY ONLY so A/B exports can
// show what the old vote would have seen. It no longer decides PROTECT.
var int tradeProtectEvidence = 0
var int tradeProtectCode = 0

// Sequential reasoning memory. One challenge event has one provenance family;
// correlated descriptors of that event do not get independent votes.
var int tradeControlState = CT_UNPROVEN
var int tradeControlEventId = 0
var int tradeControlLastEvent = CT_EVT_NONE
var int tradeControlChallengeCode = CT_EVT_NONE
var int tradeControlChallengeBar = na
var int tradeControlTransferBar = na
var float tradeControlChallengeOrigin = na
var float tradeControlChallengeExtreme = na
var bool tradeControlResponseSeen = false
var int tradeControlChallengeCount = 0
var int tradeControlRecoveryCount = 0
var int tradeControlProtectEvent = CT_EVT_NONE
var int tradeControlTransferPath = CT_PATH_NONE
var float tradeControlTransferExtreme = na

// ─────────────────────────────────────────────────────────────────────────────
// CLEAN TRADER RUNTIME STATE — research outcome audits removed.
var string lastExitText = "—"
var float lastExitPrice = na
var int lastExitSide = SIDE_NONE
var int lastExitBar = na
var int lastClosedSeen = 0

var string actionText = "WAIT"
var string internalNote = ""

// One-bar chart events used by trader markers/alerts.
bool eventArmLong = false
bool eventArmShort = false
bool eventEnterLong = false
bool eventEnterShort = false
bool eventExitTarget = false
bool eventStop = false
bool eventExitEarly = false
bool eventExitProtect = false
bool eventExitTime = false
bool eventExitExecFail = false
bool eventExitOther = false

// Detect actual broker-emulator fills.
bool newLongPosition = barstate.isconfirmed and strategy.position_size > 0 and strategy.position_size[1] <= 0
bool newShortPosition = barstate.isconfirmed and strategy.position_size < 0 and strategy.position_size[1] >= 0
bool newPosition = newLongPosition or newShortPosition

// ── On entry fill, freeze the actual fill plus the structural stop/target
// that were already defined causally at ARM time.
if newPosition
    tradeEntry := strategy.position_avg_price
    tradeStop := armInvalid
    tradeTarget := armTarget
    tradeEntryBar := bar_index
    tradeReason := armReason
    tradeExecInvalid := armExecInvalid
    tradeDefenseOrigin := armDefenseOrigin
    tradeRetryOrigin := armRetryOrigin
    tradeExecFailSeen := false
    tradeArmOpportunityMode := armOpportunityMode
    tradeContractWrongExecutionSeen := false

    tradeInitialRisk := newLongPosition ?
         math.max(tradeEntry - tradeStop, tick) :
         math.max(tradeStop - tradeEntry, tick)
    tradeMfeR := 0.0
    tradeMaeR := 0.0
    tradeProved05 := false
    tradeProof05Bar := na
    tradeCloseR := 0.0
    tradeGivebackR := 0.0
    tradeProtectEvidence := 0
    tradeProtectCode := 0
    tradeControlState := CT_UNPROVEN
    tradeControlEventId := 0
    tradeControlLastEvent := CT_EVT_NONE
    tradeControlChallengeCode := CT_EVT_NONE
    tradeControlChallengeBar := na
    tradeControlTransferBar := na
    tradeControlChallengeOrigin := na
    tradeControlChallengeExtreme := na
    tradeControlResponseSeen := false
    tradeControlChallengeCount := 0
    tradeControlRecoveryCount := 0
    tradeControlProtectEvent := CT_EVT_NONE
    tradeControlTransferPath := CT_PATH_NONE
    tradeControlTransferExtreme := na

    eventEnterLong := newLongPosition
    eventEnterShort := newShortPosition
    actionText := newLongPosition ? "ENTER LONG" : "ENTER SHORT"

    // Pending order is now a live trade.
    pendingSide := SIDE_NONE
    armTrigger := na
    armTarget := na
    armBar := na
    armRefreshCount := 0
    armExecInvalid := na
    armDefenseOrigin := false
    armRetryOrigin := false

// ── Maintain protective brackets.
// When an ARM exists, its bracket is submitted alongside the stop-entry order.
// That means the structural stop and target are already in the broker emulator
// before an intrabar entry can fill; we do NOT need calc_on_order_fills.
if pendingSide == SIDE_LONG and not na(armInvalid) and not na(armTarget)
    strategy.exit("L-X", from_entry="L", stop=armInvalid, limit=armTarget,
         comment_profit="TARGET", comment_loss="STOP",
         alert_profit="BOT2 LONG TARGET HIT", alert_loss="BOT2 LONG STOP HIT")

if pendingSide == SIDE_SHORT and not na(armInvalid) and not na(armTarget)
    strategy.exit("S-X", from_entry="S", stop=armInvalid, limit=armTarget,
         comment_profit="TARGET", comment_loss="STOP",
         alert_profit="BOT2 SHORT TARGET HIT", alert_loss="BOT2 SHORT STOP HIT")

// ── PROP SHIELD daily accounting.
// `time("1D", ..., TRADE_TZ)` supplies one stable timestamp per Pacific day.
int currentPropDayStamp = time("1D", "0000-2359:1234567", TRADE_TZ)
bool newPropDay =
     not na(currentPropDayStamp) and
     (na(propDayStamp) or currentPropDayStamp != propDayStamp)

if newPropDay
    propDayStamp := currentPropDayStamp
    propDailyRealizedR := 0.0
    propDailyStops := 0
    propShieldActive := false

// Pre-process the newest completed trade for the daily governor.
// This runs before entry reasoning, so a STOP can prevent a new ARM immediately.
if barstate.isconfirmed and strategy.closedtrades > lastShieldClosedSeen
    int shieldIdx = strategy.closedtrades - 1
    string shieldExitComment = strategy.closedtrades.exit_comment(shieldIdx)
    float shieldExitPrice = strategy.closedtrades.exit_price(shieldIdx)
    string shieldEntryId = strategy.closedtrades.entry_id(shieldIdx)

    float resolvedR = 0.0
    if not na(tradeInitialRisk) and tradeInitialRisk > 0 and not na(tradeEntry)
        resolvedR := shieldEntryId == "L" ?
             (shieldExitPrice - tradeEntry) / tradeInitialRisk :
             (tradeEntry - shieldExitPrice) / tradeInitialRisk

    propDailyRealizedR += resolvedR

    if str.startswith(shieldExitComment, "STOP")
        propDailyStops += 1

        // Only a TRUE structural stop can activate the shield.
        // If the day still has no positive R cushion after that stop, stop
        // executing and continue in shadow/reasoning mode until tomorrow.
        if propDailyRealizedR <= 0.0
            propShieldActive := true
            strategy.cancel_all()

    lastShieldClosedSeen := strategy.closedtrades

// ── Reasoning / episode updates.
// v0.27.2 compile architecture: flatten the mutually-exclusive router into
// guarded top-level blocks. This preserves branch priority while avoiding one
// giant Pine if/else statement and the CE10205/CE10013 parser edge cases.
bool canReasonThisBar = barstate.isconfirmed and not newPosition
bool runFlatReasoning = false
bool reasoningHandled = false

if canReasonThisBar
    internalNote := ""

// 0A) Pre-blackout hard stop.
if canReasonThisBar and not reasoningHandled and preBlackoutBar
    strategy.cancel_all()
    if strategy.position_size != 0
        strategy.close_all(comment="TIME", alert_message="EXIT TIME BLOCK")

    pendingSide := SIDE_NONE
    armTrigger := na
    armInvalid := na
    armTarget := na
    armBar := na
    armReason := ""
    armOpportunityMode := OM_UNKNOWN
    armRefreshCount := 0

    episodeSide := SIDE_NONE
    episodeStartBar := na
    episodeQuietBars := 0
    episodeUsed := false
    episodeReason := ""
    longMaturityWait := false
    longPullbackSeen := false
    longMaturityHigh := na
    longMaturityBar := na
    shortMaturityWait := false
    shortPullbackSeen := false
    shortMaturityLow := na
    shortMaturityBar := na
    longControlWait := false
    shortControlWait := false
    longControlRearm := false
    shortControlRearm := false
    longInitiativeWait := false
    shortInitiativeWait := false
    longInitiativeRearm := false
    shortInitiativeRearm := false
    longInitiativeWaitBar := na
    shortInitiativeWaitBar := na
    executionRetrySide := SIDE_NONE
    executionRetryWait := false
    executionRetryRearm := false
    executionRetryAfterBar := na
    episodeExecutionRetryCount := 0
    armExecInvalid := na
    armDefenseOrigin := false
    armRetryOrigin := false

    actionText := strategy.position_size != 0 ? "EXIT TIME BLOCK" : "NO TRADE 00–04 PT"
    internalNote := "MIDNIGHT–4AM PACIFIC HARD BLOCK"

    reasoningHandled := true

// 0B) Blackout window.
if canReasonThisBar and not reasoningHandled and noTradeWindow
    strategy.cancel_all()
    if strategy.position_size != 0
        strategy.close_all(comment="TIME", alert_message="EXIT TIME BLOCK")

    pendingSide := SIDE_NONE
    armTrigger := na
    armInvalid := na
    armTarget := na
    armBar := na
    armReason := ""
    armOpportunityMode := OM_UNKNOWN
    armRefreshCount := 0

    episodeSide := SIDE_NONE
    episodeStartBar := na
    episodeQuietBars := 0
    episodeUsed := false
    episodeReason := ""
    longMaturityWait := false
    longPullbackSeen := false
    longMaturityHigh := na
    longMaturityBar := na
    shortMaturityWait := false
    shortPullbackSeen := false
    shortMaturityLow := na
    shortMaturityBar := na
    longControlWait := false
    shortControlWait := false
    longControlRearm := false
    shortControlRearm := false
    longInitiativeWait := false
    shortInitiativeWait := false
    longInitiativeRearm := false
    shortInitiativeRearm := false
    longInitiativeWaitBar := na
    shortInitiativeWaitBar := na
    executionRetrySide := SIDE_NONE
    executionRetryWait := false
    executionRetryRearm := false
    executionRetryAfterBar := na
    episodeExecutionRetryCount := 0
    armExecInvalid := na
    armDefenseOrigin := false
    armRetryOrigin := false

    actionText := "NO TRADE 00–04 PT"
    internalNote := "MIDNIGHT–4AM PACIFIC HARD BLOCK"

// SESSION TRANSITIONS — flat only.
// Cancel any pending trigger BEFORE the transition begins and reset the
// episode so the next tradable bar reasons from the new auction instead of
// carrying a pre-open/pre-close story through it.
    reasoningHandled := true

// 0C) Session transition while flat.
if canReasonThisBar and not reasoningHandled and (sessionTransitionWindow or sessionTransitionBoundary) and strategy.position_size == 0
    strategy.cancel_all()

    pendingSide := SIDE_NONE
    armTrigger := na
    armInvalid := na
    armTarget := na
    armBar := na
    armReason := ""
    armOpportunityMode := OM_UNKNOWN
    armRefreshCount := 0

    episodeSide := SIDE_NONE
    episodeStartBar := na
    episodeQuietBars := 0
    episodeUsed := false
    episodeReason := ""

    longMaturityWait := false
    longPullbackSeen := false
    longMaturityHigh := na
    longMaturityBar := na
    shortMaturityWait := false
    shortPullbackSeen := false
    shortMaturityLow := na
    shortMaturityBar := na
    longControlWait := false
    shortControlWait := false
    longControlRearm := false
    shortControlRearm := false
    longInitiativeWait := false
    shortInitiativeWait := false
    longInitiativeRearm := false
    shortInitiativeRearm := false
    longInitiativeWaitBar := na
    shortInitiativeWaitBar := na
    executionRetrySide := SIDE_NONE
    executionRetryWait := false
    executionRetryRearm := false
    executionRetryAfterBar := na
    episodeExecutionRetryCount := 0
    armExecInvalid := na
    armDefenseOrigin := false
    armRetryOrigin := false

    if preRthTransition or preRthBoundaryBar
        actionText := "WAIT — RTH OPEN TRANSITION"
    else
        actionText := "WAIT — CASH CLOSE TRANSITION"
    internalNote := "SESSION BOUNDARY · REBUILD REASONING AFTER TRANSITION"

// 1) Manage open trade. Early exit only on explicit thesis failure.
    reasoningHandled := true

// 1) Manage open trade.
if canReasonThisBar and not reasoningHandled and strategy.position_size != 0
    // PROP research telemetry while the trade is live.
    // This is causal and does not modify the position.
    if not na(tradeInitialRisk) and tradeInitialRisk > 0
        float liveFavR = strategy.position_size > 0 ?
             (high - tradeEntry) / tradeInitialRisk :
             (tradeEntry - low) / tradeInitialRisk
        float liveAdvR = strategy.position_size > 0 ?
             (tradeEntry - low) / tradeInitialRisk :
             (high - tradeEntry) / tradeInitialRisk

        tradeMfeR := na(tradeMfeR) ? math.max(liveFavR, 0.0) : math.max(tradeMfeR, liveFavR)
        tradeMaeR := na(tradeMaeR) ? math.max(liveAdvR, 0.0) : math.max(tradeMaeR, liveAdvR)
        bool newlyProved05 = not tradeProved05 and tradeMfeR >= PROVEN_R
        tradeProved05 := tradeProved05 or tradeMfeR >= PROVEN_R
        if newlyProved05
            tradeProof05Bar := bar_index
            tradeControlState := CT_PROVEN
            tradeControlLastEvent := CT_EVT_NONE

        tradeCloseR := strategy.position_size > 0 ?
             (close - tradeEntry) / tradeInitialRisk :
             (tradeEntry - close) / tradeInitialRisk
        tradeGivebackR := math.max(0.0, tradeMfeR - tradeCloseR)

        // Existing protective bracket, refreshed after the checkpoint so the
        // next-bar exit comment carries the newest SHADOW telemetry. Prices
        // are unchanged from the frozen ARM stop/target.
        if strategy.position_size > 0 and not na(tradeStop) and not na(tradeTarget)
            strategy.exit("L-X", from_entry="L", stop=tradeStop, limit=tradeTarget,
                 comment_profit="TARGET", comment_loss="STOP",
                 alert_profit="BOT2 LONG TARGET HIT", alert_loss="BOT2 LONG STOP HIT")
        else if strategy.position_size < 0 and not na(tradeStop) and not na(tradeTarget)
            strategy.exit("S-X", from_entry="S", stop=tradeStop, limit=tradeTarget,
                 comment_profit="TARGET", comment_loss="STOP",
                 alert_profit="BOT2 SHORT TARGET HIT", alert_loss="BOT2 SHORT STOP HIT")

    int heldBars = na(tradeEntryBar) ? 0 : bar_index - tradeEntryBar

    // ---------------------------------------------------------------------
    // v0.7 PROVEN CONTROL TRANSFER
    // ---------------------------------------------------------------------
    // Keep the old v0.6 descriptors as telemetry, but do NOT count them as
    // independent proof. They can all describe one underlying adverse drive.
    bool longProtectTerritory = strategy.position_size > 0 and dnTerritory
    bool longProtectEffort = strategy.position_size > 0 and (sellerSponsored or (buyerPoorResult and sellerResult >= 0.14))
    bool longProtectCounter = strategy.position_size > 0 and buyerCounterWeak
    bool longProtectAuction = strategy.position_size > 0 and (auctionCode == AUC_FAIL_UP or auctionCode == AUC_EXP_DN)
    bool longProtectContradiction = strategy.position_size > 0 and bullContradicted

    bool shortProtectTerritory = strategy.position_size < 0 and upTerritory
    bool shortProtectEffort = strategy.position_size < 0 and (buyerSponsored or (sellerPoorResult and buyerResult >= 0.14))
    bool shortProtectCounter = strategy.position_size < 0 and sellerCounterWeak
    bool shortProtectAuction = strategy.position_size < 0 and (auctionCode == AUC_FAIL_DN or auctionCode == AUC_EXP_UP)
    bool shortProtectContradiction = strategy.position_size < 0 and bearContradicted

    tradeProtectEvidence := strategy.position_size > 0 ?
         (longProtectTerritory ? 1 : 0) +
         (longProtectEffort ? 1 : 0) +
         (longProtectCounter ? 1 : 0) +
         (longProtectAuction ? 1 : 0) +
         (longProtectContradiction ? 1 : 0) :
         (shortProtectTerritory ? 1 : 0) +
         (shortProtectEffort ? 1 : 0) +
         (shortProtectCounter ? 1 : 0) +
         (shortProtectAuction ? 1 : 0) +
         (shortProtectContradiction ? 1 : 0)

    tradeProtectCode := strategy.position_size > 0 ?
         (longProtectTerritory ? 1 : 0) +
         (longProtectEffort ? 2 : 0) +
         (longProtectCounter ? 4 : 0) +
         (longProtectAuction ? 8 : 0) +
         (longProtectContradiction ? 16 : 0) :
         (shortProtectTerritory ? 1 : 0) +
         (shortProtectEffort ? 2 : 0) +
         (shortProtectCounter ? 4 : 0) +
         (shortProtectAuction ? 8 : 0) +
         (shortProtectContradiction ? 16 : 0)

    bool proofWasEstablished = tradeProved05 and not na(tradeProof05Bar) and bar_index > tradeProof05Bar
    bool meaningfulGiveback = not na(tradeGivebackR) and tradeGivebackR >= PROTECT_GIVEBACK_R

    // Existing v0.6 hard-thesis failure logic is frozen. PROTECT is reserved
    // for the nuanced middle ground; if the thesis is already explicitly
    // failed, EARLY remains the correct semantic exit.
    bool longFailure =
         strategy.position_size > 0 and
         heldBars >= minEarlyBars and
         ((bullContradicted and (dnTerritory or sellerSponsored)) or
          (auctionCode == AUC_FAIL_UP and dnTerritory) or
          (buyerPoorResult and sellerSponsored and close < tradeEntry))

    bool shortFailure =
         strategy.position_size < 0 and
         heldBars >= minEarlyBars and
         ((bearContradicted and (upTerritory or buyerSponsored)) or
          (auctionCode == AUC_FAIL_DN and upTerritory) or
          (sellerPoorResult and buyerSponsored and close > tradeEntry))

    // v0.14 LOCAL EXECUTION INVALIDATION
    // A completed bar can invalidate the ENTRY ATTEMPT without claiming the
    // larger thesis is wrong. This only operates before +0.50R proof and
    // only when the signal-bar local structure is lost with opposing result.
    bool execScopeEligible = executionTimingScope == "ALL ENTRIES" or tradeDefenseOrigin or tradeRetryOrigin
    bool execWindowReady = heldBars >= execFailMinBars and heldBars <= execFailMaxBars
    bool execNoLaunch = not tradeProved05 and not na(tradeMfeR) and tradeMfeR < execFailMaxMfeR
    bool longExecLocalBreak = strategy.position_size > 0 and not na(tradeExecInvalid) and close < tradeExecInvalid
    bool shortExecLocalBreak = strategy.position_size < 0 and not na(tradeExecInvalid) and close > tradeExecInvalid
    bool longExecOpposingResponse = strategy.position_size > 0 and
         (dnTerritory or sellerSponsored or buyerPoorResult or auctionCode == AUC_FAIL_UP or fpLongContradiction)
    bool shortExecOpposingResponse = strategy.position_size < 0 and
         (upTerritory or buyerSponsored or sellerPoorResult or auctionCode == AUC_FAIL_DN or fpShortContradiction)
    bool longBroaderThesisAlive = strategy.position_size > 0 and bullDeveloping and not bullContradicted
    bool shortBroaderThesisAlive = strategy.position_size < 0 and bearDeveloping and not bearContradicted
    // v0.26 FAILURE-TO-LAUNCH 2.0. Weak progress alone is insufficient:
    // adverse micro/cross-market response must appear while the broader thesis lives.
    bool edgeFtlWindow = heldBars >= edgeFtlMinBars and heldBars <= edgeFtlMaxBars and
         not na(tradeMfeR) and tradeMfeR < edgeFtlMaxMfeR and not na(tradeCloseR) and tradeCloseR <= edgeFtlMaxCloseR
    bool edgeLongAdverse = strategy.position_size > 0 and
         (edgeMicroAgainstLong or leadLagAgainstLong or
          (not microRowsValid and buyerPoorResult and sellerSponsored)) and
         (not longInitiativeNow or buyerPoorResult) and
         (dnTerritory or sellerSponsored or close < open)
    bool edgeShortAdverse = strategy.position_size < 0 and
         (edgeMicroAgainstShort or leadLagAgainstShort or
          (not microRowsValid and sellerPoorResult and buyerSponsored)) and
         (not shortInitiativeNow or sellerPoorResult) and
         (upTerritory or buyerSponsored or close > open)
    bool edgeFtlSignal = edgeStackObserve and edgeUseFailureLaunch and edgeFtlWindow and
         ((edgeLongAdverse and longBroaderThesisAlive) or (edgeShortAdverse and shortBroaderThesisAlive))
    // v0.27 thesis contract: the 1–4 bar no-launch clock is only coherent for
    // opportunities classified FAST before entry. CORE/RUN keep observing
    // the signal but are not force-exited by this clock.
    bool contractFastFtlSignal = thesisContractObserve and fastContractFtlObserve and tradeArmOpportunityMode == OM_FAST and edgeFtlSignal
    if contractFastFtlSignal and not tradeContractWrongExecutionSeen
        tradeContractWrongExecutionSeen := true

    bool legacyExecutionFailureSignal =
         executionTimingMode != "OFF" and execScopeEligible and execWindowReady and execNoLaunch and
         ((longExecLocalBreak and longExecOpposingResponse and longBroaderThesisAlive) or
          (shortExecLocalBreak and shortExecOpposingResponse and shortBroaderThesisAlive))
    bool contractFastFtlExitSignal = thesisContractLive and fastContractFtlLive and contractFastFtlSignal
    bool executionFailureSignal = legacyExecutionFailureSignal or contractFastFtlExitSignal

    if executionFailureSignal and not tradeExecFailSeen
        executionFailSignalCount += 1
        tradeExecFailSeen := true

    // ---- Event provenance: choose ONE primary family for the current
    // adverse event. Several true descriptors can still map to one event.
    bool longChallengeStructure = strategy.position_size > 0 and acceptedBelowS
    bool longChallengeFailedAuction = strategy.position_size > 0 and auctionCode == AUC_FAIL_UP
    bool longChallengeDrive = strategy.position_size > 0 and dnTerritory and (sellerSponsored or sellerResult >= 0.40)
    bool longChallengeEffortResult = strategy.position_size > 0 and buyerPoorResult and sellerResult >= 0.14 and close < close[1]

    bool shortChallengeStructure = strategy.position_size < 0 and acceptedAboveR
    bool shortChallengeFailedAuction = strategy.position_size < 0 and auctionCode == AUC_FAIL_DN
    bool shortChallengeDrive = strategy.position_size < 0 and upTerritory and (buyerSponsored or buyerResult >= 0.40)
    bool shortChallengeEffortResult = strategy.position_size < 0 and sellerPoorResult and buyerResult >= 0.14 and close > close[1]

    int adverseEventCode = strategy.position_size > 0 ?
         (longChallengeStructure ? CT_EVT_STRUCTURE :
          longChallengeFailedAuction ? CT_EVT_FAILED_AUCTION :
          longChallengeDrive ? CT_EVT_DRIVE :
          longChallengeEffortResult ? CT_EVT_EFFORT_RESULT : CT_EVT_NONE) :
         (shortChallengeStructure ? CT_EVT_STRUCTURE :
          shortChallengeFailedAuction ? CT_EVT_FAILED_AUCTION :
          shortChallengeDrive ? CT_EVT_DRIVE :
          shortChallengeEffortResult ? CT_EVT_EFFORT_RESULT : CT_EVT_NONE)

    bool adverseEvent = adverseEventCode != CT_EVT_NONE

    // ---- Original-side response. A response is a genuinely NEW event
    // after the challenge, not another descriptor of the challenge itself.
    bool longResponseEvent = strategy.position_size > 0 and
         ((upTerritory and buyerResult >= 0.18) or
          (buyerSponsored and not dnTerritory) or
          auctionCode == AUC_FAIL_DN or sweptSFailed or balanceReclaimUp or rejectedAtS)

    bool shortResponseEvent = strategy.position_size < 0 and
         ((dnTerritory and sellerResult >= 0.18) or
          (sellerSponsored and not upTerritory) or
          auctionCode == AUC_FAIL_UP or sweptRFailed or balanceReclaimDn or rejectedAtR)

    bool longReclaimedOrigin = strategy.position_size > 0 and not na(tradeControlChallengeOrigin) and close >= tradeControlChallengeOrigin
    bool shortReclaimedOrigin = strategy.position_size < 0 and not na(tradeControlChallengeOrigin) and close <= tradeControlChallengeOrigin

    bool longRecoveryConfirmed = longResponseEvent and
         (longReclaimedOrigin or auctionCode == AUC_FAIL_DN or sweptSFailed or balanceReclaimUp or
          (upTerritory and buyerResult >= 0.40))

    bool shortRecoveryConfirmed = shortResponseEvent and
         (shortReclaimedOrigin or auctionCode == AUC_FAIL_UP or sweptRFailed or balanceReclaimDn or
          (dnTerritory and sellerResult >= 0.40))

    bool recoveryConfirmed = strategy.position_size > 0 ? longRecoveryConfirmed : shortRecoveryConfirmed
    bool responseEvent = strategy.position_size > 0 ? longResponseEvent : shortResponseEvent

    // Retention means the opponent did not merely print one adverse bar;
    // the market remains on the opponent's side of the pre-challenge close.
    bool longOpponentRetains = strategy.position_size > 0 and not na(tradeControlChallengeOrigin) and
         close < tradeControlChallengeOrigin and
         (dnTerritory or dnHolding or sellerSponsored) and not longRecoveryConfirmed

    bool shortOpponentRetains = strategy.position_size < 0 and not na(tradeControlChallengeOrigin) and
         close > tradeControlChallengeOrigin and
         (upTerritory or upHolding or buyerSponsored) and not shortRecoveryConfirmed

    bool opponentRetains = strategy.position_size > 0 ? longOpponentRetains : shortOpponentRetains

    // A response can fail only AFTER Bot2 has already observed a response.
    bool longResponseFailure = strategy.position_size > 0 and tradeControlState == CT_RECOVERING and
         not na(tradeControlChallengeOrigin) and close < tradeControlChallengeOrigin and
         (dnTerritory or sellerSponsored or auctionCode == AUC_EXP_DN) and not longRecoveryConfirmed

    bool shortResponseFailure = strategy.position_size < 0 and tradeControlState == CT_RECOVERING and
         not na(tradeControlChallengeOrigin) and close > tradeControlChallengeOrigin and
         (upTerritory or buyerSponsored or auctionCode == AUC_EXP_UP) and not shortRecoveryConfirmed

    bool responseFailure = strategy.position_size > 0 ? longResponseFailure : shortResponseFailure

    // Acceptance is intentionally relative to the challenge origin as well
    // as Bot1 structure. Two completed closes retaining the adverse gain is
    // materially different from a one-bar excursion.
    // Split the two acceptance concepts for telemetry only:
    // 1) actual Bot1 structural acceptance through S1/R1
    // 2) persistence beyond the pre-challenge close ("origin hold")
    // The combined adverseAcceptance expression is unchanged.
    bool longStructuralAcceptance = strategy.position_size > 0 and acceptedBelowS
    bool shortStructuralAcceptance = strategy.position_size < 0 and acceptedAboveR

    bool longOriginAcceptance = strategy.position_size > 0 and not na(tradeControlChallengeOrigin) and
         close < tradeControlChallengeOrigin and close[1] < tradeControlChallengeOrigin and
         (dnTerritory or dnHolding or sellerSponsored)

    bool shortOriginAcceptance = strategy.position_size < 0 and not na(tradeControlChallengeOrigin) and
         close > tradeControlChallengeOrigin and close[1] > tradeControlChallengeOrigin and
         (upTerritory or upHolding or buyerSponsored)

    bool longAdverseAcceptance = strategy.position_size > 0 and not na(tradeControlChallengeOrigin) and
         (longStructuralAcceptance or longOriginAcceptance)

    bool shortAdverseAcceptance = strategy.position_size < 0 and not na(tradeControlChallengeOrigin) and
         (shortStructuralAcceptance or shortOriginAcceptance)

    bool adverseStructuralAcceptance = strategy.position_size > 0 ? longStructuralAcceptance : shortStructuralAcceptance
    bool adverseOriginAcceptance = strategy.position_size > 0 ? longOriginAcceptance : shortOriginAcceptance
    bool adverseAcceptance = strategy.position_size > 0 ? longAdverseAcceptance : shortAdverseAcceptance

    bool longAdverseContinuation = strategy.position_size > 0 and longOpponentRetains and
         (sellerSponsored or auctionCode == AUC_EXP_DN)
    bool shortAdverseContinuation = strategy.position_size < 0 and shortOpponentRetains and
         (buyerSponsored or auctionCode == AUC_EXP_UP)
    bool adverseContinuation = strategy.position_size > 0 ? longAdverseContinuation : shortAdverseContinuation

    // v0.8: holding below/above the pre-challenge close is only persistence.
    // It no longer proves that control transferred. Once TRANSFER BUILDING
    // begins, freeze the current adverse extreme. A later completed bar must
    // make fresh closing progress beyond that extreme, or Bot1 must show
    // genuine structural acceptance through S1/R1.
    bool longTransferProgress = strategy.position_size > 0 and
         tradeControlState == CT_TRANSFER_BUILDING and
         not na(tradeControlTransferExtreme) and
         close < tradeControlTransferExtreme and
         (dnTerritory or sellerSponsored or auctionCode == AUC_EXP_DN)

    bool shortTransferProgress = strategy.position_size < 0 and
         tradeControlState == CT_TRANSFER_BUILDING and
         not na(tradeControlTransferExtreme) and
         close > tradeControlTransferExtreme and
         (upTerritory or buyerSponsored or auctionCode == AUC_EXP_UP)

    bool transferProgress = strategy.position_size > 0 ? longTransferProgress : shortTransferProgress

    // Keep an extreme for telemetry and later diagnosis.
    if tradeControlState == CT_CHALLENGED or tradeControlState == CT_RECOVERING or tradeControlState == CT_TRANSFER_BUILDING
        tradeControlChallengeExtreme := strategy.position_size > 0 ?
             (na(tradeControlChallengeExtreme) ? low : math.min(tradeControlChallengeExtreme, low)) :
             (na(tradeControlChallengeExtreme) ? high : math.max(tradeControlChallengeExtreme, high))

    bool provenProtection = false

    // Only one state transition is allowed per completed bar. This prevents
    // one adverse bar from becoming CHALLENGE + RETENTION + TRANSFER at once.
    if enableProvenProtection and proofWasEstablished
        if tradeControlState == CT_UNPROVEN
            tradeControlState := CT_PROVEN

        if tradeControlState == CT_PROVEN
            if meaningfulGiveback and adverseEvent and not longFailure and not shortFailure
                tradeControlState := CT_CHALLENGED
                tradeControlEventId += 1
                tradeControlLastEvent := adverseEventCode
                tradeControlChallengeCode := adverseEventCode
                tradeControlChallengeBar := bar_index
                tradeControlTransferBar := na
                tradeControlChallengeOrigin := close[1]
                tradeControlChallengeExtreme := strategy.position_size > 0 ? low : high
                tradeControlResponseSeen := false
                tradeControlChallengeCount += 1
                tradeControlProtectEvent := CT_EVT_NONE
                tradeControlTransferPath := CT_PATH_NONE
                tradeControlTransferExtreme := na

        else if tradeControlState == CT_CHALLENGED
            if recoveryConfirmed
                tradeControlEventId += 1
                tradeControlLastEvent := CT_EVT_RECOVERY
                tradeControlRecoveryCount += 1
                tradeControlState := CT_PROVEN
                tradeControlChallengeBar := na
                tradeControlTransferBar := na
                tradeControlChallengeOrigin := na
                tradeControlChallengeExtreme := na
                tradeControlResponseSeen := false
                tradeControlChallengeCode := CT_EVT_NONE
                tradeControlTransferPath := CT_PATH_NONE
                tradeControlTransferExtreme := na
            else if responseEvent
                tradeControlEventId += 1
                tradeControlLastEvent := CT_EVT_RESPONSE
                tradeControlResponseSeen := true
                tradeControlState := CT_RECOVERING
            else if opponentRetains
                tradeControlEventId += 1
                tradeControlLastEvent := CT_EVT_CONTINUATION
                tradeControlTransferBar := bar_index
                tradeControlTransferPath := CT_PATH_NO_RESPONSE_RETENTION
                tradeControlTransferExtreme := strategy.position_size > 0 ? low : high
                tradeControlState := CT_TRANSFER_BUILDING

        else if tradeControlState == CT_RECOVERING
            if recoveryConfirmed
                tradeControlEventId += 1
                tradeControlLastEvent := CT_EVT_RECOVERY
                tradeControlRecoveryCount += 1
                tradeControlState := CT_PROVEN
                tradeControlChallengeBar := na
                tradeControlTransferBar := na
                tradeControlChallengeOrigin := na
                tradeControlChallengeExtreme := na
                tradeControlResponseSeen := false
                tradeControlChallengeCode := CT_EVT_NONE
                tradeControlTransferPath := CT_PATH_NONE
                tradeControlTransferExtreme := na
            else if responseFailure
                tradeControlEventId += 1
                tradeControlLastEvent := CT_EVT_RESPONSE_FAIL
                tradeControlTransferBar := bar_index
                tradeControlTransferPath := CT_PATH_RESPONSE_FAILURE
                tradeControlTransferExtreme := strategy.position_size > 0 ? low : high
                tradeControlState := CT_TRANSFER_BUILDING

        else if tradeControlState == CT_TRANSFER_BUILDING
            if recoveryConfirmed
                tradeControlEventId += 1
                tradeControlLastEvent := CT_EVT_RECOVERY
                tradeControlRecoveryCount += 1
                tradeControlState := CT_PROVEN
                tradeControlChallengeBar := na
                tradeControlTransferBar := na
                tradeControlChallengeOrigin := na
                tradeControlChallengeExtreme := na
                tradeControlResponseSeen := false
                tradeControlChallengeCode := CT_EVT_NONE
                tradeControlTransferPath := CT_PATH_NONE
                tradeControlTransferExtreme := na
            else if not na(tradeControlTransferBar) and bar_index > tradeControlTransferBar and
                 (adverseStructuralAcceptance or transferProgress) and not longFailure and not shortFailure
                tradeControlEventId += 1
                tradeControlLastEvent := adverseStructuralAcceptance ? CT_EVT_ACCEPTANCE : CT_EVT_CONTINUATION
                tradeControlProtectEvent := tradeControlLastEvent
                provenProtection := true

    if provenProtection and strategy.position_size > 0
        string protectPathL = tradeControlTransferPath == CT_PATH_RESPONSE_FAILURE ? "RF" : tradeControlTransferPath == CT_PATH_NO_RESPONSE_RETENTION ? "NR" : "NA"
        string protectConfirmL = adverseStructuralAcceptance ? "STRUCT" : transferProgress ? "PROGRESS" : "NA"
        string protectCommentL = "PROTECT|CH=" + f_ctEventTag(tradeControlChallengeCode) + "|PATH=" + protectPathL + "|CF=" + protectConfirmL + "|EV=" + f_ctEventTag(tradeControlProtectEvent) + "|OA=" + (adverseOriginAcceptance ? "1" : "0") + "|RS=" + (tradeControlResponseSeen ? "1" : "0") + "|B=" + str.tostring(na(tradeControlChallengeBar) ? 0 : bar_index - tradeControlChallengeBar)
        strategy.close("L", comment=protectCommentL + "|MFE=" + f_num(tradeMfeR, "#.##") + "|GB=" + f_num(tradeGivebackR, "#.##"), alert_message="EXIT PROTECT LONG")
        actionText := "EXIT PROTECT LONG"
        internalNote := "CONTROL TRANSFER · " + f_ctEventText(tradeControlProtectEvent) + " · CHALLENGE " + f_ctEventText(tradeControlChallengeCode)
    else if provenProtection and strategy.position_size < 0
        string protectPathS = tradeControlTransferPath == CT_PATH_RESPONSE_FAILURE ? "RF" : tradeControlTransferPath == CT_PATH_NO_RESPONSE_RETENTION ? "NR" : "NA"
        string protectConfirmS = adverseStructuralAcceptance ? "STRUCT" : transferProgress ? "PROGRESS" : "NA"
        string protectCommentS = "PROTECT|CH=" + f_ctEventTag(tradeControlChallengeCode) + "|PATH=" + protectPathS + "|CF=" + protectConfirmS + "|EV=" + f_ctEventTag(tradeControlProtectEvent) + "|OA=" + (adverseOriginAcceptance ? "1" : "0") + "|RS=" + (tradeControlResponseSeen ? "1" : "0") + "|B=" + str.tostring(na(tradeControlChallengeBar) ? 0 : bar_index - tradeControlChallengeBar)
        strategy.close("S", comment=protectCommentS + "|MFE=" + f_num(tradeMfeR, "#.##") + "|GB=" + f_num(tradeGivebackR, "#.##"), alert_message="EXIT PROTECT SHORT")
        actionText := "EXIT PROTECT SHORT"
        internalNote := "CONTROL TRANSFER · " + f_ctEventText(tradeControlProtectEvent) + " · CHALLENGE " + f_ctEventText(tradeControlChallengeCode)
    else if enableEarlyExit and longFailure
        strategy.close("L", comment="EARLY", alert_message="EXIT EARLY LONG")
        actionText := "EXIT EARLY LONG"
        internalNote := "LONG THESIS FAILED"
    else if enableEarlyExit and shortFailure
        strategy.close("S", comment="EARLY", alert_message="EXIT EARLY SHORT")
        actionText := "EXIT EARLY SHORT"
        internalNote := "SHORT THESIS FAILED"
    else if (executionTimingMode == "LIVE" and legacyExecutionFailureSignal) or contractFastFtlExitSignal
        int failSide = strategy.position_size > 0 ? SIDE_LONG : SIDE_SHORT
        bool execWasFtl2 = contractFastFtlExitSignal
        string execFailTag = execWasFtl2 ? "FTL_FAST" : "EXECFAIL"
        episodeExecutionRetryCount += 1
        executionRetrySide := failSide
        executionRetryAfterBar := bar_index
        executionRetryWait := episodeExecutionRetryCount <= maxExecutionRetries
        executionRetryRearm := false
        executionFailExitCount += 1
        if failSide == SIDE_LONG
            strategy.close("L", comment=execFailTag, alert_message="EXIT EXECUTION FAIL LONG")
            actionText := execWasFtl2 ? "EXIT LONG — FAILURE TO LAUNCH" : "EXIT LONG — ENTRY TIMING FAILED"
        else
            strategy.close("S", comment=execFailTag, alert_message="EXIT EXECUTION FAIL SHORT")
            actionText := execWasFtl2 ? "EXIT SHORT — FAILURE TO LAUNCH" : "EXIT SHORT — ENTRY TIMING FAILED"
        if executionRetryWait
            internalNote := execWasFtl2 ? "FTL2 · THESIS ALIVE · WAIT FRESH INITIATIVE" : "LOCAL ENTRY INVALIDATED · THESIS ALIVE · WAIT FRESH INITIATIVE"
        else
            internalNote := "LOCAL ENTRY INVALIDATED · RETRY BUDGET CONSUMED"
    else
        if strategy.position_size > 0
            if tradeControlState == CT_CHALLENGED
                actionText := "LONG CHALLENGED"
            else if tradeControlState == CT_RECOVERING
                actionText := "LONG RECOVERING"
            else if tradeControlState == CT_TRANSFER_BUILDING
                actionText := "LONG TRANSFER BUILDING"
            else
                actionText := tradeProved05 ? "LONG PROVEN" : "LONG ACTIVE"
        else
            if tradeControlState == CT_CHALLENGED
                actionText := "SHORT CHALLENGED"
            else if tradeControlState == CT_RECOVERING
                actionText := "SHORT RECOVERING"
            else if tradeControlState == CT_TRANSFER_BUILDING
                actionText := "SHORT TRANSFER BUILDING"
            else
                actionText := tradeProved05 ? "SHORT PROVEN" : "SHORT ACTIVE"
        if tradeControlState == CT_CHALLENGED or tradeControlState == CT_RECOVERING or tradeControlState == CT_TRANSFER_BUILDING
            internalNote := f_ctStateText(tradeControlState) + " · LAST " + f_ctEventText(tradeControlLastEvent)

// 2) Manage pending ARM when flat.
    reasoningHandled := true

// 2) Manage pending ARM when flat.
if canReasonThisBar and not reasoningHandled and pendingSide != SIDE_NONE
    bool triggerStale = bar_index - armBar >= armTriggerFreshBars

    bool invalidated = pendingSide == SIDE_LONG ? low <= armInvalid : high >= armInvalid
    bool contradicted = pendingSide == SIDE_LONG ? bullContradicted : bearContradicted
    bool oppositeTookOver = pendingSide == SIDE_LONG ? bearSupported : bullSupported
    bool routeCollapsed = pendingSide == SIDE_LONG ? not longRouteUsable : not shortRouteUsable
    bool sessionNoLongerAllowsEntry = not entriesAllowedNow

    // Hard thesis failure or session closure: cancel the attempt.
    if invalidated or contradicted or oppositeTookOver or routeCollapsed or sessionNoLongerAllowsEntry
        if pendingSide == SIDE_LONG
            strategy.cancel("L")
            strategy.cancel("L-X")
        else
            strategy.cancel("S")
            strategy.cancel("S-X")

        internalNote := invalidated ? "THESIS INVALIDATED BEFORE ENTRY" :
             contradicted ? "THESIS CONTRADICTED" :
             oppositeTookOver ? "OPPOSING THESIS TOOK OVER" :
             routeCollapsed ? "ROUTE COLLAPSED" :
             propShieldActive ? "PROP SHIELD ACTIVE · PENDING ARM CANCELED" :
             "PROP EXECUTION WINDOW CLOSED"

        pendingSide := SIDE_NONE
        armTrigger := na
        armInvalid := na
        armTarget := na
        armBar := na
        armReason := ""
        armOpportunityMode := OM_UNKNOWN
        armRefreshCount := 0
        armExecInvalid := na
        armDefenseOrigin := false
        armRetryOrigin := false
            
        episodeUsed := true
        actionText := "WAIT"

    else if triggerStale

        // PROP MODE: thesis memory stays, but the specific entry attempt is
        // over. We do NOT rebuild the trigger automatically. Bot2 must wait
        // for this thesis episode to disappear and a genuinely fresh episode
        // to form before it can ARM again.
        if pendingSide == SIDE_LONG
            strategy.cancel("L")
            strategy.cancel("L-X")
        else
            strategy.cancel("S")
            strategy.cancel("S-X")

        int releasedSide = pendingSide

        pendingSide := SIDE_NONE
        armTrigger := na
        armInvalid := na
        armTarget := na
        armBar := na
        armReason := ""
        armOpportunityMode := OM_UNKNOWN
        armRefreshCount := 0
        armExecInvalid := na
        armDefenseOrigin := false
        armRetryOrigin := false
        episodeUsed := true

        if releasedSide == SIDE_LONG
            actionText := "LONG THESIS · ATTEMPT EXPIRED"
        else
            actionText := "SHORT THESIS · ATTEMPT EXPIRED"
        internalNote := "STALE ARM EXPIRED · WAIT FOR FRESH EPISODE"

    else
        // Still inside the one-bar freshness window.
        if pendingSide == SIDE_LONG
            strategy.entry("L", strategy.long, stop=armTrigger, comment="", alert_message="BOT2 ENTER LONG · ENTRY " + str.tostring(armTrigger, format.mintick) + " · STOP " + str.tostring(armInvalid, format.mintick) + " · TARGET " + str.tostring(armTarget, format.mintick))
            strategy.exit("L-X", from_entry="L", stop=armInvalid, limit=armTarget,
                 comment_profit="TARGET", comment_loss="STOP",
                 alert_profit="BOT2 LONG TARGET HIT", alert_loss="BOT2 LONG STOP HIT")
            actionText := "ARM LONG"
        else
            strategy.entry("S", strategy.short, stop=armTrigger, comment="", alert_message="BOT2 ENTER SHORT · ENTRY " + str.tostring(armTrigger, format.mintick) + " · STOP " + str.tostring(armInvalid, format.mintick) + " · TARGET " + str.tostring(armTarget, format.mintick))
            strategy.exit("S-X", from_entry="S", stop=armInvalid, limit=armTarget,
                 comment_profit="TARGET", comment_loss="STOP",
                 alert_profit="BOT2 SHORT TARGET HIT", alert_loss="BOT2 SHORT STOP HIT")
            actionText := "ARM SHORT"

// 3) Flat thesis reasoning is intentionally split into a second top-level
// block. This preserves the same mutually-exclusive state machine while
// keeping Pine from compiling one enormous if/else statement (CE10205).
    reasoningHandled := true

// 3) Nothing above consumed the bar: run flat thesis reasoning.
if canReasonThisBar and not reasoningHandled
    runFlatReasoning := true
    reasoningHandled := true


// 3) Update / create thesis episodes when flat and not armed.
if canReasonThisBar and runFlatReasoning
    bool bullAlive = bullDeveloping and not bullContradicted
    bool bearAlive = bearDeveloping and not bearContradicted

    // Existing episode continuity.
    if episodeSide == SIDE_LONG
        if bullAlive
            episodeQuietBars := 0
        else
            episodeQuietBars += 1
    else if episodeSide == SIDE_SHORT
        if bearAlive
            episodeQuietBars := 0
        else
            episodeQuietBars += 1

    // Hard side change: current explanation has genuinely flipped.
    if episodeSide == SIDE_LONG and bearSupported and not bullSupported
        episodeSide := SIDE_SHORT
        episodeStartBar := bar_index
        episodeQuietBars := 0
        episodeUsed := false
        episodeReason := shortReason
        longMaturityWait := false
        longPullbackSeen := false
        longMaturityHigh := na
        longMaturityBar := na
        shortMaturityWait := false
        shortPullbackSeen := false
        shortMaturityLow := na
        shortMaturityBar := na
        longControlWait := false
        shortControlWait := false
        longControlRearm := false
        shortControlRearm := false
        longInitiativeWait := false
        shortInitiativeWait := false
        longInitiativeRearm := false
        shortInitiativeRearm := false
        longInitiativeWaitBar := na
        shortInitiativeWaitBar := na
        executionRetrySide := SIDE_NONE
        executionRetryWait := false
        executionRetryRearm := false
        executionRetryAfterBar := na
        episodeExecutionRetryCount := 0
    else if episodeSide == SIDE_SHORT and bullSupported and not bearSupported
        episodeSide := SIDE_LONG
        episodeStartBar := bar_index
        episodeQuietBars := 0
        episodeUsed := false
        episodeReason := longReason
        longMaturityWait := false
        longPullbackSeen := false
        longMaturityHigh := na
        longMaturityBar := na
        shortMaturityWait := false
        shortPullbackSeen := false
        shortMaturityLow := na
        shortMaturityBar := na
        longControlWait := false
        shortControlWait := false
        longControlRearm := false
        shortControlRearm := false
        longInitiativeWait := false
        shortInitiativeWait := false
        longInitiativeRearm := false
        shortInitiativeRearm := false
        longInitiativeWaitBar := na
        shortInitiativeWaitBar := na
        executionRetrySide := SIDE_NONE
        executionRetryWait := false
        executionRetryRearm := false
        executionRetryAfterBar := na
        episodeExecutionRetryCount := 0

    // Episode expires only after the idea disappears for a while.
    if episodeSide != SIDE_NONE and episodeQuietBars >= episodeResetBars
        episodeSide := SIDE_NONE
        episodeStartBar := na
        episodeQuietBars := 0
        episodeUsed := false
        episodeReason := ""
        longMaturityWait := false
        longPullbackSeen := false
        longMaturityHigh := na
        longMaturityBar := na
        shortMaturityWait := false
        shortPullbackSeen := false
        shortMaturityLow := na
        shortMaturityBar := na
        longControlWait := false
        shortControlWait := false
        longControlRearm := false
        shortControlRearm := false
        longInitiativeWait := false
        shortInitiativeWait := false
        longInitiativeRearm := false
        shortInitiativeRearm := false
        longInitiativeWaitBar := na
        shortInitiativeWaitBar := na
        executionRetrySide := SIDE_NONE
        executionRetryWait := false
        executionRetryRearm := false
        executionRetryAfterBar := na
        episodeExecutionRetryCount := 0

    // Start a new one only when one explanation is clearer than the other.
    if episodeSide == SIDE_NONE
        if bullAlive and not bearAlive
            episodeSide := SIDE_LONG
            episodeStartBar := bar_index
            episodeReason := longReason
            longMaturityWait := false
            longPullbackSeen := false
            longMaturityHigh := na
            longMaturityBar := na
            shortMaturityWait := false
            shortPullbackSeen := false
            shortMaturityLow := na
            shortMaturityBar := na
            longControlWait := false
            shortControlWait := false
            longControlRearm := false
            shortControlRearm := false
            longInitiativeWait := false
            shortInitiativeWait := false
            longInitiativeRearm := false
            shortInitiativeRearm := false
            longInitiativeWaitBar := na
            shortInitiativeWaitBar := na
            executionRetrySide := SIDE_NONE
            executionRetryWait := false
            executionRetryRearm := false
            executionRetryAfterBar := na
            episodeExecutionRetryCount := 0
        else if bearAlive and not bullAlive
            episodeSide := SIDE_SHORT
            episodeStartBar := bar_index
            episodeReason := shortReason
            longMaturityWait := false
            longPullbackSeen := false
            longMaturityHigh := na
            longMaturityBar := na
            shortMaturityWait := false
            shortPullbackSeen := false
            shortMaturityLow := na
            shortMaturityBar := na
            longControlWait := false
            shortControlWait := false
            longControlRearm := false
            shortControlRearm := false
            longInitiativeWait := false
            shortInitiativeWait := false
            longInitiativeRearm := false
            shortInitiativeRearm := false
            longInitiativeWaitBar := na
            shortInitiativeWaitBar := na
            executionRetrySide := SIDE_NONE
            executionRetryWait := false
            executionRetryRearm := false
            executionRetryAfterBar := na
            episodeExecutionRetryCount := 0

    // ─────────────────────────────────────────────────────────────────────
    // v0.19 EPISODE EVIDENCE MEMORY
    // Reset automatically when the thesis identity changes, then remember
    // causal primitives across bars. This is NOT a vote and does not by
    // itself grant ARM permission; it preserves the story for interpretation
    // and exported telemetry.
    bool evidenceEpisodeChanged =
         episodeSide != evidenceTrackedSide or
         nz(episodeStartBar, -1) != nz(evidenceTrackedStart, -1)
    if evidenceEpisodeChanged
        episodeSeenDiscovery := false
        episodeSeenFailure := false
        episodeSeenDefense := false
        episodeSeenAcceptance := false
        episodeDiscoveryBar := na
        episodeFailureBar := na
        episodeDefenseBar := na
        episodeAcceptanceBar := na
        episodeInitiativeBar := na
        episodeEvidenceMask := 0
        evidenceTrackedSide := episodeSide
        evidenceTrackedStart := episodeStartBar

    if episodeSide == SIDE_NONE
        episodeEvidenceMask := 0
    else if episodeSide == SIDE_LONG
        if longDiscovery and not episodeSeenDiscovery
            episodeSeenDiscovery := true
            episodeDiscoveryBar := bar_index
        if longFailedDown and not episodeSeenFailure
            episodeSeenFailure := true
            episodeFailureBar := bar_index
        if longSupportDefense and not episodeSeenDefense
            episodeSeenDefense := true
            episodeDefenseBar := bar_index
        if longAcceptance and not episodeSeenAcceptance
            episodeSeenAcceptance := true
            episodeAcceptanceBar := bar_index
        if freshLongInitiativeEvent and na(episodeInitiativeBar)
            episodeInitiativeBar := bar_index
    else if episodeSide == SIDE_SHORT
        if shortDiscovery and not episodeSeenDiscovery
            episodeSeenDiscovery := true
            episodeDiscoveryBar := bar_index
        if shortFailedUp and not episodeSeenFailure
            episodeSeenFailure := true
            episodeFailureBar := bar_index
        if shortResistanceDefense and not episodeSeenDefense
            episodeSeenDefense := true
            episodeDefenseBar := bar_index
        if shortAcceptance and not episodeSeenAcceptance
            episodeSeenAcceptance := true
            episodeAcceptanceBar := bar_index
        if freshShortInitiativeEvent and na(episodeInitiativeBar)
            episodeInitiativeBar := bar_index

    episodeEvidenceMask :=
         (episodeSeenDiscovery ? 1 : 0) +
         (episodeSeenFailure ? 2 : 0) +
         (episodeSeenDefense ? 4 : 0) +
         (episodeSeenAcceptance ? 8 : 0) +
         (not na(episodeInitiativeBar) ? 16 : 0)

    // ─────────────────────────────────────────────────────────────────────
    // v0.14 DEFENSE → INITIATIVE + EXECUTION RETRY STATE
    // Track in SHADOW and LIVE. Only LIVE changes ARM eligibility.
    // ─────────────────────────────────────────────────────────────────────
    if initiativeMode == "OFF"
        longInitiativeWait := false
        shortInitiativeWait := false
        longInitiativeRearm := false
        shortInitiativeRearm := false
        longInitiativeWaitBar := na
        shortInitiativeWaitBar := na
        longInitiativeAnchorHigh := na
        shortInitiativeAnchorLow := na
    else
        if episodeSide == SIDE_LONG and not episodeUsed
            if longDefenseOnlyCause and (strictDefenseSequence or not longInitiativeNow) and not longInitiativeWait and not longInitiativeRearm
                longInitiativeWait := true
                longInitiativeWaitBar := bar_index
                longInitiativeAnchorHigh := high
                if initiativeMode == "SHADOW"
                    initiativeShadowBlockedCount += 1
                else
                    initiativeLiveBlockedCount += 1
            if longInitiativeWait
                bool longInitExpired = not na(longInitiativeWaitBar) and bar_index - longInitiativeWaitBar > initiativeWaitBars
                // IMPORTANT A/B INTEGRITY: when strictDefenseSequence is OFF,
                // reproduce the v0.15 state transition exactly.  v0.16.0
                // accidentally used the new control-transfer test in both
                // modes, so C16=00000 was not a true legacy control.
                if not strictDefenseSequence
                    if bullContradicted or (bearSupported and not bullSupported) or longInitExpired
                        longInitiativeWait := false
                        longInitiativeWaitBar := na
                    else if not na(longInitiativeWaitBar) and bar_index > longInitiativeWaitBar and freshLongInitiativeEvent
                        longInitiativeWait := false
                        longInitiativeWaitBar := na
                        longInitiativeRearm := true
                else
                    bool longDefenseInvalidated = bullContradicted or (bearSupported and not bullSupported)
                    if longDefenseInvalidated
                        longInitiativeWait := false
                        longInitiativeWaitBar := na
                        longInitiativeAnchorHigh := na
                        longInitiativeRearm := false
                    else if not na(longInitiativeWaitBar) and bar_index > longInitiativeWaitBar
                        bool longDefenseControlTransfer = not na(longInitiativeAnchorHigh) and
                             close > longInitiativeAnchorHigh and
                             (longInitiativeNow or buyerSponsored or fpLongSupport) and
                             not sellerSponsored and not bullContradicted
                        if longDefenseControlTransfer
                            longInitiativeWait := false
                            longInitiativeWaitBar := na
                            longInitiativeAnchorHigh := na
                            longInitiativeRearm := true
        if episodeSide == SIDE_SHORT and not episodeUsed
            if shortDefenseOnlyCause and (strictDefenseSequence or not shortInitiativeNow) and not shortInitiativeWait and not shortInitiativeRearm
                shortInitiativeWait := true
                shortInitiativeWaitBar := bar_index
                shortInitiativeAnchorLow := low
                if initiativeMode == "SHADOW"
                    initiativeShadowBlockedCount += 1
                else
                    initiativeLiveBlockedCount += 1
            if shortInitiativeWait
                bool shortInitExpired = not na(shortInitiativeWaitBar) and bar_index - shortInitiativeWaitBar > initiativeWaitBars
                if not strictDefenseSequence
                    if bearContradicted or (bullSupported and not bearSupported) or shortInitExpired
                        shortInitiativeWait := false
                        shortInitiativeWaitBar := na
                    else if not na(shortInitiativeWaitBar) and bar_index > shortInitiativeWaitBar and freshShortInitiativeEvent
                        shortInitiativeWait := false
                        shortInitiativeWaitBar := na
                        shortInitiativeRearm := true
                else
                    bool shortDefenseInvalidated = bearContradicted or (bullSupported and not bearSupported)
                    if shortDefenseInvalidated
                        shortInitiativeWait := false
                        shortInitiativeWaitBar := na
                        shortInitiativeAnchorLow := na
                        shortInitiativeRearm := false
                    else if not na(shortInitiativeWaitBar) and bar_index > shortInitiativeWaitBar
                        bool shortDefenseControlTransfer = not na(shortInitiativeAnchorLow) and
                             close < shortInitiativeAnchorLow and
                             (shortInitiativeNow or sellerSponsored or fpShortSupport) and
                             not buyerSponsored and not bearContradicted
                        if shortDefenseControlTransfer
                            shortInitiativeWait := false
                            shortInitiativeWaitBar := na
                            shortInitiativeAnchorLow := na
                            shortInitiativeRearm := true

    // A LIVE local execution failure does not immediately re-arm. It waits
    // for a NEW initiative edge after the exit. One retry max by default.
    if executionRetryWait
        bool retryExpired = not na(executionRetryAfterBar) and bar_index - executionRetryAfterBar > execRetryWatchBars
        bool retrySideLost = executionRetrySide == SIDE_LONG ?
             (episodeSide != SIDE_LONG or bullContradicted or (bearSupported and not bullSupported)) :
             (episodeSide != SIDE_SHORT or bearContradicted or (bullSupported and not bearSupported))
        if retryExpired or retrySideLost or episodeExecutionRetryCount > maxExecutionRetries
            executionRetrySide := SIDE_NONE
            executionRetryWait := false
            executionRetryRearm := false
            executionRetryAfterBar := na
        else if not na(executionRetryAfterBar) and bar_index > executionRetryAfterBar
            bool retryFresh = executionRetrySide == SIDE_LONG ? freshLongInitiativeEvent : freshShortInitiativeEvent
            if retryFresh
                executionRetryWait := false
                executionRetryRearm := true

    // v0.3E CONTROL TRANSFER:
    // Keep the failed-auction thesis alive, but do not ARM until the old
    // side has stopped controlling territory.
    if episodeSide == SIDE_LONG and not episodeUsed
        if longReversalUnprovenNow and not longControlWait
            longControlWait := true
            longControlRearm := false

        bool longControlTransferred =
             longControlWait and
             not dnTerritory and not dnHolding and
             (upTerritory or upHolding or
              (not upTerritory and not dnTerritory and not upHolding and not dnHolding) or
              auctionCode == AUC_EXP_UP or
              acceptedAboveR)

        if longControlTransferred
            longControlWait := false
            longControlRearm := true

    if episodeSide == SIDE_SHORT and not episodeUsed
        if shortReversalUnprovenNow and not shortControlWait
            shortControlWait := true
            shortControlRearm := false

        bool shortControlTransferred =
             shortControlWait and
             not upTerritory and not upHolding and
             (dnTerritory or dnHolding or
              (not upTerritory and not dnTerritory and not upHolding and not dnHolding) or
              auctionCode == AUC_EXP_DN or
              acceptedBelowS)

        if shortControlTransferred
            shortControlWait := false
            shortControlRearm := true

    // v0.17 MOVE LIFECYCLE:
    // Thesis direction and execution timing are separate.  If the intended
    // move is already mature, do not chase the first continuation.  Require
    // a meaningful pullback followed by a fresh same-side response.
    if episodeSide == SIDE_LONG and not episodeUsed
        if longMoveMatureNow and not longMaturityWait
            longMaturityWait := true
            longPullbackSeen := false
            longMaturityHigh := high
            longMaturityBar := bar_index

        if longMaturityWait
            longMaturityHigh := na(longMaturityHigh) ? high : math.max(longMaturityHigh, high)

            bool meaningfulLongPullback =
                 bar_index > longMaturityBar and
                 close <= longMaturityHigh - atr * territoryMinAtr and
                 (sellerResult >= 0.14 or close < open)

            if meaningfulLongPullback
                longPullbackSeen := true

    bool longFreshResponse =
         longMaturityWait and longPullbackSeen and
         (rejectedAtS or balanceReclaimUp or freshLongInitiativeEvent or
          (close > open and buyerResult >= 0.14 and not buyerPoorResult))

    if episodeSide == SIDE_SHORT and not episodeUsed
        if shortMoveMatureNow and not shortMaturityWait
            shortMaturityWait := true
            shortPullbackSeen := false
            shortMaturityLow := low
            shortMaturityBar := bar_index

        if shortMaturityWait
            shortMaturityLow := na(shortMaturityLow) ? low : math.min(shortMaturityLow, low)

            bool meaningfulShortPullback =
                 bar_index > shortMaturityBar and
                 close >= shortMaturityLow + atr * territoryMinAtr and
                 (buyerResult >= 0.14 or close > open)

            if meaningfulShortPullback
                shortPullbackSeen := true

    bool shortFreshResponse =
         shortMaturityWait and shortPullbackSeen and
         (rejectedAtR or balanceReclaimDn or freshShortInitiativeEvent or
          (close < open and sellerResult >= 0.14 and not sellerPoorResult))

    // Upgrade the SAME episode to ARM once the market demonstrates the
    // relevant event. No repeated arm spam inside one thesis episode.
    //
    // v0.3C counterattack timing remains intact.
    // v0.3D adds a separate "is this still worth it?" question for
    // FAILED-UP shorts. Mature moves wait for pullback + fresh response.
    bool longControlReady = not longControlWait

    // ─────────────────────────────────────────────────────────────────────
    // v0.13 FAILED-AUCTION CONFIDENCE
    //
    // Full-history v0.12 audit found that failed auctions remain the core
    // edge, but their first interpretation is materially weaker when the
    // opening/context story is unresolved:
    //   • moderate positive RTH gap (+0.25 to +1 ATR), both directions
    //   • NQ/ES divergence, specifically a persistent weakness for FAILED-DOWN
    //
    // We do NOT blacklist those environments and we do NOT score indicators.
    // The failed-auction explanation stays alive; Bot2 simply asks for a
    // fresh same-side proof event before committing capital.
    // ─────────────────────────────────────────────────────────────────────
    // v0.16.2 CONTROL-PURITY FIX
    //
    // The OFF path below deliberately reconstructs the v0.15 confidence
    // calculations IN THIS SAME FLAT-ONLY LOCAL SCOPE.  This matters because
    // Pine history on the locally-computed strong-progress series can differ
    // from an equivalent-looking global series across bars spent in a trade.
    // C16=00000 must therefore use these local legacy variables verbatim.
    bool legacyModerateUpGapConflict =
         ctxValid and gapCtx == 4

    bool legacyNqEsDivergenceConflict =
         clockCtxValid and (esContextCtx == 3 or esContextCtx == 4)

    bool legacyFailedDownConfidenceConflict =
         enableFailedAuctionConfidence and longFailedDown and
         (legacyModerateUpGapConflict or legacyNqEsDivergenceConflict)

    bool legacyFailedUpConfidenceConflict =
         enableFailedAuctionConfidence and shortFailedUp and
         legacyModerateUpGapConflict

    bool legacyLongStrongProgressNow =
         upTerritory and buyerResult >= 0.40 and not buyerPoorResult and
         not sellerSponsored

    bool legacyShortStrongProgressNow =
         dnTerritory and sellerResult >= 0.40 and not sellerPoorResult and
         not buyerSponsored

    bool legacyFreshLongConfidenceProof =
         (longDiscovery and not longDiscovery[1]) or
         (longAcceptance and not longAcceptance[1]) or
         (longSupportDefense and not longSupportDefense[1]) or
         (legacyLongStrongProgressNow and not legacyLongStrongProgressNow[1])

    bool legacyFreshShortConfidenceProof =
         (shortDiscovery and not shortDiscovery[1]) or
         (shortAcceptance and not shortAcceptance[1]) or
         (shortResistanceDefense and not shortResistanceDefense[1]) or
         (legacyShortStrongProgressNow and not legacyShortStrongProgressNow[1])

    // Cross-detail is an independent experiment. OFF means the exact v0.15
    // conflict definition; ON swaps only the cross-market interpretation.
    bool selectedFailedDownConflictNow = useCrossDetailV2 ?
         v16FailedDownConflictNow : legacyFailedDownConfidenceConflict
    bool selectedFailedUpConflictNow = useCrossDetailV2 ?
         v16FailedUpConflictNow : legacyFailedUpConfidenceConflict

    // v0.16 causal confidence state machine. Reset automatically whenever
    // the thesis episode identity changes so conflict memory cannot leak.
    bool confidenceEpisodeChanged = episodeSide != confidenceTrackedEpisodeSide or
         nz(episodeStartBar, -1) != nz(confidenceTrackedEpisodeStart, -1)
    if confidenceEpisodeChanged
        longConfidenceWait := false
        shortConfidenceWait := false
        longConfidenceRearm := false
        shortConfidenceRearm := false
        longConfidenceConflictSeen := false
        shortConfidenceConflictSeen := false
        longConfidenceConflictBar := na
        shortConfidenceConflictBar := na
        longConfidenceConflictHigh := na
        shortConfidenceConflictLow := na
        confidenceTrackedEpisodeStart := episodeStartBar
        confidenceTrackedEpisodeSide := episodeSide

    if episodeSide == SIDE_NONE
        longConfidenceWait := false
        shortConfidenceWait := false
        longConfidenceRearm := false
        shortConfidenceRearm := false
        longConfidenceConflictSeen := false
        shortConfidenceConflictSeen := false
        longConfidenceConflictBar := na
        shortConfidenceConflictBar := na
        longConfidenceConflictHigh := na
        shortConfidenceConflictLow := na

    if strictFailedAuctionProof
        if episodeSide == SIDE_LONG and not episodeUsed
            if selectedFailedDownConflictNow and not longConfidenceConflictSeen
                longConfidenceConflictSeen := true
                longConfidenceWait := true
                longConfidenceRearm := false
                longConfidenceConflictBar := bar_index
                longConfidenceConflictHigh := high
                longConfidencePressureConflict := v19HtfImpulseConflictLong
                longPressureFreshInitiativeSeen := false
                longConfidenceProofBar := na

            // A strong-HTF-pressure conflict needs a NEW local initiative event
            // after the conflict. The HTF itself does NOT need to flip first.
            if longConfidenceWait and longConfidencePressureConflict and
                 not na(longConfidenceConflictBar) and bar_index > longConfidenceConflictBar and
                 freshLongInitiativeEvent and not sellerSponsored and
                 not bullContradicted and not fpLongContradiction
                longPressureFreshInitiativeSeen := true

            if longConfidenceWait
                bool longConfidenceInvalidated = bullContradicted or (bearSupported and not bullSupported)
                bool longGenericLaterProof = not na(longConfidenceConflictBar) and bar_index > longConfidenceConflictBar and
                     not na(longConfidenceConflictHigh) and close > longConfidenceConflictHigh and
                     (longInitiativeNow or buyerSponsored or fpLongSupport) and
                     not sellerSponsored and not bullContradicted and not fpLongContradiction
                bool longPressureLaterProof = not na(longConfidenceConflictBar) and bar_index > longConfidenceConflictBar and
                     not na(longConfidenceConflictHigh) and close > longConfidenceConflictHigh and
                     longPressureFreshInitiativeSeen and longInitiativeNow and
                     not sellerSponsored and not bullContradicted and not fpLongContradiction
                bool longLaterProof = longConfidencePressureConflict ? longPressureLaterProof : longGenericLaterProof

                if longConfidenceInvalidated
                    // Opposite control was actually established. End this thesis.
                    longConfidenceWait := false
                    longConfidenceRearm := false
                    longConfidenceConflictSeen := false
                    longConfidenceConflictBar := na
                    longConfidenceConflictHigh := na
                    longConfidencePressureConflict := false
                    longPressureFreshInitiativeSeen := false
                    longConfidenceProofBar := na
                    episodeUsed := true
                else if longLaterProof
                    longConfidenceWait := false
                    longConfidenceRearm := true
                    longConfidenceProofBar := bar_index

            // v0.20 RETENTION: proof is not a permanent badge. If the market
            // falls back through the conflict reference or opposing control
            // reappears before ARM, the proof is withdrawn and Bot2 waits for
            // a genuinely new transfer event.
            if longConfidenceRearm
                bool longProofRetained = not na(longConfidenceConflictHigh) and
                     close > longConfidenceConflictHigh and not sellerSponsored and
                     not bullContradicted and not fpLongContradiction
                if not longProofRetained
                    bool longProofHardFailed = bullContradicted or (bearSupported and not bullSupported)
                    longConfidenceRearm := false
                    longConfidenceProofBar := na
                    longPressureFreshInitiativeSeen := false
                    if longProofHardFailed
                        longConfidenceWait := false
                        longConfidenceConflictSeen := false
                        longConfidenceConflictBar := na
                        longConfidenceConflictHigh := na
                        longConfidencePressureConflict := false
                        episodeUsed := true
                    else
                        longConfidenceWait := true

        if episodeSide == SIDE_SHORT and not episodeUsed
            if selectedFailedUpConflictNow and not shortConfidenceConflictSeen
                shortConfidenceConflictSeen := true
                shortConfidenceWait := true
                shortConfidenceRearm := false
                shortConfidenceConflictBar := bar_index
                shortConfidenceConflictLow := low
                shortConfidencePressureConflict := v19HtfImpulseConflictShort
                shortPressureFreshInitiativeSeen := false
                shortConfidenceProofBar := na

            if shortConfidenceWait and shortConfidencePressureConflict and
                 not na(shortConfidenceConflictBar) and bar_index > shortConfidenceConflictBar and
                 freshShortInitiativeEvent and not buyerSponsored and
                 not bearContradicted and not fpShortContradiction
                shortPressureFreshInitiativeSeen := true

            if shortConfidenceWait
                bool shortConfidenceInvalidated = bearContradicted or (bullSupported and not bearSupported)
                bool shortGenericLaterProof = not na(shortConfidenceConflictBar) and bar_index > shortConfidenceConflictBar and
                     not na(shortConfidenceConflictLow) and close < shortConfidenceConflictLow and
                     (shortInitiativeNow or sellerSponsored or fpShortSupport) and
                     not buyerSponsored and not bearContradicted and not fpShortContradiction
                bool shortPressureLaterProof = not na(shortConfidenceConflictBar) and bar_index > shortConfidenceConflictBar and
                     not na(shortConfidenceConflictLow) and close < shortConfidenceConflictLow and
                     shortPressureFreshInitiativeSeen and shortInitiativeNow and
                     not buyerSponsored and not bearContradicted and not fpShortContradiction
                bool shortLaterProof = shortConfidencePressureConflict ? shortPressureLaterProof : shortGenericLaterProof

                if shortConfidenceInvalidated
                    shortConfidenceWait := false
                    shortConfidenceRearm := false
                    shortConfidenceConflictSeen := false
                    shortConfidenceConflictBar := na
                    shortConfidenceConflictLow := na
                    shortConfidencePressureConflict := false
                    shortPressureFreshInitiativeSeen := false
                    shortConfidenceProofBar := na
                    episodeUsed := true
                else if shortLaterProof
                    shortConfidenceWait := false
                    shortConfidenceRearm := true
                    shortConfidenceProofBar := bar_index

            if shortConfidenceRearm
                bool shortProofRetained = not na(shortConfidenceConflictLow) and
                     close < shortConfidenceConflictLow and not buyerSponsored and
                     not bearContradicted and not fpShortContradiction
                if not shortProofRetained
                    bool shortProofHardFailed = bearContradicted or (bullSupported and not bearSupported)
                    shortConfidenceRearm := false
                    shortConfidenceProofBar := na
                    shortPressureFreshInitiativeSeen := false
                    if shortProofHardFailed
                        shortConfidenceWait := false
                        shortConfidenceConflictSeen := false
                        shortConfidenceConflictBar := na
                        shortConfidenceConflictLow := na
                        shortConfidencePressureConflict := false
                        episodeUsed := true
                    else
                        shortConfidenceWait := true
    else
        // State is observational only in legacy mode; it cannot influence ARM.
        longConfidenceWait := false
        shortConfidenceWait := false
        longConfidenceRearm := false
        shortConfidenceRearm := false
        longConfidenceConflictSeen := selectedFailedDownConflictNow
        shortConfidenceConflictSeen := selectedFailedUpConflictNow
        longConfidenceConflictBar := selectedFailedDownConflictNow ? bar_index : na
        shortConfidenceConflictBar := selectedFailedUpConflictNow ? bar_index : na
        longConfidenceConflictHigh := selectedFailedDownConflictNow ? high : na
        shortConfidenceConflictLow := selectedFailedUpConflictNow ? low : na
        longConfidencePressureConflict := selectedFailedDownConflictNow and v19HtfImpulseConflictLong
        shortConfidencePressureConflict := selectedFailedUpConflictNow and v19HtfImpulseConflictShort
        longPressureFreshInitiativeSeen := false
        shortPressureFreshInitiativeSeen := false
        longConfidenceProofBar := na
        shortConfidenceProofBar := na

    bool failedDownConfidenceConflict = strictFailedAuctionProof ? longConfidenceConflictSeen : selectedFailedDownConflictNow
    bool failedUpConfidenceConflict = strictFailedAuctionProof ? shortConfidenceConflictSeen : selectedFailedUpConflictNow
    bool freshLongConfidenceProof = strictFailedAuctionProof ? longConfidenceRearm : legacyFreshLongConfidenceProof
    bool freshShortConfidenceProof = strictFailedAuctionProof ? shortConfidenceRearm : legacyFreshShortConfidenceProof

    bool longFailedAuctionConfidenceReady = strictFailedAuctionProof ? not longConfidenceWait :
         (not selectedFailedDownConflictNow or legacyFreshLongConfidenceProof)
    bool shortFailedAuctionConfidenceReady = strictFailedAuctionProof ? not shortConfidenceWait :
         (not selectedFailedUpConflictNow or legacyFreshShortConfidenceProof)

    string longConfidenceTag =
         strictFailedAuctionProof and longConfidenceConflictSeen ?
             (longConfidenceRearm ? "SEQPROOF" : "WAITSEQ") :
         not longFailedDown ? "NA" :
         not selectedFailedDownConflictNow ? "CLEAR" :
         legacyFreshLongConfidenceProof ? "PROVED" : "WAIT"

    string shortConfidenceTag =
         strictFailedAuctionProof and shortConfidenceConflictSeen ?
             (shortConfidenceRearm ? "SEQPROOF" : "WAITSEQ") :
         not shortFailedUp ? "NA" :
         not selectedFailedUpConflictNow ? "CLEAR" :
         legacyFreshShortConfidenceProof ? "PROVED" : "WAIT"

    bool longInitiativeGateReady = strictDefenseSequence ?
         (initiativeMode != "LIVE" or not longInitiativeWait) :
         (initiativeMode != "LIVE" or not longDefenseOnlyCause or longInitiativeNow or longInitiativeRearm)
    bool longRetryGateReady = executionRetrySide != SIDE_LONG or (not executionRetryWait and executionRetryRearm)
    bool longSupportForArm = bullSupported or
         (initiativeMode == "LIVE" and longInitiativeRearm and bullDeveloping) or
         (executionTimingMode == "LIVE" and executionRetryRearm and executionRetrySide == SIDE_LONG and bullDeveloping)

    bool longWorthTaking =
         not longMaturityWait or longFreshResponse

    bool longDevelopPhaseNow = f_movePhaseTag("L") == "DEVELOP"
    bool shortDevelopPhaseNow = f_movePhaseTag("S") == "DEVELOP"
    bool longDevelopProofNow = not na(episodeInitiativeBar) and not na(episodeStartBar) and episodeInitiativeBar > episodeStartBar and
         longInitiativeNow and (upTerritory or longAcceptance or fpLongSupport)
    bool shortDevelopProofNow = not na(episodeInitiativeBar) and not na(episodeStartBar) and episodeInitiativeBar > episodeStartBar and
         shortInitiativeNow and (dnTerritory or shortAcceptance or fpShortSupport)
    bool longDevelopGateReady = not developPermissionLive or not longDevelopPhaseNow or longDevelopProofNow
    bool shortDevelopGateReady = not developPermissionLive or not shortDevelopPhaseNow or shortDevelopProofNow

    bool longArmReady =
         entriesAllowedNow and
         episodeSide == SIDE_LONG and not episodeUsed and
         longSupportForArm and not bearSupported and
         longDevelopGateReady and
         not bullContradicted and
         not buyerCounterWeak and
         longWorthTaking and
         longControlReady and
         longSessionRunwayReady and
         longFailedAuctionConfidenceReady and
         longInitiativeGateReady and
         longRetryGateReady and
         longRegimeAllowed and
         longRouteUsable

    bool shortWorthTaking =
         not shortMaturityWait or shortFreshResponse

    bool shortControlReady = not shortControlWait

    // ─────────────────────────────────────────────────────────────────────
    // v0.12 CAUSAL RESET
    //
    // The audit found two persistent contradictions:
    //
    // 1) FAILED-UP shorts during STABILIZING after a DOWN shock:
    //    the original downside information is decaying, so another failed
    //    bounce is not automatically fresh seller control.
    //
    // 2) FAILED-UP shorts while R1 reaction memory says ACC_UP:
    //    Bot2 is calling "failed up" while Bot1's structure memory says the
    //    market has been accepted above resistance. Those stories conflict.
    //
    // We do NOT blacklist the market state. Bot2 waits for a NEW bearish
    // event edge. Persistent booleans inherited from the old move cannot
    // unlock the short.
    // ─────────────────────────────────────────────────────────────────────
    bool downShockStabilizing =
         ctxValid and shockStateCtx == 3 and shockDirCtx < 0

    bool r1AcceptedAboveConflict =
         ctxValid and r1ReactionCtx == 7

    bool failedUpCausalConflict =
         enableCausalReset and shortFailedUp and
         (downShockStabilizing or r1AcceptedAboveConflict)

    bool freshShortDiscoveryEvent =
         shortDiscovery and not shortDiscovery[1]

    bool freshShortAcceptanceEvent =
         shortAcceptance and not shortAcceptance[1]

    bool freshShortDefenseEvent =
         shortResistanceDefense and not shortResistanceDefense[1] and
         not r1AcceptedAboveConflict

    bool freshSellerResetEvent =
         freshShortAcceptanceEvent or
         freshShortDiscoveryEvent or
         freshShortDefenseEvent

    bool shortCausalReady =
         not failedUpCausalConflict or freshSellerResetEvent

    string shortCausalReason =
         freshShortAcceptanceEvent ? "BREAKDOWN + ACCEPTANCE" :
         freshShortDiscoveryEvent ? "DOWNWARD DISCOVERY" :
         freshShortDefenseEvent ? "RESISTANCE DEFENSE" :
         shortReason

    // Research export/counterfactual participation shadow removed.
    bool shortInitiativeGateReady = strictDefenseSequence ?
         (initiativeMode != "LIVE" or not shortInitiativeWait) :
         (initiativeMode != "LIVE" or not shortDefenseOnlyCause or shortInitiativeNow or shortInitiativeRearm)
    bool shortRetryGateReady = executionRetrySide != SIDE_SHORT or (not executionRetryWait and executionRetryRearm)
    bool shortSupportForArm = bearSupported or
         (initiativeMode == "LIVE" and shortInitiativeRearm and bearDeveloping) or
         (executionTimingMode == "LIVE" and executionRetryRearm and executionRetrySide == SIDE_SHORT and bearDeveloping)

    bool shortArmReady =
         entriesAllowedNow and
         episodeSide == SIDE_SHORT and not episodeUsed and
         shortSupportForArm and not bullSupported and
         shortDevelopGateReady and
         not bearContradicted and
         not sellerCounterWeak and
         shortWorthTaking and
         shortControlReady and
         shortCausalReady and
         shortFailedAuctionConfidenceReady and
         shortParticipationReady and
         shortInitiativeGateReady and
         shortRetryGateReady and
         shortRegimeAllowed and
         shortRouteUsable

    if longArmReady
        pendingSide := SIDE_LONG
        armTrigger := high + tick
        armInvalid := longStop
        armExecInvalid := math.max(armInvalid, low - atr * execInvalidBufferAtr)
        armDefenseOrigin := longDefenseOnlyCause or (initiativeMode == "LIVE" and longInitiativeRearm)
        armRetryOrigin := executionRetryRearm and executionRetrySide == SIDE_LONG
        float armRisk = math.max(armTrigger - armInvalid, tick)
        float executableRoomR = not na(longDest) and longDest > armTrigger ? (longDest - armTrigger) / armRisk : na
        armOpportunityMode := (opportunityModeResearch == "SHADOW" or thesisContractObserve) ? f_armOpportunityMode(SIDE_LONG, executableRoomR) : OM_UNKNOWN
        float desiredArmTarget = armTrigger + armRisk * targetR
        armTarget := useRouteCap and not na(longDest) and longDest > armTrigger ?
             math.min(desiredArmTarget, armTrigger + (longDest - armTrigger) * routeCapFrac) :
             desiredArmTarget
        armBar := bar_index
        armReason := armRetryOrigin ? "EXEC FAIL → FRESH LONG INITIATIVE" :
             (initiativeMode == "LIVE" and longInitiativeRearm) ? "DEFENSE → LONG INITIATIVE" : longReason
        armRefreshCount := 0
        longControlRearm := false
        if armRetryOrigin
            executionRetryArmCount += 1
        longInitiativeWait := false
        longInitiativeRearm := false
        longInitiativeWaitBar := na
        if armRetryOrigin
            executionRetrySide := SIDE_NONE
            executionRetryWait := false
            executionRetryRearm := false
            executionRetryAfterBar := na
        longMaturityWait := false
        longPullbackSeen := false
        longMaturityHigh := na
        longMaturityBar := na
        episodeUsed := true
        eventArmLong := true
        actionText := "ARM LONG"
        strategy.entry("L", strategy.long, stop=armTrigger, comment="", alert_message="BOT2 ENTER LONG · ENTRY " + str.tostring(armTrigger, format.mintick) + " · STOP " + str.tostring(armInvalid, format.mintick) + " · TARGET " + str.tostring(armTarget, format.mintick))
        strategy.exit("L-X", from_entry="L", stop=armInvalid, limit=armTarget,
             comment_profit="TARGET", comment_loss="STOP",
             alert_profit="BOT2 LONG TARGET HIT", alert_loss="BOT2 LONG STOP HIT")
        if enableTraderAlerts
            alert("BOT2 ARM LONG · " + armReason + " · ENTRY " + str.tostring(armTrigger, format.mintick) + " · STOP " + str.tostring(armInvalid, format.mintick) + " · TARGET " + str.tostring(armTarget, format.mintick), alert.freq_once_per_bar_close)

    else if shortArmReady
        pendingSide := SIDE_SHORT
        armTrigger := low - tick
        armInvalid := shortStop
        armExecInvalid := math.min(armInvalid, high + atr * execInvalidBufferAtr)
        armDefenseOrigin := shortDefenseOnlyCause or (initiativeMode == "LIVE" and shortInitiativeRearm)
        armRetryOrigin := executionRetryRearm and executionRetrySide == SIDE_SHORT
        float armRisk = math.max(armInvalid - armTrigger, tick)
        float executableRoomRS = not na(shortDest) and shortDest < armTrigger ? (armTrigger - shortDest) / armRisk : na
        armOpportunityMode := (opportunityModeResearch == "SHADOW" or thesisContractObserve) ? f_armOpportunityMode(SIDE_SHORT, executableRoomRS) : OM_UNKNOWN
        float desiredArmTarget = armTrigger - armRisk * targetR
        armTarget := useRouteCap and not na(shortDest) and shortDest < armTrigger ?
             math.max(desiredArmTarget, armTrigger - (armTrigger - shortDest) * routeCapFrac) :
             desiredArmTarget
        armBar := bar_index
        armReason := armRetryOrigin ? "EXEC FAIL → FRESH SHORT INITIATIVE" :
             (initiativeMode == "LIVE" and shortInitiativeRearm) ? "DEFENSE → SHORT INITIATIVE" :
             (failedUpCausalConflict and freshSellerResetEvent ? shortCausalReason : shortReason)
        armRefreshCount := 0
        shortControlRearm := false
        if armRetryOrigin
            executionRetryArmCount += 1
        shortInitiativeWait := false
        shortInitiativeRearm := false
        shortInitiativeWaitBar := na
        if armRetryOrigin
            executionRetrySide := SIDE_NONE
            executionRetryWait := false
            executionRetryRearm := false
            executionRetryAfterBar := na
        longMaturityWait := false
        longPullbackSeen := false
        longMaturityHigh := na
        longMaturityBar := na
        shortMaturityWait := false
        shortPullbackSeen := false
        shortMaturityLow := na
        shortMaturityBar := na
        longControlWait := false
        shortControlWait := false
        longControlRearm := false
        shortControlRearm := false
        longInitiativeWait := false
        shortInitiativeWait := false
        longInitiativeRearm := false
        shortInitiativeRearm := false
        longInitiativeWaitBar := na
        shortInitiativeWaitBar := na
        executionRetrySide := SIDE_NONE
        executionRetryWait := false
        executionRetryRearm := false
        executionRetryAfterBar := na
        episodeUsed := true
        eventArmShort := true
        actionText := "ARM SHORT"
        strategy.entry("S", strategy.short, stop=armTrigger, comment="", alert_message="BOT2 ENTER SHORT · ENTRY " + str.tostring(armTrigger, format.mintick) + " · STOP " + str.tostring(armInvalid, format.mintick) + " · TARGET " + str.tostring(armTarget, format.mintick))
        strategy.exit("S-X", from_entry="S", stop=armInvalid, limit=armTarget,
             comment_profit="TARGET", comment_loss="STOP",
             alert_profit="BOT2 SHORT TARGET HIT", alert_loss="BOT2 SHORT STOP HIT")
        if enableTraderAlerts
            alert("BOT2 ARM SHORT · " + armReason + " · ENTRY " + str.tostring(armTrigger, format.mintick) + " · STOP " + str.tostring(armInvalid, format.mintick) + " · TARGET " + str.tostring(armTarget, format.mintick), alert.freq_once_per_bar_close)

    // Automated reaction and late-flow scalp branches removed.

// PROP SHIELD is an execution state, not a reasoning state.
// Override the displayed action while flat, after all thesis reasoning ran.
if propShieldActive and strategy.position_size == 0
    actionText := "PROP SHIELD — SHADOW ONLY"
    internalNote := "STRUCTURAL STOP + DAY R <= 0 · EXECUTION LOCKED UNTIL NEXT PT DAY"

// ── Resolve broker-emulator exits exactly once.
if barstate.isconfirmed and strategy.closedtrades > lastClosedSeen
    int idx = strategy.closedtrades - 1
    string exitComment = strategy.closedtrades.exit_comment(idx)
    float exitPrice = strategy.closedtrades.exit_price(idx)

    bool exitIsTarget = str.startswith(exitComment, "TARGET")
    bool exitIsStop = str.startswith(exitComment, "STOP")
    bool exitIsEarly = str.startswith(exitComment, "EARLY")
    bool exitIsExecFail = str.startswith(exitComment, "EXECFAIL")  // PARITY: v0.27.3 did not release retry state from FTL_FAST
    bool exitIsProtect = str.startswith(exitComment, "PROTECT")
    bool exitIsTime = str.startswith(exitComment, "TIME") or str.contains(exitComment, "REACTION TIME") or str.contains(exitComment, "LATE FLOW TIME")

    string exitEntryId = strategy.closedtrades.entry_id(idx)
    int resolvedExitSide = exitEntryId == "L" ? SIDE_LONG : exitEntryId == "S" ? SIDE_SHORT : SIDE_NONE
    string resolvedExitSideText = resolvedExitSide == SIDE_LONG ? "LONG" : resolvedExitSide == SIDE_SHORT ? "SHORT" : "TRADE"
    string resolvedExitReason =
         exitIsTarget ? "TARGET" :
         exitIsStop ? "STOP" :
         exitIsEarly ? "EARLY" :
         exitIsExecFail ? "EXEC FAIL" :
         exitIsProtect ? "PROTECT" :
         exitIsTime ? "TIME" : "EXIT"

    lastExitSide := resolvedExitSide
    lastExitPrice := exitPrice
    lastExitBar := bar_index
    lastExitText := "EXIT " + resolvedExitSideText + " · " + resolvedExitReason

    if showTraderMarkers
        label.new(bar_index, exitPrice, lastExitText + "\n" + str.tostring(exitPrice, format.mintick),
             style=resolvedExitSide == SIDE_SHORT ? label.style_label_up : label.style_label_down,
             color=color.orange, textcolor=color.black, size=size.small)
    if enableTraderAlerts and barstate.isrealtime
        alert("BOT2 " + lastExitText + " · " + str.tostring(exitPrice, format.mintick), alert.freq_once_per_bar_close)

    eventExitTarget := exitIsTarget
    eventStop := exitIsStop
    eventExitEarly := exitIsEarly
    eventExitProtect := exitIsProtect
    eventExitTime := exitIsTime
    eventExitExecFail := exitIsExecFail
    eventExitOther := not exitIsTarget and not exitIsStop and not exitIsEarly and not exitIsProtect and not exitIsTime and not exitIsExecFail

    // Normal exits consume the thesis episode. A v0.14 EXECFAIL is different:
    // the entry attempt failed, not necessarily the thesis. A retry is released
    // only when the separate retry state later sees a fresh initiative edge.
    bool resolvedExecutionFail = exitIsExecFail
    episodeUsed := resolvedExecutionFail and executionRetryWait ? false : true
    if not resolvedExecutionFail
        executionRetrySide := SIDE_NONE
        executionRetryWait := false
        executionRetryRearm := false
        executionRetryAfterBar := na

    // Clear trade geometry after classification.
    tradeEntry := na
    tradeStop := na
    tradeTarget := na
    tradeEntryBar := na
    tradeReason := ""
    tradeExecInvalid := na
    tradeDefenseOrigin := false
    tradeRetryOrigin := false
    tradeContractWrongExecutionSeen := false
    tradeExecFailSeen := false
    tradeInitialRisk := na
    tradeMfeR := na
    tradeMaeR := na
    tradeProved05 := false
    tradeProof05Bar := na
    tradeCloseR := na
    tradeGivebackR := na
    tradeArmOpportunityMode := OM_UNKNOWN
    tradeProtectEvidence := 0
    tradeProtectCode := 0
    tradeControlState := CT_UNPROVEN
    tradeControlEventId := 0
    tradeControlLastEvent := CT_EVT_NONE
    tradeControlChallengeCode := CT_EVT_NONE
    tradeControlChallengeBar := na
    tradeControlTransferBar := na
    tradeControlChallengeOrigin := na
    tradeControlChallengeExtreme := na
    tradeControlResponseSeen := false
    tradeControlChallengeCount := 0
    tradeControlRecoveryCount := 0
    tradeControlProtectEvent := CT_EVT_NONE
    tradeControlTransferPath := CT_PATH_NONE
    tradeControlTransferExtreme := na

    actionText := lastExitText
    lastClosedSeen := strategy.closedtrades

// ─────────────────────────────────────────────────────────────────────────────
// Research candidate-event ledger removed in clean trader build.

// CLEAN TRADER CORE END
// TradingView strategy order markers and Strategy Tester remain available.
// ─────────────────────────────────────────────────────────────────────────────


// ============================================================================
// v0.30.1 CLEAN TRADER UI — DIRECTLY INSIDE BOT2
// calc_on_every_tick=true exists ONLY so this display can update while the
// realtime 5-minute candle forms. All discretionary strategy reasoning remains
// gated by `barstate.isconfirmed` in `canReasonThisBar`; this block never submits,
// cancels, modifies, or closes an order.
// ============================================================================

f_uiPrice(float p) => na(p) ? "—" : str.tostring(p, format.mintick)
f_uiR(float r) => na(r) ? "—" : str.tostring(r, "#.##") + "R"
f_uiSideText(int s) => s == SIDE_LONG ? "LONG" : s == SIDE_SHORT ? "SHORT" : "FLAT"

bool uiActive = strategy.position_size != 0
bool uiArmed = strategy.position_size == 0 and pendingSide != SIDE_NONE
int uiSide = uiActive ? (strategy.position_size > 0 ? SIDE_LONG : SIDE_SHORT) : uiArmed ? pendingSide : episodeSide
float uiEntry = uiActive ? (not na(tradeEntry) ? tradeEntry : strategy.position_avg_price) : uiArmed ? armTrigger : na
float uiStop = uiActive ? (not na(tradeStop) ? tradeStop : armInvalid) : uiArmed ? armInvalid : na
float uiTarget = uiActive ? (not na(tradeTarget) ? tradeTarget : armTarget) : uiArmed ? armTarget : na
float uiRisk = uiActive and not na(tradeInitialRisk) ? tradeInitialRisk : uiArmed and not na(uiEntry) and not na(uiStop) ? math.max(math.abs(uiEntry - uiStop), tick) : na
float uiLiveR = uiActive and not na(uiRisk) and uiRisk > 0 ? (uiSide == SIDE_LONG ? (close - uiEntry) / uiRisk : (uiEntry - close) / uiRisk) : na
float uiBarFavR = uiActive and not na(uiRisk) and uiRisk > 0 ? (uiSide == SIDE_LONG ? (high - uiEntry) / uiRisk : (uiEntry - low) / uiRisk) : na
float uiLiveMfeR = uiActive ? math.max(nz(tradeMfeR, 0.0), bar_index == tradeEntryBar ? math.max(nz(uiLiveR, 0.0), 0.0) : math.max(nz(uiBarFavR, 0.0), 0.0)) : na
float uiGivebackR = uiActive and not na(uiLiveMfeR) and not na(uiLiveR) ? math.max(uiLiveMfeR - uiLiveR, 0.0) : na

bool uiSameTerr = uiSide == SIDE_LONG ? upTerritory : uiSide == SIDE_SHORT ? dnTerritory : false
bool uiOppTerr = uiSide == SIDE_LONG ? dnTerritory : uiSide == SIDE_SHORT ? upTerritory : false
bool uiSameInit = uiSide == SIDE_LONG ? (longInitiativeNow or buyerSponsored or fpLongSupport) : uiSide == SIDE_SHORT ? (shortInitiativeNow or sellerSponsored or fpShortSupport) : false
bool uiOppInit = uiSide == SIDE_LONG ? (shortInitiativeNow or sellerSponsored or fpShortSupport) : uiSide == SIDE_SHORT ? (longInitiativeNow or buyerSponsored or fpLongSupport) : false
bool uiSameFp = uiSide == SIDE_LONG ? fpLongSupport : uiSide == SIDE_SHORT ? fpShortSupport : false
bool uiOppFp = uiSide == SIDE_LONG ? fpShortSupport : uiSide == SIDE_SHORT ? fpLongSupport : false
bool uiValueFollow = uiSide == SIDE_LONG ? (fpPocUp or fpValueUp) : uiSide == SIDE_SHORT ? (fpPocDown or fpValueDown) : false
bool uiContradicted = uiSide == SIDE_LONG ? bullContradicted : uiSide == SIDE_SHORT ? bearContradicted : false
string uiHtf = uiSide == SIDE_NONE ? "NA" : f_htfStoryTag(uiSide)
string uiTerritory = uiSameTerr ? "OUR SIDE GAINING" : uiOppTerr ? "OPPONENT GAINING" : (upHolding or dnHolding ? "HOLDING / CONTESTED" : "NO CLEAR GAIN")
string uiInitiative = uiSameInit and not uiOppInit ? "OUR SIDE" : uiOppInit and not uiSameInit ? "OPPONENT" : uiSameInit and uiOppInit ? "TWO-WAY" : "QUIET"
string uiFlow = not fpHas ? "FOOTPRINT N/A" : uiSameFp and not uiOppFp ? "SUPPORTING US" : uiOppFp and not uiSameFp ? "SUPPORTING OPPONENT" : uiSameFp and uiOppFp ? "MIXED" : "NEUTRAL"

int uiDirectionSide = uiActive ? uiSide : uiArmed ? uiSide : episodeSide != SIDE_NONE ? episodeSide : bullSupported and not bearSupported ? SIDE_LONG : bearSupported and not bullSupported ? SIDE_SHORT : SIDE_NONE
string uiDirectionText = uiActive ? f_uiSideText(uiSide) + " ACTIVE" : uiArmed ? "ARM " + f_uiSideText(uiSide) : episodeSide == SIDE_LONG ? "LONG SETUP" : episodeSide == SIDE_SHORT ? "SHORT SETUP" : bullSupported and not bearSupported ? "LEAN LONG" : bearSupported and not bullSupported ? "LEAN SHORT" : "WAIT / NEUTRAL"
string uiConfirmedState = uiActive ? f_uiSideText(uiSide) + " ACTIVE · " + f_ctStateText(tradeControlState) : uiArmed ? "ARM " + f_uiSideText(uiSide) : actionText
string uiExecutionState = uiActive ? "IN TRADE" : uiArmed ? "WAITING FOR TRIGGER" : propShieldActive ? "AUTO ENTRY BLOCKED · PROP SHIELD" : uiConfirmedState
string uiThesisReason = uiActive ? (tradeReason != "" ? tradeReason : armReason) : uiArmed ? armReason : episodeReason
int uiMode = uiActive ? (tradeArmOpportunityMode != OM_UNKNOWN ? tradeArmOpportunityMode : armOpportunityMode) : uiArmed ? armOpportunityMode : OM_UNKNOWN
string uiLiveThought =
     uiActive and tradeControlState == CT_TRANSFER_BUILDING ? "TRANSFER BUILDING · EXIT RISK HIGH" :
     uiActive and tradeControlState == CT_RECOVERING ? "RECOVERING · OUR SIDE RESPONDING" :
     uiActive and tradeControlState == CT_CHALLENGED ? "CHALLENGED · WATCH THE RESPONSE" :
     uiActive and not tradeProved05 and uiOppTerr and uiOppInit ? "UNPROVEN · OPPONENT GAINING CONTROL" :
     uiActive and not tradeProved05 and uiSameTerr and uiSameInit ? "UNPROVEN · LAUNCHING / BUILDING PROOF" :
     uiActive and not tradeProved05 and uiContradicted ? "UNPROVEN · THESIS CONTRADICTION BUILDING" :
     uiActive and not tradeProved05 ? "UNPROVEN · WAITING FOR PROOF" :
     uiActive and tradeProved05 and uiOppTerr and not uiSameInit ? "PROVEN · CONTINUATION THREAT" :
     uiActive and tradeProved05 and uiSameTerr and uiSameInit and (uiValueFollow or not fpHas) ? "PROVEN · CONTINUATION HEALTHY" :
     uiActive and tradeProved05 and uiOppTerr and uiOppInit ? "PROVEN · OPPONENT PUSH / WATCH" :
     uiActive and tradeProved05 and not na(uiGivebackR) and uiGivebackR >= PROTECT_GIVEBACK_R ? "PROVEN · GIVEBACK BUILDING / MONITOR" :
     uiActive and tradeProved05 ? "PROVEN · HOLD / MONITOR" :
     uiArmed and uiContradicted ? "ARM UNDER PRESSURE · RE-EVALUATE AT CLOSE" :
     uiArmed and uiSameInit ? "ARM VALID · PRESSURE SUPPORTING TRIGGER" :
     uiArmed ? "WAITING FOR ENTRY TRIGGER" :
     episodeSide == SIDE_LONG ? "LONG THESIS DEVELOPING" :
     episodeSide == SIDE_SHORT ? "SHORT THESIS DEVELOPING" :
     bullSupported and not bearSupported ? "BUYERS HAVE THE CLEANER STORY" :
     bearSupported and not bullSupported ? "SELLERS HAVE THE CLEANER STORY" :
     "NO CLEAN THESIS · WAIT"

string uiExitStatus =
     uiActive and tradeControlState == CT_TRANSFER_BUILDING ? "EXIT WATCH · CONTROL TRANSFER BUILDING" :
     uiActive and tradeControlState == CT_CHALLENGED ? "EXIT WATCH · NEED OUR SIDE TO RESPOND" :
     uiActive and not tradeProved05 and uiContradicted ? "EXIT WATCH · THESIS CONTRADICTION" :
     uiActive and not tradeProved05 and uiOppTerr and uiOppInit ? "EXIT WATCH · OPPONENT CONTROL" :
     uiActive ? "HOLD · NO CONFIRMED EXIT" :
     lastExitBar == bar_index ? lastExitText + " @ " + f_uiPrice(lastExitPrice) :
     lastExitBar >= 0 ? "LAST: " + lastExitText + " @ " + f_uiPrice(lastExitPrice) : "—"

string uiWhatChanged = uiOppTerr and uiOppInit ? "Opponent gained territory + initiative" : uiSameTerr and uiSameInit ? "Our side has territory + initiative" : uiOppTerr ? "Opponent gained territory" : uiSameTerr ? "Our side gained territory" : uiOppInit ? "Opponent initiative active" : uiSameInit ? "Our initiative active" : "No decisive control change"
string uiNextProof = uiActive ? (tradeProved05 ? "Retain control toward target" : "Need +0.50R / retained control") : uiArmed ? "Need trigger, then prove the move" : episodeSide == SIDE_LONG ? "Need long ARM proof" : episodeSide == SIDE_SHORT ? "Need short ARM proof" : "Need a fresh causal thesis"

// Trade-plan lines. These are created on every confirmed ARM and are preserved
// historically through fill/exit/cancel so the plan is visible when reviewing trades.
var line uiEntryLine = na
var line uiStopLine = na
var line uiTargetLine = na
var label uiEntryLabel = na
var label uiStopLabel = na
var label uiTargetLabel = na
bool uiHasContract = (uiActive or uiArmed) and not na(uiEntry) and not na(uiStop) and not na(uiTarget)
bool uiNewArm = eventArmLong or eventArmShort

if showTradeLines and uiNewArm and not na(armTrigger) and not na(armInvalid) and not na(armTarget)
    if not na(uiEntryLine)
        line.set_extend(uiEntryLine, extend.none)
        line.set_x2(uiEntryLine, bar_index)
        line.set_extend(uiStopLine, extend.none)
        line.set_x2(uiStopLine, bar_index)
        line.set_extend(uiTargetLine, extend.none)
        line.set_x2(uiTargetLine, bar_index)
    uiEntryLine := line.new(bar_index, armTrigger, bar_index + 1, armTrigger, extend=extend.right, color=color.yellow, style=line.style_dashed, width=2)
    uiStopLine := line.new(bar_index, armInvalid, bar_index + 1, armInvalid, extend=extend.right, color=color.red, width=2)
    uiTargetLine := line.new(bar_index, armTarget, bar_index + 1, armTarget, extend=extend.right, color=color.lime, width=2)

if showTradeLines and uiHasContract and not na(uiEntryLine)
    line.set_y1(uiEntryLine, uiEntry)
    line.set_y2(uiEntryLine, uiEntry)
    line.set_y1(uiStopLine, uiStop)
    line.set_y2(uiStopLine, uiStop)
    line.set_y1(uiTargetLine, uiTarget)
    line.set_y2(uiTargetLine, uiTarget)
    line.set_x2(uiEntryLine, bar_index + 1)
    line.set_x2(uiStopLine, bar_index + 1)
    line.set_x2(uiTargetLine, bar_index + 1)
    line.set_style(uiEntryLine, uiActive ? line.style_solid : line.style_dashed)

if showTradeLines and not uiHasContract and not uiNewArm and not na(uiEntryLine)
    line.set_extend(uiEntryLine, extend.none)
    line.set_extend(uiStopLine, extend.none)
    line.set_extend(uiTargetLine, extend.none)
    line.set_x2(uiEntryLine, bar_index)
    line.set_x2(uiStopLine, bar_index)
    line.set_x2(uiTargetLine, bar_index)
    line.set_color(uiEntryLine, color.new(color.yellow, 45))
    line.set_color(uiStopLine, color.new(color.red, 45))
    line.set_color(uiTargetLine, color.new(color.lime, 45))
    uiEntryLine := na
    uiStopLine := na
    uiTargetLine := na

// Live price tags only belong to the current contract; historical plans keep lines.
if barstate.islast
    if showTradePriceLabels and uiHasContract
        if not na(uiEntryLabel)
            label.delete(uiEntryLabel)
        if not na(uiStopLabel)
            label.delete(uiStopLabel)
        if not na(uiTargetLabel)
            label.delete(uiTargetLabel)
        string uiSideLabel = f_uiSideText(uiSide)
        uiEntryLabel := label.new(bar_index + 1, uiEntry, uiSideLabel + (uiArmed ? " TRIGGER " : " ENTRY ") + f_uiPrice(uiEntry), style=label.style_label_left, color=color.yellow, textcolor=color.black, size=size.small)
        uiStopLabel := label.new(bar_index + 1, uiStop, uiSideLabel + " STOP " + f_uiPrice(uiStop), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)
        uiTargetLabel := label.new(bar_index + 1, uiTarget, uiSideLabel + " TARGET " + f_uiPrice(uiTarget), style=label.style_label_left, color=color.lime, textcolor=color.black, size=size.small)
    else
        if not na(uiEntryLabel)
            label.delete(uiEntryLabel)
            uiEntryLabel := na
        if not na(uiStopLabel)
            label.delete(uiStopLabel)
            uiStopLabel := na
        if not na(uiTargetLabel)
            label.delete(uiTargetLabel)
            uiTargetLabel := na

// Historical trading markers from Bot2's actual confirmed events.
plotshape(showTraderMarkers and eventArmLong, title="BOT2 ARM LONG", style=shape.labelup, location=location.belowbar, text="ARM LONG", color=color.lime, textcolor=color.black, size=size.tiny)
plotshape(showTraderMarkers and eventArmShort, title="BOT2 ARM SHORT", style=shape.labeldown, location=location.abovebar, text="ARM SHORT", color=color.red, textcolor=color.white, size=size.tiny)
plotshape(showTraderMarkers and eventEnterLong, title="BOT2 ENTER LONG", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny)
plotshape(showTraderMarkers and eventEnterShort, title="BOT2 ENTER SHORT", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny)

// Opaque high-contrast panel. Direction is deliberately separate from execution
// state so PROP SHIELD can block auto-entry without hiding what Bot2 thinks.
color uiPanelBg = color.rgb(15, 18, 24)
color uiLabelBg = color.rgb(28, 33, 43)
color uiLongBg = color.rgb(20, 82, 58)
color uiShortBg = color.rgb(112, 38, 45)
color uiNeutralBg = color.rgb(55, 61, 73)
color uiDirectionBg = uiDirectionSide == SIDE_LONG ? uiLongBg : uiDirectionSide == SIDE_SHORT ? uiShortBg : uiNeutralBg
color uiThoughtColor = uiOppTerr and uiOppInit ? color.orange : color.white

var table traderPanel = table.new(position.top_right, 2, 15, border_width=1, frame_width=1, bgcolor=uiPanelBg)
if barstate.islast and showTraderPanel
    table.clear(traderPanel, 0, 0, 1, 14)
    table.cell(traderPanel, 0, 0, "BOT2 TRADER", text_color=color.white, bgcolor=color.black, text_size=size.normal)
    table.cell(traderPanel, 1, 0, barstate.isconfirmed ? "CONFIRMED CLOSE" : "LIVE · FORMING", text_color=barstate.isconfirmed ? color.lime : color.yellow, bgcolor=color.black, text_size=size.normal)
    table.cell(traderPanel, 0, 1, "DIRECTION NOW", text_color=color.white, bgcolor=uiDirectionBg, text_size=size.normal)
    table.cell(traderPanel, 1, 1, uiDirectionText, text_color=color.white, bgcolor=uiDirectionBg, text_size=size.normal)
    table.cell(traderPanel, 0, 2, "EXECUTION", text_color=color.silver, bgcolor=uiLabelBg)
    table.cell(traderPanel, 1, 2, uiExecutionState, text_color=propShieldActive and not uiActive ? color.orange : color.white, bgcolor=uiPanelBg)
    table.cell(traderPanel, 0, 3, "LIVE THOUGHT", text_color=color.silver, bgcolor=uiLabelBg)
    table.cell(traderPanel, 1, 3, uiLiveThought, text_color=uiThoughtColor, bgcolor=uiPanelBg)
    table.cell(traderPanel, 0, 4, "THESIS / HORIZON", text_color=color.silver, bgcolor=uiLabelBg)
    table.cell(traderPanel, 1, 4, (uiThesisReason == "" ? "—" : uiThesisReason) + " · " + f_modeTag(uiMode), text_color=color.white, bgcolor=uiPanelBg)
    table.cell(traderPanel, 0, 5, "ENTRY / STOP / TARGET", text_color=color.silver, bgcolor=uiLabelBg)
    table.cell(traderPanel, 1, 5, uiHasContract ? f_uiPrice(uiEntry) + " / " + f_uiPrice(uiStop) + " / " + f_uiPrice(uiTarget) : "—", text_color=color.white, bgcolor=uiPanelBg)
    table.cell(traderPanel, 0, 6, "EXIT STATUS", text_color=color.silver, bgcolor=uiLabelBg)
    table.cell(traderPanel, 1, 6, uiExitStatus, text_color=str.contains(uiExitStatus, "EXIT WATCH") ? color.orange : color.white, bgcolor=uiPanelBg)
    table.cell(traderPanel, 0, 7, "LIVE R / MFE", text_color=color.silver, bgcolor=uiLabelBg)
    table.cell(traderPanel, 1, 7, uiActive ? f_uiR(uiLiveR) + " / " + f_uiR(uiLiveMfeR) : "—", text_color=color.white, bgcolor=uiPanelBg)
    table.cell(traderPanel, 0, 8, "CONTROL STATE", text_color=color.silver, bgcolor=uiLabelBg)
    table.cell(traderPanel, 1, 8, uiActive ? f_ctStateText(tradeControlState) : uiTerritory, text_color=color.white, bgcolor=uiPanelBg)
    table.cell(traderPanel, 0, 9, "TERRITORY", text_color=color.silver, bgcolor=uiLabelBg)
    table.cell(traderPanel, 1, 9, uiTerritory, text_color=color.white, bgcolor=uiPanelBg)
    table.cell(traderPanel, 0, 10, "INITIATIVE", text_color=color.silver, bgcolor=uiLabelBg)
    table.cell(traderPanel, 1, 10, uiInitiative, text_color=color.white, bgcolor=uiPanelBg)
    table.cell(traderPanel, 0, 11, "FOOTPRINT / VALUE", text_color=color.silver, bgcolor=uiLabelBg)
    table.cell(traderPanel, 1, 11, uiFlow + (uiValueFollow ? " · VALUE FOLLOWING" : ""), text_color=color.white, bgcolor=uiPanelBg)
    table.cell(traderPanel, 0, 12, "HTF / REGIME", text_color=color.silver, bgcolor=uiLabelBg)
    table.cell(traderPanel, 1, 12, uiHtf + " · " + f_regimeTag(regimeCode), text_color=color.white, bgcolor=uiPanelBg)
    table.cell(traderPanel, 0, 13, "WHAT CHANGED", text_color=color.silver, bgcolor=uiLabelBg)
    table.cell(traderPanel, 1, 13, uiWhatChanged, text_color=color.white, bgcolor=uiPanelBg)
    table.cell(traderPanel, 0, 14, "WHAT BOT2 NEEDS", text_color=color.silver, bgcolor=uiLabelBg)
    table.cell(traderPanel, 1, 14, uiNextProof, text_color=color.white, bgcolor=uiPanelBg)
else if barstate.islast and not showTraderPanel
    table.clear(traderPanel, 0, 0, 1, 14)

// Optional intrabar advisory alert. Actual strategy exits remain close-confirmed.
bool uiLiveThreat = uiActive and ((not tradeProved05 and uiOppTerr and uiOppInit) or (tradeProved05 and uiOppTerr and not uiSameInit))
if enableLiveWatchAlerts and barstate.isrealtime and not barstate.isconfirmed and uiLiveThreat
    alert("BOT2 LIVE WATCH · " + f_uiSideText(uiSide) + " · " + uiLiveThought + " · LIVE R " + f_uiR(uiLiveR), alert.freq_once_per_bar)
